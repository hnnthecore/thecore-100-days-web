---
/** Day 044 · Fathom · header and footer shared by every page. Links are root paths, made relative by the build. */
import '@fontsource-variable/onest';
import '@fontsource-variable/hanken-grotesk';
import '../../days/day-044/styles.css';
import '../../days/day-044/fathom.css';
import Mark from '../brand/Mark.astro';
import { getCollection } from 'astro:content';
const latest = (await getCollection('releases')).sort((a, b) => b.data.date.localeCompare(a.data.date)).slice(0, 2);
// 90 days of uptime: every day up except two short blips (fictional).
const DAYS = Array.from({ length: 90 }, (_, i) => (i === 23 ? 'degraded' : i === 61 ? 'degraded' : 'up'));
const fmtD = (d: string) => new Date(d + 'T00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

interface Props { active?: 'features' | 'customers' | 'pricing' | 'changelog' | 'demo'; home?: boolean }
const { active, home = false } = Astro.props;
const B = '/day-044-saas-product';
const NAV = [['features', 'Product', `${B}/features/`], ['customers', 'Customers', `${B}/customers/`], ['pricing', 'Pricing', `${B}/pricing/`], ['changelog', 'Changelog', `${B}/changelog/`]] as const;
---
<script is:inline>document.documentElement.classList.add('js');</script>
<div class:list={['fa', home && 'fa--home']}>
  <header class="fa-header" data-header>
    <div class="fa-wrap flex h-[4.5rem] items-center justify-between gap-6">
      <a href={`${B}/`} class="fa-logo" aria-label="Fathom, home">
        <Mark site="day-044-saas-product" size={30} />
        Fathom
      </a>
      <nav aria-label="Main" class="hidden lg:block">
        <ul class="flex gap-9 text-[15px]">
          {NAV.map(([k, l, h]) => <li><a href={h} class="fa-navlink" aria-current={active === k ? 'page' : undefined}>{l}</a></li>)}
        </ul>
      </nav>
      <div class="flex items-center gap-3">
        <a href={`${B}/pricing/`} class="fa-btn fa-btn--line hidden md:inline-flex">Start free</a>
        <a href={`${B}/demo/`} class="fa-btn fa-btn--blue hidden sm:inline-flex">Book a demo</a>
        <button type="button" class="fa-burger lg:hidden" data-burger aria-expanded="false" aria-controls="fa-menu" aria-label="Open menu"><span></span><span></span></button>
      </div>
    </div>
    <nav id="fa-menu" class="fa-menu lg:hidden" aria-label="Mobile" data-menu hidden>
      <ul>{NAV.map(([k, l, h]) => <li><a href={h} aria-current={active === k ? 'page' : undefined}>{l}</a></li>)}<li><a href={`${B}/demo/`} aria-current={active === 'demo' ? 'page' : undefined}>Book a demo</a></li></ul>
    </nav>
  </header>

  <main id="main"><slot /></main>

  <footer class="fa-footer">
    <div class="fa-status"><div class="fa-wrap fa-status__in">
      <div class="fa-status__now"><p class="fa-status__pill"><span class="fa-status__dot" aria-hidden="true"></span>All systems operational</p>
        <p class="fa-status__meta">Forecast engine, bank sync, alerts and reports. Last checked 09:00 UK.</p></div>
      <div class="fa-status__bars"><div class="fa-status__strip" role="img" aria-label="Uptime for the last 90 days: 99.97 percent, with two short degraded periods">{DAYS.map((d) => <i class:list={[d !== 'up' && 'is-warn']}></i>)}</div>
        <p class="fa-status__legend"><span>90 days ago</span><b>99.97% uptime</b><span>Today</span></p></div>
      <div class="fa-status__log"><p class="fa-status__h">Latest changes</p><ul role="list">{latest.map((r) => <li><span class="fa-status__v">{r.data.version}</span><span>{r.data.title}<small>{fmtD(r.data.date)}</small></span></li>)}</ul><a href={`${B}/changelog/`}>Full changelog →</a></div>
    </div></div>
    <div class="fa-wrap grid grid-cols-2 gap-10 py-14 lg:grid-cols-5">
      <div class="col-span-2"><p class="fa-logo !text-white"><Mark site="day-044-saas-product" variant="tile" size={32} />Fathom</p><p class="mt-4 max-w-xs text-white/65">Cash-flow forecasting that tells small businesses what is coming, while there is still time to act.</p></div>
      <div><h2 class="fa-foot-h">Product</h2><ul class="mt-3 grid gap-2"><li><a href={`${B}/features/forecast/`}>Forecast</a></li><li><a href={`${B}/features/scenarios/`}>Scenarios</a></li><li><a href={`${B}/features/invoices/`}>Invoice chasing</a></li><li><a href={`${B}/features/`}>All features</a></li></ul></div>
      <div><h2 class="fa-foot-h">Company</h2><ul class="mt-3 grid gap-2"><li><a href={`${B}/customers/`}>Customers</a></li><li><a href={`${B}/pricing/`}>Pricing</a></li><li><a href={`${B}/fit/`}>Plan quiz</a></li><li><a href={`${B}/changelog/`}>Changelog</a></li><li><a href={`${B}/demo/`}>Book a demo</a></li></ul></div>
      <div><h2 class="fa-foot-h">Get in touch</h2><address class="mt-3 grid gap-1 not-italic text-white/75">hello@fathomcash.co.uk<br />020 7946 0177<br />Mon to Fri, 9 to 6</address></div>
    </div>
  </footer>
</div>
<script>
  import '../../days/shared/shell';
  // Fade sections in as they scroll into view.
  const els = document.querySelectorAll('.fa-reveal');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
    els.forEach((el) => io.observe(el));
  } else els.forEach((el) => el.classList.add('is-in'));
</script>
