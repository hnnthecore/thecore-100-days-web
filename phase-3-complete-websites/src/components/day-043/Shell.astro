---
/** Day 043 · Rootwork Community Farm · header and footer shared by every page. */
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/fraunces';
import '@fontsource-variable/fraunces/wght-italic.css';
import '../../days/day-043/styles.css';

interface Props { active?: 'home' | 'programmes' | 'involved' | 'stories' | 'about' | 'contact' }
const { active } = Astro.props;
const B = '/day-043-community-farm';
const NAV = [['programmes', 'What we do', `${B}/programmes/`], ['involved', 'Get involved', `${B}/get-involved/`], ['stories', 'Stories', `${B}/stories/`], ['about', 'About', `${B}/about/`], ['contact', 'Contact', `${B}/contact/`]] as const;
---
<div class="rw">
  <header class="rw-header" data-header>
    <div class="rw-wrap flex h-18 items-center justify-between gap-6">
      <a href={`${B}/`} class="rw-logo" aria-label="Rootwork Community Farm, home"><svg viewBox="0 0 32 32" class="size-8" aria-hidden="true"><circle cx="16" cy="16" r="16" fill="var(--leaf)" /><path d="M16 26V14M16 14c-5 0-8-3-8-8 5 0 8 3 8 8zM16 17c4 0 7-2.5 7-7-4.500 0-7 2.500-7 7z" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg><span>Rootwork</span></a>
      <nav aria-label="Main" class="hidden lg:block">
        <ul class="flex gap-8 text-[15px] font-semibold">{NAV.map(([k, l, h]) => <li><a href={h} class="rw-navlink" aria-current={active === k ? 'page' : undefined}>{l}</a></li>)}</ul>
      </nav>
      <div class="flex items-center gap-3">
        <a href={`${B}/get-involved/#donate`} class="rw-btn rw-btn--tomato hidden sm:inline-flex">Donate</a>
        <button type="button" class="rw-burger lg:hidden" data-burger aria-expanded="false" aria-controls="rw-menu" aria-label="Open menu"><span></span><span></span></button>
      </div>
    </div>
    <nav id="rw-menu" class="rw-menu lg:hidden" aria-label="Mobile" data-menu hidden>
      <ul>{NAV.map(([k, l, h]) => <li><a href={h} aria-current={active === k ? 'page' : undefined}>{l}</a></li>)}<li><a href={`${B}/get-involved/#donate`}>Donate</a></li></ul>
    </nav>
  </header>
  <main id="main"><slot /></main>
  <footer class="rw-footer">
    <div class="rw-wrap grid grid-cols-1 gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2"><p class="rw-logo !text-white"><span>Rootwork</span></p><p class="mt-4 max-w-sm text-white/70">A community farm in the middle of Manchester, growing food, skills and friendships since 2014. Registered charity (demo) no. 1234567.</p></div>
      <div><h2 class="rw-foot-h">Explore</h2><ul class="mt-3 grid gap-2"><li><a href={`${B}/programmes/`}>What we do</a></li><li><a href={`${B}/get-involved/`}>Get involved</a></li><li><a href={`${B}/stories/`}>Stories</a></li><li><a href={`${B}/about/`}>About us</a></li></ul></div>
      <div><h2 class="rw-foot-h">Find us</h2><address class="mt-3 grid gap-1 not-italic text-white/80">Rootwork Farm, Mill Lane<br />Manchester M14 6AB<br />hello@rootwork.example<br />0161 555 0143</address></div>
    </div>
    <div class="rw-wrap border-t border-white/10 py-6 text-sm text-white/55">A fictional charity created for Thecore's 100 Days of Web (Day 043). Programmes, people and figures are invented. Donations here are a demo: no money is taken.</div>
  </footer>
</div>
<script>
  import '../../days/shared/shell';
</script>
