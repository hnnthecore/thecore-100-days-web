---
/** Day 043 · Rootwork Community Farm · header and footer shared by every page. */
import '@fontsource-variable/bricolage-grotesque/wdth.css';
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/wght-italic.css';
import '../../days/day-043/styles.css';
import '../../days/day-043/season.css';
import Mark from '../brand/Mark.astro';

interface Props { active?: 'home' | 'programmes' | 'involved' | 'stories' | 'about' | 'contact'; home?: boolean }
const { active, home = false } = Astro.props;
const B = '/day-043-community-farm';
const NAV = [['programmes', 'What we do', `${B}/programmes/`], ['growing', 'What\'s growing', `${B}/whats-growing/`], ['involved', 'Get involved', `${B}/get-involved/`], ['stories', 'Stories', `${B}/stories/`], ['about', 'About', `${B}/about/`], ['contact', 'Contact', `${B}/contact/`]] as const;
---
<script is:inline>document.documentElement.classList.add('js');</script>
<div class:list={['rw', home && 'rw--home']} data-season="autumn">
  <script is:inline>(function(s){var m=new Date().getMonth()+1;s.parentElement.dataset.season=m>=3&&m<=5?'spring':m>=6&&m<=8?'summer':m>=9&&m<=11?'autumn':'winter'})(document.currentScript)</script>
  <header class="rw-header" data-header>
    <div class="rw-wrap flex h-18 items-center justify-between gap-6">
      <a href={`${B}/`} class="rw-logo" aria-label="Rootwork Community Farm, home"><Mark site="day-043-community-farm" size={32} /><span>Rootwork</span></a>
      <nav aria-label="Main" class="hidden lg:block">
        <ul class="flex gap-8 text-[15px] font-semibold">{NAV.map(([k, l, h]) => <li><a href={h} class="rw-navlink" aria-current={active === k ? 'page' : undefined}>{l}</a></li>)}</ul>
      </nav>
      <div class="flex items-center gap-3">
        <a href={`${B}/get-involved/#donate`} class="rw-btn rw-btn--tomato hidden sm:inline-flex">Donate</a>
        <button type="button" class="rw-burger lg:hidden" data-burger aria-expanded="false" aria-controls="rw-menu" aria-label="Open menu"><span></span><span></span></button>
      </div>
    </div>
    <nav id="rw-menu" class="rw-menu lg:hidden" aria-label="Mobile" data-menu hidden>
      <ul>{NAV.map(([k, l, h]) => <li><a href={h} aria-current={active === k ? 'page' : undefined}>{l}</a></li>)}<li><a href={`${B}/get-involved/#donate`}>Donate</a></li></ul>
    </nav>
  </header>
  <main id="main"><slot /></main>
  <footer class="rw-footer">
    <div class="rw-wrap rw-foot">
      <p class="rw-foot__line">The kettle is always on.</p>
      <div class="rw-foot__cols">
        <div><p class="rw-logo"><Mark site="day-043-community-farm" variant="tile" size={34} /><span>Rootwork</span></p><p class="rw-foot__about">A community farm in the middle of Manchester, growing food, skills and friendships since 2014. Registered charity no. 1187342.</p></div>
        <div><h2 class="rw-foot-h">Explore</h2><ul><li><a href={`${B}/programmes/`}>What we do</a></li><li><a href={`${B}/get-involved/`}>Get involved</a></li><li><a href={`${B}/whats-growing/`}>What's growing</a></li><li><a href={`${B}/stories/`}>Stories</a></li><li><a href={`${B}/about/`}>About us</a></li></ul></div>
        <div><h2 class="rw-foot-h">Find us</h2><address>Rootwork Farm, Mill Lane<br />Manchester M14 6AB<br />hello@rootwork.org.uk<br />0161 496 0143</address></div>
      </div>
    </div>
  </footer>
</div>
<script>
  import '../../days/shared/shell';
  /* Inner pages: the header slides away while you scroll down and returns on the way up. */
  const bar = document.querySelector<HTMLElement>('[data-header]');
  if (bar) {
    let last = scrollY;
    addEventListener('scroll', () => {
      const y = scrollY, open = document.querySelector('[data-burger]')?.getAttribute('aria-expanded') === 'true';
      const away = y > last && y > 160 && !open;
      bar.classList.toggle('is-away', away);
      document.querySelector('.thecore-badge')?.classList.toggle('is-away', away);
      last = y;
    }, { passive: true });
  }
  /* Parts of each section enter as they arrive. */
  const seen = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); seen.unobserve(e.target); } }), { threshold: 0.12 });
  document.querySelectorAll('[data-rise]').forEach((el) => seen.observe(el));
</script>
