---
/** Day 042 · Atelier Nord · header and footer shared by every page. Links are root paths, made relative by the build. */
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/wght-italic.css';
import '../../days/day-042/styles.css';

interface Props { active?: 'home' | 'projects' | 'journal' | 'studio' | 'contact' }
const { active } = Astro.props;
const B = '/day-042-architecture';
const NAV = [['projects', 'Projects', `${B}/projects/`], ['journal', 'Journal', `${B}/journal/`], ['studio', 'Studio', `${B}/studio/`], ['contact', 'Contact', `${B}/contact/`]] as const;
---
<div class="an">
  <header class="an-header" data-header>
    <div class="an-wrap flex h-18 items-center justify-between gap-6">
      <a href={`${B}/`} class="an-logo" aria-label="Atelier Nord, home"><svg viewBox="0 0 28 28" class="size-7" aria-hidden="true"><rect x="2" y="2" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.2" /><path d="M2 20 14 6l12 14" fill="none" stroke="var(--fjord)" stroke-width="2.2" /></svg><span>Atelier <b>Nord</b></span></a>
      <nav aria-label="Main" class="hidden lg:block">
        <ul class="flex gap-9 text-[15px] font-medium">
          {NAV.map(([k, l, h]) => <li><a href={h} class="an-navlink" aria-current={active === k ? 'page' : undefined}>{l}</a></li>)}
        </ul>
      </nav>
      <div class="flex items-center gap-3">
        <a href={`${B}/contact/`} class="an-btn an-btn--ink hidden sm:inline-flex">Start a project</a>
        <button type="button" class="an-burger lg:hidden" data-burger aria-expanded="false" aria-controls="an-menu" aria-label="Open menu"><span></span><span></span></button>
      </div>
    </div>
    <nav id="an-menu" class="an-menu lg:hidden" aria-label="Mobile" data-menu hidden>
      <ul>{NAV.map(([k, l, h]) => <li><a href={h} aria-current={active === k ? 'page' : undefined}>{l}</a></li>)}<li><a href={`${B}/contact/`}>Start a project</a></li></ul>
    </nav>
  </header>

  <main id="main"><slot /></main>

  <footer class="an-footer">
    <div class="an-wrap grid grid-cols-1 gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2"><p class="an-logo !text-white"><span>Atelier <b>Nord</b></span></p><p class="mt-4 max-w-sm text-white/65">An independent architecture studio in Edinburgh. Quiet, low-carbon buildings for people and places that matter.</p></div>
      <div><h2 class="an-foot-h">Studio</h2><ul class="mt-3 grid gap-2"><li><a href={`${B}/projects/`}>Projects</a></li><li><a href={`${B}/journal/`}>Journal</a></li><li><a href={`${B}/studio/`}>About &amp; team</a></li><li><a href={`${B}/contact/`}>Contact</a></li></ul></div>
      <div><h2 class="an-foot-h">Say hello</h2><address class="mt-3 grid gap-1 not-italic text-white/75">12 Leith Walk Mews<br />Edinburgh EH6 5AA<br />studio@ateliernord.example<br />0131 555 0188</address></div>
    </div>
    <div class="an-wrap border-t border-white/10 py-6 text-sm text-white/55">A fictional practice created for Thecore's 100 Days of Web (Day 042). Projects, clients and people are invented.</div>
  </footer>
</div>
<script>
  import '../../days/day-042/shell';
</script>
