---
/**
 * Day 041 · Pagebound Books · header and footer shared by every page of the site.
 * Links are root-absolute; the build step turns them into relative links, so the site also works from disk.
 */
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource-variable/literata/wght-italic.css';
import '@fontsource-variable/literata';
import '../../days/day-041/styles.css';
import '../../days/day-041/sheet.css';
import Mark from '../brand/Mark.astro';

interface Props { active?: 'home' | 'books' | 'events' | 'about' | 'contact' | 'basket'; home?: boolean }
const { active, home = false } = Astro.props;
const B = '/day-041-bookshop';
const NAV = [['books', 'Books', `${B}/books/`], ['events', 'Events', `${B}/events/`], ['about', 'About', `${B}/about/`], ['contact', 'Visit & contact', `${B}/contact/`]] as const;
---
<script is:inline>document.documentElement.classList.add('js');</script>
<div class:list={['pb', home && 'pb--home']}>
  <header class="pb-header" data-header>
    <div class="pb-wrap flex h-18 items-center justify-between gap-6">
      <a href={`${B}/`} class="pb-logo" aria-label="Pagebound Books, home"><Mark site="day-041-bookshop" size={30} /><span>Pagebound</span></a>
      <nav aria-label="Main" class="hidden lg:block">
        <ul class="flex gap-9 text-[15px] font-medium">
          {NAV.map(([k, l, h]) => <li><a href={h} aria-current={active === k ? 'page' : undefined} class="pb-navlink">{l}</a></li>)}
        </ul>
      </nav>
      <div class="flex items-center gap-3">
        <a href={`${B}/basket/`} class="pb-basket" data-basket-link aria-current={active === 'basket' ? 'page' : undefined} aria-label="Basket, 0 items"><svg viewBox="0 0 24 24" class="size-5" aria-hidden="true"><path d="M5 8h14l-1.2 11H6.2zM9 8V6a3 3 0 0 1 6 0v2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg><b data-basket-count hidden>0</b></a>
        <button type="button" class="pb-burger lg:hidden" data-burger aria-expanded="false" aria-controls="pb-menu" aria-label="Open menu"><span></span><span></span></button>
      </div>
    </div>
    <nav id="pb-menu" class="pb-menu lg:hidden" aria-label="Mobile" data-menu hidden>
      <ul>
        {NAV.map(([k, l, h]) => <li><a href={h} aria-current={active === k ? 'page' : undefined}>{l}</a></li>)}
        <li><a href={`${B}/basket/`} aria-current={active === 'basket' ? 'page' : undefined}>Basket</a></li>
      </ul>
    </nav>
  </header>

  <main id="main"><slot /></main>

  <footer class="pg-foot" data-foot>
    <div class="pg-foot__tile pg-t-state" style="--d:0"><p>Independent since 1998. On Canongate, Edinburgh, every day.</p><small>A fictional bookshop created for Thecore's 100 Days of Web (Day 041). Books, authors and events are invented. <a href={`${B}/about/#credits`}>Picture credits</a>.</small></div>
    <nav class="pg-foot__tile pg-t-nav" style="--d:1" aria-label="Footer"><ul><li><a href={`${B}/books/`}>Books</a></li><li><a href={`${B}/staff-shelf/`}>Staff shelf</a></li><li><a href={`${B}/events/`}>Events</a></li><li><a href={`${B}/about/`}>About</a></li><li><a href={`${B}/contact/`}>Visit and contact</a></li><li><a href={`${B}/basket/`}>Basket</a></li></ul></nav>
    <div class="pg-foot__tile pg-t-time" style="--d:2"><b data-time>Edinburgh</b><span data-open>42 Canongate, EH8 8BN</span></div>
    <div class="pg-foot__tile pg-t-mail" style="--d:3"><a href="mailto:hello@pagebound.example">hello@pagebound.example</a></div>
    <div class="pg-foot__tile pg-t-name" style="--d:4" aria-hidden="true"><b>pagebound</b></div>
    <a class="pg-foot__tile pg-t-go" style="--d:5" href={`${B}/books/`}><span>Reserve a book</span><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="square" aria-hidden="true"><path d="M10 38 38 10M16 10h22v22" /></svg></a>
  </footer>
</div>
<script>
  import '../../days/day-041/shell';
  /* The header slides away while you scroll down and returns on the way up. */
  const bar = document.querySelector<HTMLElement>('[data-header]');
  if (bar) {
    let last = scrollY;
    addEventListener('scroll', () => {
      const y = scrollY, open = document.querySelector('[data-burger]')?.getAttribute('aria-expanded') === 'true';
      const away = y > last && y > 160 && !open;
      bar.classList.toggle('is-away', away);
      document.querySelector('.thecore-badge')?.classList.toggle('is-away', away);
      last = y;
    }, { passive: true });
  }
  /* Parts of each section enter as they arrive; the lifted frame opens with its shutter. */
  const seen = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); seen.unobserve(e.target); } }), { threshold: 0.15 });
  document.querySelectorAll('[data-rise], .pg-lift, [data-foot]').forEach((el) => seen.observe(el));
  /* The footer clock: Edinburgh time, and whether the shop is open. */
  const clock = document.querySelector<HTMLElement>('[data-time]');
  const state = document.querySelector<HTMLElement>('[data-open]');
  const HOURS: Record<string, [number, number]> = { Mon: [9, 18], Tue: [9, 18], Wed: [9, 18], Thu: [9, 20], Fri: [9, 18], Sat: [9, 18], Sun: [11, 16] };
  const at = (h: number) => (h > 12 ? h - 12 : h) + (h >= 12 ? 'pm' : 'am');
  function tick() {
    if (!clock || !state) return;
    const parts = Object.fromEntries(new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/London', weekday: 'short', hour: '2-digit', minute: '2-digit', hour12: false }).formatToParts(new Date()).map((p) => [p.type, p.value]));
    const h = Number(parts.hour) % 24, m = Number(parts.minute), now = h + m / 60, [o, c] = HOURS[parts.weekday] ?? [9, 18];
    clock.textContent = 'Edinburgh, ' + parts.hour + ':' + parts.minute;
    state.textContent = now >= o && now < c ? 'Open until ' + at(c) + '. The kettle is on.' : 'Closed now. Back at ' + at(o) + '.';
  }
  tick();
  setInterval(tick, 30000);
</script>
