---
/**
 * Day 041 · Pagebound Books · header and footer shared by every page of the site.
 * Links are root-absolute; the build step turns them into relative links, so the site also works from disk.
 */
import '@fontsource-variable/literata';
import '@fontsource-variable/literata/wght-italic.css';
import '@fontsource-variable/work-sans';
import '../../days/day-041/styles.css';

interface Props { active?: 'home' | 'books' | 'events' | 'about' | 'contact' | 'basket' }
const { active } = Astro.props;
const B = '/day-041-bookshop';
const NAV = [['books', 'Books', `${B}/books/`], ['events', 'Events', `${B}/events/`], ['about', 'About', `${B}/about/`], ['contact', 'Visit & contact', `${B}/contact/`]] as const;
---
<div class="pb">
  <header class="pb-header" data-header>
    <div class="pb-wrap flex h-18 items-center justify-between gap-6">
      <a href={`${B}/`} class="pb-logo" aria-label="Pagebound Books, home"><svg viewBox="0 0 32 32" class="size-8" aria-hidden="true"><rect x="3" y="4" width="26" height="24" rx="3" fill="var(--oxblood)" /><path d="M16 8v16M16 8c-3-2-7-2-10 0v16c3-2 7-2 10 0 3-2 7-2 10 0V8c-3-2-7-2-10 0z" fill="none" stroke="var(--cream)" stroke-width="1.8" stroke-linejoin="round" /></svg><span>Pagebound</span></a>
      <nav aria-label="Main" class="hidden lg:block">
        <ul class="flex gap-9 text-[15px] font-medium">
          {NAV.map(([k, l, h]) => <li><a href={h} aria-current={active === k ? 'page' : undefined} class="pb-navlink">{l}</a></li>)}
        </ul>
      </nav>
      <div class="flex items-center gap-3">
        <a href={`${B}/basket/`} class="pb-basket" data-basket-link aria-current={active === 'basket' ? 'page' : undefined} aria-label="Basket, 0 items"><svg viewBox="0 0 24 24" class="size-5" aria-hidden="true"><path d="M5 8h14l-1.2 11H6.2zM9 8V6a3 3 0 0 1 6 0v2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg><b data-basket-count hidden>0</b></a>
        <button type="button" class="pb-burger lg:hidden" data-burger aria-expanded="false" aria-controls="pb-menu" aria-label="Open menu"><span></span><span></span></button>
      </div>
    </div>
    <nav id="pb-menu" class="pb-menu lg:hidden" aria-label="Mobile" data-menu hidden>
      <ul>
        {NAV.map(([k, l, h]) => <li><a href={h} aria-current={active === k ? 'page' : undefined}>{l}</a></li>)}
        <li><a href={`${B}/basket/`} aria-current={active === 'basket' ? 'page' : undefined}>Basket</a></li>
      </ul>
    </nav>
  </header>

  <main id="main"><slot /></main>

  <footer class="pb-footer">
    <div class="pb-wrap grid grid-cols-1 gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <p class="pb-logo !text-(--cream)"><span>Pagebound</span></p>
        <p class="mt-4 max-w-sm text-(--cream)/70">An independent bookshop on Canongate, Edinburgh. Staffed by people who read, with a kettle always on.</p>
      </div>
      <div><h2 class="pb-foot-h">Explore</h2><ul class="mt-3 grid gap-2"><li><a href={`${B}/books/`}>All books</a></li><li><a href={`${B}/events/`}>Events</a></li><li><a href={`${B}/about/`}>About us</a></li><li><a href={`${B}/basket/`}>Your basket</a></li></ul></div>
      <div><h2 class="pb-foot-h">Visit</h2><address class="mt-3 grid gap-1 not-italic text-(--cream)/80">42 Canongate<br />Edinburgh EH8 8BN<br />Mon–Sat 9–6 · Sun 11–4<br /><a href={`${B}/contact/`}>Get in touch →</a></address></div>
    </div>
    <div class="pb-wrap border-t border-white/10 py-6 text-sm text-(--cream)/60">A fictional bookshop created for Thecore's 100 Days of Web (Day 041). Books, authors and events are invented.</div>
  </footer>
</div>
<script>
  import '../../days/day-041/shell';
</script>
