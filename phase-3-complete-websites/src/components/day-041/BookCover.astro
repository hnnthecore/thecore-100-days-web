---
/** A book cover: a real photograph with the title and author set on top as live text, so it stays sharp at any size. */
import { Image } from 'astro:assets';
import { BOOK_PHOTOS } from '../../days/day-041/photos';
import { ACCENTS } from '../../days/day-041/bookcover';
interface Props { slug: string; title: string; author: string; palette: number; pattern: number; width?: number; eager?: boolean }
const { slug, title, author, palette, pattern, width = 480, eager = false } = Astro.props;
---
<span class="pb-bc" data-lay={pattern % 3} style={`--bc-a:${ACCENTS[palette % 6]}`}>
  <Image src={BOOK_PHOTOS[slug]} alt="" width={width} height={Math.round(width * 1.5)} loading={eager ? 'eager' : 'lazy'} />
  <span class="pb-bc__t">{title}</span><span class="pb-bc__a">{author}</span>
</span>
