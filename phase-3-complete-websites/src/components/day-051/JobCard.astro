---
/** Day 051 · Hirewell · one job listing card: company tile, title, location, pay, tags and a save star. */
import { pay } from '../../days/day-051/store';
const B = '/day-051-job-board';
interface Props { entry: any; company: any; level?: 'h2' | 'h3' }
const { entry, company, level = 'h3' } = Astro.props;
const j = entry.data, c = company.data;
const H = level;
const when = new Date(j.posted + 'T00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
---
<div class="hw-card is-link">
  <button type="button" class="hw-star" data-save={entry.id} data-title={j.title} aria-pressed="false" aria-label={`Save ${j.title}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l2.7 5.8 6.3.7-4.7 4.3 1.3 6.2L12 17l-5.6 3 1.3-6.2L3 9.5l6.3-.7z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg></button>
  <a href={`${B}/jobs/${entry.id}/`} class="hw-job">
    <span class="hw-logo-tile" style={`background:${c.colour}`} aria-hidden="true">{c.name[0]}</span>
    <div style="padding-right:2.6rem"><H>{j.title}</H><p style="font-weight:600;color:var(--muted)">{c.name}</p></div>
    <p class="hw-job__meta"><span>{j.location}</span><span>{j.mode}</span><span>{j.type}</span><span class="hw-job__pay">{pay(j.min, j.max)}</span></p>
    <p class="hw-tags"><span class="hw-tag hw-tag--peach">{j.level}</span>{j.tags.slice(0, 3).map((t: string) => <span class="hw-tag">{t}</span>)}<span class="hw-tag" style="background:transparent;color:var(--muted)">Posted {when}</span></p>
  </a>
</div>
