---
/**
 * A site's logo mark, drawn inline so it can sit beside the live wordmark in the header or footer.
 * The artwork lives in src/days/brand/marks.ts and is generated by scripts/make-brand.mjs.
 * variant "mark" is the plain logo; "tile" is the same mark on its solid favicon tile (use on dark backgrounds).
 */
import { MARKS } from '../../days/brand/marks';
interface Props { site: keyof typeof MARKS; variant?: 'mark' | 'tile'; size?: number }
const { site, variant = 'mark', size = 30 } = Astro.props;
const m = MARKS[site];
---
<svg viewBox="0 0 32 32" width={size} height={size} aria-hidden="true" focusable="false" class="brand-mark" set:html={variant === 'tile' ? `<rect width="32" height="32" rx="7" fill="${m.tile}"/>${m.tileMark}` : m.mark} />
