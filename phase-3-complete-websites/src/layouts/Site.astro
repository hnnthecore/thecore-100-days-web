---
/**
 * Document shell shared by every Phase 3 site: head tags, skip link and the "back to Thecore" badge.
 * Each site brings its own header, footer and styles through the default slot.
 */
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  themeColor: string;
  icon: string;
  day: number;
  lang?: string;
  /** Structured data (schema.org) for this page, as a plain object or an array of them. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Keep a page out of search results (used by the 404 page). */
  noindex?: boolean;
}
const { title, description, themeColor, icon, day, lang = 'en', jsonLd, noindex = false } = Astro.props;
/* Absolute address of the published site. Social networks need a full URL for the share image: change this one line when the site moves to its own domain. */
const ORIGIN = 'https://hnnthecore.github.io/thecore-100-days-web/phase-3-complete-websites/site';
// Sites that have brand files (see scripts/make-brand.mjs) get a real favicon set; the rest keep their emoji.
const BRAND_FOLDERS: Record<number, string> = { 41: 'day-041-bookshop', 42: 'day-042-architecture', 43: 'day-043-community-farm', 44: 'day-044-saas-product', 45: 'day-045-language-school', 46: 'day-046-herbal-shop', 47: 'day-047-music-festival', 48: 'day-048-magazine', 49: 'day-049-dental-clinic', 50: 'day-050-recipes', 51: 'day-051-job-board', 52: 'day-052-yoga-studio', 53: 'day-053-podcast-network', 54: 'day-054-college', 55: 'day-055-wedding-venue' };
const brand = BRAND_FOLDERS[day];
const favicon = `data:image/svg+xml,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><text y=".9em" font-size="90">${icon}</text></svg>`)}`;
// The hub lives three folders above a day's index page; pages nested deeper need more "../".
const depth = Astro.url.pathname.split('/').filter(Boolean).length;
const hub = '../'.repeat(depth + 2) + 'index.html';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    {brand && <meta property="og:image" content={`${ORIGIN}/${brand}/og.png`} />}
    {brand && <meta property="og:image:width" content="1200" />}
    {brand && <meta property="og:image:height" content="630" />}
    {brand && <meta name="twitter:image" content={`${ORIGIN}/${brand}/og.png`} />}
    {noindex && <meta name="robots" content="noindex" />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {brand ? (
      <>
        <link rel="icon" href={`/${brand}/favicon.svg`} type="image/svg+xml" />
        <link rel="icon" href={`/${brand}/favicon-32.png`} type="image/png" sizes="32x32" />
        <link rel="shortcut icon" href={`/${brand}/favicon.ico`} />
        <link rel="apple-touch-icon" href={`/${brand}/apple-touch-icon.png`} />
      </>
    ) : (
      <link rel="icon" href={favicon} />
    )}
    <noscript><style>[data-needs-js] { display: none !important; }</style></noscript>
    <slot name="head" />
  </head>
  <body>
    <a class="sr-only-focusable rounded-full bg-black px-4 py-2 font-semibold text-white" href="#main">Skip to content</a>
    <slot />
    <aside aria-label="About this project">
      <a class="thecore-badge" href={hub} aria-label={`Thecore 100 Days of Web, day ${day}. Back to all projects`}><span aria-hidden="true">T</span> Day {String(day).padStart(3, '0')} · Thecore</a>
    </aside>
    <script>
      import '../scripts/smooth';
    </script>
    <style is:global>
      .thecore-badge {
        position: fixed; left: 1rem; bottom: 1rem; z-index: 60;
        display: inline-flex; align-items: center; gap: 0.5rem;
        padding: 0.4rem 0.8rem 0.4rem 0.4rem; border-radius: 999px;
        background: oklch(18% 0.02 280); color: #fff;
        font: 600 13px/1 var(--font-sans); letter-spacing: 0.02em; text-decoration: none;
        
        transition: transform 0.3s var(--ease-spring);
      }
      .thecore-badge:hover { transform: translateY(-2px); }
      .thecore-badge.is-away { transform: translateY(160%); }
      .thecore-badge span { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: linear-gradient(135deg, #8b5cf6, #ec4899); font-size: 13px; }
    </style>
  </body>
</html>
