---
/** Day 052 · Stillwater · one page per class style, with its teacher, benefits and weekly times. */
import { getCollection, render } from 'astro:content';
import Site from '../../../layouts/Site.astro';
import Shell from '../../../components/day-052/Shell.astro';
import { Image } from 'astro:assets';
import { CLASS_PHOTOS, CLASS_ALTS, TEACHER_PHOTOS } from '../../../days/day-052/photos';
import { WEEK } from '../../../days/day-052/schedule';

export async function getStaticPaths() {
  const all = await getCollection('yogaClasses');
  const teachers = await getCollection('yogaTeachers');
  return all.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, teacher: teachers.find((t) => t.id === entry.data.teacher)!, next: all[(i + 1) % all.length] } }));
}
const B = '/day-052-yoga-studio';
const { entry, teacher, next } = Astro.props;
const c = entry.data;
const { Content } = await render(entry);
const DOW = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const times = WEEK.filter((s) => s.cls === entry.id).sort((a, b) => ((a.dow || 7) - (b.dow || 7)) || a.time.localeCompare(b.time));
---
<Site title={`${c.title} · Stillwater`} description={c.tagline} themeColor="#0c2a31" icon="S" day={52}>
  <Shell active="classes">
    <header class="sw-pagehead"><div class="sw-wrap"><ol class="sw-crumbs" aria-label="Breadcrumb"><li><a href={`${B}/`}>Home</a></li><li><a href={`${B}/classes/`}>Classes</a></li><li aria-current="page">{c.title}</li></ol>
      <div class="sw-split" style="align-items:center"><div><p class="sw-pill">{c.level}</p><h1 class="sw-h1 mt-4" style="font-size:clamp(2.8rem,6vw,5rem)">{c.title}</h1><p class="sw-lede mt-4">{c.tagline}</p>
        <p class="sw-meta mt-4" style="font-size:1rem"><span>{c.minutes} minutes</span><span>with {teacher.data.name}</span><span class="sw-dots" role="img" aria-label={`Intensity ${c.intensity} of 5`}>{[1, 2, 3, 4, 5].map((n) => <i class={n <= c.intensity ? 'on' : ''}></i>)}</span></p>
        <a href={`${B}/timetable/?c=${entry.id}`} class="sw-btn sw-btn--coral sw-btn--lg mt-6">Book this class</a></div>
        <figure class="sw-classphoto"><Image src={CLASS_PHOTOS[entry.id]} alt={CLASS_ALTS[entry.id]} width={1000} loading="eager" /></figure></div></div></header>
    <section class="sw-section"><div class="sw-wrap sw-split sw-split--wide">
      <div class="sw-prose"><Content /></div>
      <aside class="grid gap-5">
        <div class="sw-card" style="background:var(--lilac)"><h2 class="sw-h3">Why you'll love it</h2><ul class="sw-ticks mt-3">{c.benefits.map((b) => <li>{b}</li>)}</ul></div>
        <div class="sw-card"><h2 class="sw-h3">Weekly times</h2><ul class="mt-3 grid gap-2" role="list">{times.map((s) => <li class="flex justify-between"><b>{DOW[s.dow]}</b><span>{s.time} · {s.room} room</span></li>)}</ul></div>
        <div class="sw-card flex items-center gap-4"><Image src={TEACHER_PHOTOS[teacher.id]} alt={`Portrait of ${teacher.data.name}`} width={160} height={160} class="sw-av sw-av--photo" style="width:4.4rem;height:4.4rem" /><div><p class="sw-h3">{teacher.data.name}</p><p>{teacher.data.role}</p></div></div>
      </aside>
    </div>
    <div class="sw-wrap mt-12 flex flex-wrap gap-3"><a href={`${B}/classes/`} class="sw-btn">← All classes</a><a href={`${B}/classes/${next.id}/`} class="sw-btn">Next: {next.data.title} →</a></div></section>
  </Shell>
</Site>
