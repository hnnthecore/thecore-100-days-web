---
/** Day 052 · Stillwater · the bookable timetable: the next seven days, filters, live spots left, a booking dialog and "My classes". */
import { getCollection } from 'astro:content';
import Site from '../../layouts/Site.astro';
import Shell from '../../components/day-052/Shell.astro';
import { WEEK } from '../../days/day-052/schedule';

const B = '/day-052-yoga-studio';
const classes = await getCollection('yogaClasses');
const teachers = await getCollection('yogaTeachers');
const info = Object.fromEntries(classes.map((c) => [c.id, { title: c.data.title, minutes: c.data.minutes, level: c.data.level, hue: c.data.hue, teacher: teachers.find((t) => t.id === c.data.teacher)!.data.name }]));
const data = { week: WEEK, info, base: B };
---
<Site title="Timetable · Stillwater" description="Book a yoga or pilates class at Stillwater in Brighton. See the next seven days, spots left and your own bookings." themeColor="#0c2a31" icon="S" day={52}>
  <Shell active="timetable">
    <header class="sw-pagehead"><div class="sw-wrap"><ol class="sw-crumbs" aria-label="Breadcrumb"><li><a href={`${B}/`}>Home</a></li><li aria-current="page">Timetable</li></ol><h1 class="sw-h1">Book a <em>class.</em></h1><p class="sw-lede mt-4">Pick a day, choose a class and reserve your spot. Cancel free up to two hours before.</p></div></header>
    <section class="sw-section !pt-10"><div class="sw-wrap sw-split sw-split--wide">
      <div>
        <div class="sw-days" role="group" aria-label="Day" data-days></div>
        <div class="mt-6 flex flex-wrap items-end gap-5">
          <div><label for="t-style" class="sw-label">Style</label><select id="t-style" class="sw-input" data-style><option value="">All styles</option>{classes.map((c) => <option value={c.id}>{c.data.title}</option>)}</select></div>
          <div><p class="sw-label" id="tod-l">Time of day</p><div class="sw-chips" role="group" aria-labelledby="tod-l" data-tod><button type="button" data-v="all" aria-pressed="true">Any</button><button type="button" data-v="am" aria-pressed="false">Morning</button><button type="button" data-v="mid" aria-pressed="false">Lunchtime</button><button type="button" data-v="pm" aria-pressed="false">Evening</button></div></div>
        </div>
        <h2 class="sw-h3 mt-8" data-day-title></h2>
        <div class="mt-4" data-list aria-live="polite"></div>
      </div>
      <aside id="mine" class="sw-mine" aria-labelledby="mine-t"><h2 id="mine-t" class="sw-h3">My classes</h2><p class="mt-2" style="color:var(--muted)" data-mine-empty>Nothing booked yet. Choose a class to get started.</p><ul role="list" data-mine class="mt-3"></ul></aside>
    </div></section>

    <dialog class="sw-dialog" data-dialog aria-labelledby="bk-t">
      <div class="sw-dialog__in">
        <div data-pane="form"><h2 id="bk-t" class="sw-h3">Reserve your spot</h2><p class="mt-1" style="color:var(--muted)" data-summary></p>
          <form data-form novalidate class="mt-5"><div class="sw-fields">
            <div class="sw-span"><label for="b-name" class="sw-label">Name</label><input id="b-name" class="sw-input" autocomplete="name" data-req aria-describedby="b-name-e" /><p class="sw-err" id="b-name-e" hidden>Please add your name.</p></div>
            <div class="sw-span"><label for="b-email" class="sw-label">Email</label><input id="b-email" type="email" class="sw-input" autocomplete="email" data-req aria-describedby="b-email-e" /><p class="sw-err" id="b-email-e" hidden>Enter an email like name@example.com.</p></div>
          </div><div class="mt-5 flex gap-3"><button type="button" class="sw-btn" data-close>Cancel</button><button type="submit" class="sw-btn sw-btn--coral" style="flex:1">Confirm booking</button></div></form></div>
        <div data-pane="done" hidden tabindex="-1" class="text-center"><span class="sw-donedot mx-auto" aria-hidden="true"></span><h2 class="sw-h2 mx-auto mt-4" style="font-size:2rem">See you there, <em data-d-name></em>.</h2><p class="mt-2" style="color:var(--muted)" data-d-text></p><button type="button" class="sw-btn mt-5" data-close>Close</button></div>
      </div>
    </dialog>
  </Shell>
</Site>

<script define:vars={{ data }}>
  window.__tt = data;
</script>
<script>
  import { wire } from '../../days/shared/forms';
  import { bookings, upcoming, dayLabel, type Occurrence } from '../../days/day-052/schedule';
  type Info = { title: string; minutes: number; level: string; hue: number; teacher: string };
  const { info, base } = (window as unknown as { __tt: { info: Record<string, Info>; base: string } }).__tt;
  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;

  const week = upcoming(new Date(), 7);
  let day = 0, style = '', tod = 'all', pending: Occurrence | null = null;
  const find = (id: string) => week.flatMap((d) => d.items).find((o) => o.id === id);
  const kind = (t: string) => (t < '11:00' ? 'am' : t < '16:00' ? 'mid' : 'pm');
  const end = (o: Occurrence) => { const [h, m] = o.time.split(':').map(Number); const t = h * 60 + m + info[o.cls].minutes; return `${String(Math.floor(t / 60)).padStart(2, '0')}:${String(t % 60).padStart(2, '0')}`; }; // taste-skill-ignore: a clock

  function paintDays() {
    $('[data-days]').innerHTML = week.map((d, i) => `<button type="button" data-i="${i}" aria-pressed="${i === day}" aria-label="${dayLabel(d.date)}">${i === 0 ? 'Today' : d.date.toLocaleDateString('en-GB', { weekday: 'short' })}<b>${d.date.getDate()}</b></button>`).join('');
  }
  function paintList() {
    const d = week[day];
    $('[data-day-title]').textContent = dayLabel(d.date);
    const items = d.items.filter((o) => (!style || o.cls === style) && (tod === 'all' || kind(o.time) === tod));
    $('[data-list]').innerHTML = items.length ? items.map((o) => {
      const mine = bookings.has(o.id);
      const left = o.cap - o.booked - (mine ? 1 : 0);
      const c = info[o.cls];
      const status = mine ? '<span class="sw-left" style="color:var(--sage-d)">Booked</span>' : left <= 0 ? '<span class="sw-left is-low">Full</span>' : `<span class="sw-left ${left <= 3 ? 'is-low' : ''}">${left} spot${left === 1 ? '' : 's'} left</span>`;
      const action = mine ? `<button type="button" class="sw-btn sw-btn--sm" data-cancel="${o.id}">Cancel</button>` : left <= 0 ? '<button type="button" class="sw-btn sw-btn--sm" disabled>Full</button>' : `<button type="button" class="sw-btn sw-btn--sm sw-btn--coral" data-book="${o.id}">Book</button>`;
      return `<div class="sw-slot ${mine ? 'is-booked' : ''}" style="--c:hsl(${c.hue} 70% 65%)"><time>${o.time}</time><div><h3><a href="${base}/classes/${o.cls}/">${c.title}</a></h3><p>${c.minutes} min · ${c.teacher} · ${o.room} room · ${c.level}</p></div><div class="text-right grid gap-2 justify-items-end">${status}${action}</div></div>`;
    }).join('') : '<p class="sw-lede">No classes match. Try another day or style.</p>';
  }
  function paintMine() {
    const mine = bookings.all().map(find).filter(Boolean) as Occurrence[];
    mine.sort((a, b) => (a.date + a.time).localeCompare(b.date + b.time));
    $<HTMLElement>('[data-mine-empty]').hidden = mine.length > 0;
    $('[data-mine]').innerHTML = mine.map((o) => `<li><span><b>${info[o.cls].title}</b><small>${dayLabel(new Date(o.date + 'T00:00'), true)} · ${o.time}</small></span><button type="button" class="sw-btn sw-btn--sm" data-cancel="${o.id}" aria-label="Cancel ${info[o.cls].title}">Cancel</button></li>`).join('');
  }
  const repaint = () => { paintList(); paintMine(); };

  $('[data-days]').addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLElement>('[data-i]'); if (b) { day = Number(b.dataset.i); paintDays(); paintList(); } });
  $<HTMLSelectElement>('[data-style]').addEventListener('change', (e) => { style = (e.target as HTMLSelectElement).value; paintList(); });
  $('[data-tod]').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
    if (!b) return;
    tod = b.dataset.v!;
    document.querySelectorAll('[data-tod] button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    paintList();
  });
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const bk = t.closest<HTMLElement>('[data-book]');
    if (bk) { pending = find(bk.dataset.book!) ?? null; if (pending) openDialog(); return; }
    const cn = t.closest<HTMLElement>('[data-cancel]');
    if (cn) bookings.remove(cn.dataset.cancel!);
  });
  addEventListener('bookings:change', repaint);

  /* Booking dialog */
  const dlg = $<HTMLDialogElement>('[data-dialog]');
  const form = $<HTMLFormElement>('form[data-form]');
  const check = wire(form);
  function openDialog() {
    const o = pending!;
    $('[data-summary]').textContent = `${info[o.cls].title}, ${dayLabel(new Date(o.date + 'T00:00'))}, ${o.time} to ${end(o)}.`;
    $('[data-pane="form"]').hidden = false; $('[data-pane="done"]').hidden = true;
    dlg.showModal();
  }
  dlg.addEventListener('click', (e) => { const t = e.target as HTMLElement; if (t === dlg || t.closest('[data-close]')) dlg.close(); });
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!check() || !pending) return;
    bookings.add(pending.id);
    $('[data-d-name]').textContent = $<HTMLInputElement>('#b-name').value.trim().split(/\s+/)[0];
    $('[data-d-text]').textContent = `${info[pending.cls].title} at ${pending.time}. A confirmation is on its way to ${$<HTMLInputElement>('#b-email').value.trim()}.`;
    $('[data-pane="form"]').hidden = true;
    const done = $('[data-pane="done"]'); done.hidden = false; done.focus();
  });

  /* ?c=vinyasa-flow from a class page jumps to the first day that has it. */
  /* If nothing is left today, open on the first day that has classes. */
  const firstWithClasses = week.findIndex((d) => d.items.length > 0);
  if (firstWithClasses > 0) day = firstWithClasses;
  const want = new URLSearchParams(location.search).get('c');
  if (want && info[want]) {
    style = want;
    $<HTMLSelectElement>('[data-style]').value = want;
    const i = week.findIndex((d) => d.items.some((o) => o.cls === want));
    if (i >= 0) day = i;
  }
  paintDays(); repaint();
</script>
