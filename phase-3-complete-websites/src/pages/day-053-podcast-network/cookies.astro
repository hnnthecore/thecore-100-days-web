---
/** Day 053 · Static · Cookies. */
import Site from '../../layouts/Site.astro';
import Shell from '../../components/day-053/Shell.astro';
const B = '/day-053-podcast-network';
---
<Site title="Cookies · Static" description="Static does not use cookies. This page explains the small lists your browser remembers so the player and your library work." themeColor="#16181b" icon="S" day={53}>
  <Shell>
    <header class="st-pagehead"><div class="st-wrap"><ol class="st-crumbs" aria-label="Breadcrumb"><li><a href={`${B}/`}>Home</a></li><li aria-current="page">Cookies</li></ol><h1 class="st-h1">Cookies.</h1></div></header>
    <section class="st-section"><div class="st-wrap">
      <div class="st-prose">
<p>Last updated 24 October 2026.</p>
<h2>We do not use cookies</h2>
<p>This website does not set any cookies. There are no advertising cookies, no analytics cookies and no third-party tracking.</p>
<h2>What your browser remembers</h2>
<p>The player and “My library” store small lists in your browser's local storage: the episode you are playing and how far through it you are, the episodes you have started, and the shows you follow. They are not sent anywhere and nobody at Static can see them.</p>
<h2>How to clear it</h2>
<p>Unfollow a show or close the player and the matching entry is removed. To remove everything, clear this site's data in your browser settings.</p>
<h2>Questions</h2>
<p>Email <a href="mailto:hello@staticaudio.co.uk">hello@staticaudio.co.uk</a>.</p>
      </div>
    </div></section>
  </Shell>
</Site>
