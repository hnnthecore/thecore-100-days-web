---
/** Day 053 · Static · home: a radio tuner with the four shows on a frequency band, then newest episodes, the photo band, the shows and the pitch call. See days/day-053/DESIGN.md. */
import { getCollection } from 'astro:content';
import Site from '../../layouts/Site.astro';
import { Image } from 'astro:assets';
import ph_studio_jpg from '../../assets/day-053/studio.jpg';
import ph_hosts_jpg from '../../assets/day-053/hosts.jpg';
import ph_mic_jpg from '../../assets/day-053/mic.jpg';
import Shell from '../../components/day-053/Shell.astro';
import EpisodeRow from '../../components/day-053/EpisodeRow.astro';
import { hueOf } from '../../days/day-053/art';
import { SHOW_COVERS, COVER_ALTS } from '../../days/day-053/photos';

const B = '/day-053-podcast-network';
const shows = await getCollection('shows');
const eps = (await getCollection('episodes')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const show = (id: string) => shows.find((s) => s.id === id)!;
const latest = (id: string) => eps.find((e) => e.data.show === id)!;
/* One station per show, on a band from 88 to 108 MHz. */
const STATIONS = [['small-hours', 89.6, 'SH'], ['pocket-science', 94.4, 'PS'], ['the-long-way-round', 99.8, 'LW'], ['make-it-work', 105.2, 'MW']] as const;
const LD = { '@context': 'https://schema.org', '@type': 'Organization', name: 'Static', description: 'An independent podcast network with four shows.', email: 'hello@staticaudio.co.uk', telephone: '0161 496 0153', address: { '@type': 'PostalAddress', streetAddress: '12 Canal Street', addressLocality: 'Manchester', postalCode: 'M1 3EZ', addressCountry: 'GB' } };
const LO = 88, HI = 108;
const pct = (f: number) => ((f - LO) / (HI - LO)) * 100;
const ticks = Array.from({ length: 101 }, (_, i) => i / 5 + LO);
const dateOf = (d: string) => new Date(d + 'T00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
const tint = (hex: string) => '#' + [1, 3, 5].map((i) => Math.round(parseInt(hex.slice(i, i + 2), 16) * 0.22 + 255 * 0.78).toString(16).padStart(2, '0')).join('');
const stations = STATIONS.map(([id, f, ini]) => ({ id, f, ini, c: show(id).data.colour, t: tint(show(id).data.colour), title: show(id).data.title }));
---
<Site title="Static · Independent podcast network" description="Static is an independent podcast network with four shows: Small Hours, Pocket Science, The Long Way Round and Make It Work. Tune in, then press play." themeColor="#16181b" icon="S" day={53} jsonLd={LD}>
  <Shell>
    <section class="st-wrap st-tune-head" aria-labelledby="st-t">
      <h1 id="st-t" class="st-h1">Tune in to something slow.</h1>
      <p class="st-lede">Four shows, made carefully. Turn the dial: the static clears when you land on a station, and the host tells you what you are in for.</p>
    </section>

    <section class="st-wrap" aria-label="Radio tuner" data-tuner data-b={B}>
      <div class="st-tuner" data-needs-js>
        <div class="st-dial">
          <p class="st-readout" aria-live="polite"><b data-freq>94.4</b><span>MHz</span></p>
          <div class="st-scale" data-scale style="--p:50">
            <svg viewBox="0 0 1000 40" preserveAspectRatio="none" aria-hidden="true" style="position:absolute;left:0;right:0;bottom:0;height:2.4rem">{ticks.map((f, i) => { const x = pct(f) * 10; const long = i % 5 === 0; return <line x1={x} x2={x} y1={long ? 4 : 20} y2="40" stroke={long ? '#ffb347' : '#6b7079'} stroke-width={long ? 2.2 : 1.4} vector-effect="non-scaling-stroke" />; })}</svg>
            {stations.map((s) => <button type="button" class="st-mark" data-f={s.f} data-st={s.id} style={`left:${pct(s.f)}%;--c:${s.c};--t:${s.t}`} aria-label={`Tune to ${s.title}, ${s.f.toFixed(1)} megahertz`}>{s.ini}</button>)}
            <i class="st-needle" aria-hidden="true"></i>
          </div>
          <label class="sr-only" for="st-tune">Frequency in megahertz</label>
          <input id="st-tune" class="st-tunein" type="range" min={LO * 10} max={HI * 10} step="1" value="1007" data-range aria-valuetext="100.7 megahertz" />
          <div class="st-hop"><button type="button" class="st-btn" data-prev>Previous station</button><button type="button" class="st-btn st-btn--tang" data-next>Next station</button></div>
        </div>

        <div class="st-screen" data-screen>
          <canvas class="st-noise" width="128" height="80" aria-hidden="true" data-noise></canvas>
          <div class="st-between" data-between><b>Between stations</b><span style="color:#c6cbd1">Turn the dial, or press Next station.</span></div>
          {stations.map((s) => {
            const sh = show(s.id).data, ep = latest(s.id).data, eid = latest(s.id).id;
            return (
              <div class="st-station" data-card={s.id} hidden>
                <div class="st-art"><Image src={SHOW_COVERS[s.id]} alt={COVER_ALTS[s.id]} width={240} /></div>
                <div><p class="st-pill" style={`--c:${s.c}`}>{s.f.toFixed(1)} MHz</p><h2 class="mt-2">{sh.title}</h2><p>{sh.host}</p></div>
                <div class="st-station__more">
                  <p>{sh.tagline}</p>
                  <div class="st-station__ep"><small>Latest, {dateOf(latest(s.id).data.date)} · {ep.minutes} min</small><b>{ep.title}</b></div>
                  <div class="st-station__go"><button type="button" class="st-btn st-btn--tang" data-play={eid} data-title={ep.title} data-show={sh.title} data-dur={ep.minutes * 60} data-hue={hueOf(sh.colour)} data-label data-idle="Play the latest" aria-pressed="false">Play the latest</button><a href={`${B}/shows/${s.id}/`} class="st-btn">About the show</a></div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
      <noscript><ul class="st-nojs">{stations.map((s) => <li><a href={`${B}/shows/${s.id}/`} class="st-btn st-btn--lg">{s.title}</a></li>)}</ul></noscript>
    </section>

    <section class="st-section" aria-labelledby="new-t"><div class="st-wrap" data-rise>
      <div class="st-head"><h2 id="new-t" class="st-h2">New episodes</h2><a href={`${B}/episodes/`} class="st-btn">All episodes</a></div>
      <div>{eps.slice(0, 4).map((e) => <EpisodeRow entry={e} show={show(e.data.show)} />)}</div>
    </div></section>

    <div class="st-wrap st-band" data-photo-band data-rise>
      <figure class="st-band__main"><Image src={ph_studio_jpg} alt="Two people talking across a table in a dark podcast studio with microphones" width={1400} /><figcaption>Made slowly, with care</figcaption></figure>
      <figure><Image src={ph_hosts_jpg} alt="Two hosts recording a podcast in a studio lined with blue acoustic foam" width={900} /><figcaption>Real conversations</figcaption></figure>
      <figure><Image src={ph_mic_jpg} alt="A studio microphone with a pop filter against acoustic foam" width={900} /><figcaption>Every show starts here</figcaption></figure>
    </div>

    <section class="st-section st-section--ink" aria-labelledby="sh-t"><div class="st-wrap" data-rise>
      <div class="st-head"><h2 id="sh-t" class="st-h2">The four shows.</h2><a href={`${B}/shows/`} class="st-btn">All shows</a></div>
      <ul class="st-grid st-grid--4" role="list">{shows.map((s) => <li><a href={`${B}/shows/${s.id}/`} class="st-show"><div class="st-art"><Image src={SHOW_COVERS[s.id]} alt={COVER_ALTS[s.id]} width={600} /></div><span class="st-pill self-start" style={`--c:${s.data.colour}`}>{s.data.category}</span><h3 class="st-h3">{s.data.title}</h3><p>{s.data.tagline}</p></a></li>)}</ul>
    </div></section>

    <section class="st-section"><div class="st-wrap"><div class="st-cta"><h2 class="st-h2" style="max-width:18ch">Got a show in you?</h2><p class="st-lede mt-3" style="color:#b6bcc4">We help independent hosts make shows they are proud of. Tell us your idea.</p><a href={`${B}/about/#pitch`} class="st-btn st-btn--lg mt-6">Pitch a show</a></div></div></section>
  </Shell>
</Site>

<script>
  /* The tuner: a range slider is the real control; the needle, the readout, the static and the card follow it. */
  const root = document.querySelector<HTMLElement>('[data-tuner]')!;
  const range = root.querySelector<HTMLInputElement>('[data-range]')!;
  const freq = root.querySelector<HTMLElement>('[data-freq]')!;
  const scale = root.querySelector<HTMLElement>('[data-scale]')!;
  const screen = root.querySelector<HTMLElement>('[data-screen]')!;
  const noise = root.querySelector<HTMLCanvasElement>('[data-noise]')!;
  const marks = [...root.querySelectorAll<HTMLButtonElement>('[data-st]')];
  const cards = [...root.querySelectorAll<HTMLElement>('[data-card]')];
  const stations = marks.map((m) => ({ id: m.dataset.st!, f: Number(m.dataset.f), el: m })).sort((a, b) => a.f - b.f);
  const LO = 88, HI = 108, LOCK = 0.6;

  function tune() {
    const f = Number(range.value) / 10;
    freq.textContent = f.toFixed(1);
    range.setAttribute('aria-valuetext', f.toFixed(1) + ' megahertz');
    scale.style.setProperty('--p', String(((f - LO) / (HI - LO)) * 100));
    let near = stations[0], d = Infinity;
    for (const s of stations) { const x = Math.abs(s.f - f); if (x < d) { d = x; near = s; } }
    const lock = d <= LOCK;
    screen.classList.toggle('is-lock', lock);
    noise.style.opacity = lock ? '0' : String(Math.min(1, 0.35 + d / 1.4));
    cards.forEach((c) => (c.hidden = !(lock && c.dataset.card === near.id)));
    marks.forEach((m) => m.classList.toggle('is-on', lock && m.dataset.st === near.id));
  }
  range.addEventListener('input', tune);
  marks.forEach((m) => m.addEventListener('click', () => { range.value = String(Math.round(Number(m.dataset.f) * 10)); tune(); }));
  const hop = (dir: 1 | -1) => {
    const f = Number(range.value) / 10;
    const to = dir === 1 ? stations.find((s) => s.f > f + LOCK + 0.01) ?? stations[0] : [...stations].reverse().find((s) => s.f < f - LOCK - 0.01) ?? stations[stations.length - 1];
    range.value = String(Math.round(to.f * 10)); tune();
  };
  root.querySelector('[data-next]')!.addEventListener('click', () => hop(1));
  root.querySelector('[data-prev]')!.addEventListener('click', () => hop(-1));

  /* Static: random grey grain on a small canvas, scaled up; a still frame for reduced motion. */
  const ctx = noise.getContext('2d')!;
  const img = ctx.createImageData(noise.width, noise.height);
  function grain() {
    for (let i = 0; i < img.data.length; i += 4) { const v = 70 + Math.random() * 150; img.data[i] = v; img.data[i + 1] = v; img.data[i + 2] = v + 6; img.data[i + 3] = 255; }
    ctx.putImageData(img, 0, 0);
  }
  grain();
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    setInterval(() => { if (!screen.classList.contains('is-lock')) grain(); }, 90);
    document.documentElement.classList.add('st-js');
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -10% 0px' });
    document.querySelectorAll('[data-rise]').forEach((el) => io.observe(el));
  }
  tune();
</script>
