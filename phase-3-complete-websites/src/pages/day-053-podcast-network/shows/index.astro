---
/** Day 053 · Static · all shows from the "shows" collection, filterable by category. */
import { getCollection } from 'astro:content';
import Site from '../../../layouts/Site.astro';
import Shell from '../../../components/day-053/Shell.astro';
import { Image } from 'astro:assets';
import { hueOf } from '../../../days/day-053/art';
import { SHOW_COVERS, COVER_ALTS, HOST_PHOTOS } from '../../../days/day-053/photos';

const B = '/day-053-podcast-network';
const shows = await getCollection('shows');
const eps = await getCollection('episodes');
const cats = [...new Set(shows.map((s) => s.data.category))].sort();
---
<Site title="Shows · Static" description="Four independent podcasts from the Static network: society, science, travel and business." themeColor="#16181b" icon="S" day={53}>
  <Shell active="shows">
    <header class="st-pagehead"><div class="st-wrap"><ol class="st-crumbs" aria-label="Breadcrumb"><li><a href={`${B}/`}>Home</a></li><li aria-current="page">Shows</li></ol><h1 class="st-h1" style="font-size:clamp(2.4rem,6vw,4.6rem)">Four <span style="color:var(--tang)">shows.</span></h1></div></header>
    <section class="st-section !pt-8"><div class="st-wrap">
      <div class="st-chips mb-6" role="group" aria-label="Category" data-cats><button type="button" data-v="all" aria-pressed="true">All</button>{cats.map((c) => <button type="button" data-v={c} aria-pressed="false">{c}</button>)}</div>
      <ul class="st-grid st-grid--2" role="list">{shows.map((s) => (
        <li data-show data-c={s.data.category}><a href={`${B}/shows/${s.id}/`} class="st-show" style="flex-direction:row;gap:1.2rem;align-items:center"><div class="st-art" style="width:9rem;flex:none"><Image src={SHOW_COVERS[s.id]} alt="" width={300} /></div><div><span class="st-pill" style={`--c:${s.data.colour}`}>{s.data.category}</span><h2 class="st-h3 mt-2" style="font-size:1.6rem">{s.data.title}</h2><p>{s.data.tagline}</p><p style="font-weight:650;margin-top:.3rem">Hosted by {s.data.host} · {eps.filter((e) => e.data.show === s.id).length} episodes</p></div></a></li>
      ))}</ul>
    </div></section>
  </Shell>
</Site>

<script>
  document.querySelector('[data-cats]')!.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
    if (!b) return;
    document.querySelectorAll('[data-cats] button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    document.querySelectorAll<HTMLElement>('li[data-show]').forEach((li) => (li.hidden = !(b.dataset.v === 'all' || li.dataset.c === b.dataset.v)));
  });
</script>
