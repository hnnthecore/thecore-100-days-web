---
/** Day 043 · Rootwork · one page per story, generated from the "stories" collection. */
import { getCollection, render } from 'astro:content';
import Site from '../../../layouts/Site.astro';
import { Image } from 'astro:assets';
import { STORY_PHOTOS, STORY_ALTS } from '../../../days/day-043/photos';
import Shell from '../../../components/day-043/Shell.astro';

export async function getStaticPaths() {
  const all = (await getCollection('stories')).sort((a, b) => b.data.date.localeCompare(a.data.date));
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry, more: all.filter((s) => s.id !== entry.id) } }));
}
const B = '/day-043-community-farm';
const { entry, more } = Astro.props;
const a = entry.data;
const { Content } = await render(entry);
const fmt = (d: string) => new Date(d + 'T00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const mins = Math.max(1, Math.round((entry.body ?? '').split(/\s+/).length / 200));
---
<Site title={`${a.title} · Rootwork Community Farm`} description={a.excerpt} themeColor="#3b6e2c" icon="🌱" day={43}>
  <Shell active="stories">
    <header class="rw-pagehead"><div class="rw-wrap"><div class="rw-article"><ol class="rw-crumbs" aria-label="Breadcrumb"><li><a href={`${B}/`}>Home</a></li><li><a href={`${B}/stories/`}>Stories</a></li><li aria-current="page">{a.title}</li></ol><p class="rw-eyebrow">{a.category}</p><h1 class="rw-h1 mt-3" style="font-size:clamp(2.4rem,5vw,4rem)">{a.title}</h1><p class="rw-byline"><span>{a.author}</span><time datetime={a.date}>{fmt(a.date)}</time><span>{mins} min read</span></p></div></div></header>
    <section class="rw-section !pb-0"><div class="rw-wrap"><figure class="rw-storyhero"><Image src={STORY_PHOTOS[entry.id]} alt={STORY_ALTS[entry.id]} width={1200} loading="eager" /></figure></div></section>
    <section class="rw-section"><div class="rw-wrap"><article class="rw-article"><p class="rw-lede" style="margin-bottom:1.75rem">{a.excerpt}</p><div class="rw-prose"><Content /></div>
      <div class="mt-10 flex flex-wrap gap-3"><a href={`${B}/get-involved/`} class="rw-btn rw-btn--leaf">Volunteer with us</a><a href={`${B}/get-involved/#donate`} class="rw-btn rw-btn--line">Donate</a></div></article></div></section>
    <section class="rw-section rw-section--cream" aria-labelledby="more"><div class="rw-wrap"><div class="rw-head"><h2 id="more" class="rw-h2">More stories</h2></div><ul class="rw-more" role="list">{more.map((s) => <li><a href={`${B}/stories/${s.id}/`} class="rw-card"><div class="rw-card__img"><Image src={STORY_PHOTOS[s.id]} alt="" width={700} class="rw-photo" /></div><div class="rw-card__body"><p class="rw-card__meta">{s.data.category} · {fmt(s.data.date)}</p><h3 class="rw-h3">{s.data.title}</h3><p>{s.data.excerpt}</p></div></a></li>)}</ul></div></section>
  </Shell>
</Site>
