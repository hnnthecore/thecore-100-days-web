---
/** Day 043 · Rootwork · home. Built from days/day-043/DESIGN.md: a farm that is different every month, read from today's date. */
import { getCollection } from 'astro:content';
import Site from '../../layouts/Site.astro';
import { Image } from 'astro:assets';
import Shell from '../../components/day-043/Shell.astro';
import DonateBox from '../../components/day-043/DonateBox.astro';
import { PROGRAMME_PHOTOS, STORY_PHOTOS, AMINA_PORTRAIT } from '../../days/day-043/photos';
import { CROPS, MONTHS, MONTHS_LONG, inSeason } from '../../days/day-043/crops';
import { NOTES, seasonOf } from '../../days/day-043/season';

const B = '/day-043-community-farm';
const BUILD_MONTH = 10;
const programmes = await getCollection('programmes');
const ORDER = ['little-sprouts', 'grow-together', 'seed-to-plate', 'green-jobs'];
const SEASON_OF = { 'little-sprouts': 'spring', 'grow-together': 'summer', 'seed-to-plate': 'autumn', 'green-jobs': 'winter' } as Record<string, string>;
const panels = ORDER.map((id) => programmes.find((p) => p.id === id)!).filter(Boolean);
const stories = (await getCollection('stories')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const today = new Date().toISOString().slice(0, 10);
const allShifts = (await getCollection('shifts')).sort((a, b) => a.data.date.localeCompare(b.data.date));
const upcoming = allShifts.filter((s) => s.data.date >= today);
const shifts = (upcoming.length >= 4 ? upcoming : allShifts.slice(-4)).slice(0, 4);
const fmt = (d: string) => new Date(d + 'T00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const day = (d: string) => new Date(d + 'T00:00').toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' });
---
<Site title="Rootwork Community Farm · Manchester" description="A community farm in the middle of Manchester growing food, skills and friendships. See what is in season this month, volunteer, learn, cook or donate." themeColor="#f4a63a" icon="R" day={43}>
  <Shell active="home" home>
    <section class="sn" data-sn aria-labelledby="h1">
      <div class="sn__top">
        <h1 id="h1" class="sn__h1">Rootwork Community Farm</h1>
        <p class="sn__lede">Two acres in Chorlton, Manchester, where neighbours grow, cook and learn together. Here is what the farm is doing this month.</p>
      </div>
      <p class="sn__month" data-month aria-live="polite">{MONTHS_LONG[BUILD_MONTH - 1]}</p>
      <div class="sn__mid">
        <p class="sn__note" data-note>{NOTES[BUILD_MONTH - 1]}</p>
        <ul class="sn__crops" role="list" data-crops>{CROPS.map((c) => (
          <li data-from={c.from} data-to={c.to} hidden={!inSeason(c, BUILD_MONTH)}><a href={`${B}/whats-growing/`}><span class="sn__pic"><Image src={c.photo} alt={c.alt} width={360} loading="eager" /></span><b>{c.name}</b></a></li>
        ))}</ul>
      </div>
      <div class="sn__months" role="group" aria-label="Pick a month of the year" data-months>{MONTHS.map((m, i) => (
        <button type="button" data-m={i + 1} aria-pressed={i + 1 === BUILD_MONTH} aria-label={MONTHS_LONG[i]}>{m}</button>
      ))}</div>
    </section>

    <section class="sn-pan" aria-labelledby="pan-t">
      <h2 id="pan-t" class="sr-only">Four programmes, one for each season</h2>
      {panels.map((p, i) => (
        <article class={`sn-pan__card sn-pan__card--${SEASON_OF[p.id]}`} style={`--i:${i}`}>
          <div class="sn-pan__text">
            <h3 class="sn-pan__t" data-rise><a href={`${B}/programmes/${p.id}/`}>{p.data.title}</a></h3>
            <p class="sn-pan__tag" data-rise style="--d:1">{p.data.tagline}</p>
            <p class="sn-pan__stat" data-rise style="--d:2"><b>{p.data.stat.value}</b> {p.data.stat.label}</p>
            <p class="sn-pan__facts" data-rise style="--d:3">{p.data.when}. {p.data.who}.</p>
            <p data-rise style="--d:4"><a class="sn-btn" href={`${B}/programmes/${p.id}/`}>Find out more</a></p>
          </div>
          <figure class="sn-pan__pic"><Image src={PROGRAMME_PHOTOS[p.id]} alt={p.data.title} width={1000} loading="lazy" /></figure>
        </article>
      ))}
    </section>

    <section class="sn-dig" aria-labelledby="dig-t"><div class="rw-wrap sn-dig__grid">
      <div class="sn-dig__head"><h2 id="dig-t" class="sn-h" data-rise>Come and dig</h2><p data-rise><a class="sn-btn" href={`${B}/get-involved/`}>See every shift</a></p></div>
      <ul class="sn-shifts" role="list">{shifts.map((s, i) => {
        const left = s.data.spots - s.data.taken;
        return (
          <li data-rise style={`--d:${i}`}><a href={`${B}/get-involved/`}>
            <time datetime={s.data.date}>{day(s.data.date)}</time>
            <b>{s.data.title}</b>
            <span>{s.data.kind}, {s.data.time}, {s.data.where}</span>
            <span class="sn-left" data-ui><i style={`--w:${Math.round((s.data.taken / s.data.spots) * 100)}%`}></i><em>{left} {left === 1 ? 'place' : 'places'} left</em></span>
          </a></li>
        );
      })}</ul>
    </div></section>

    <section class="sn-num" aria-label="Our impact"><div class="rw-wrap"><dl class="rw-stats" data-stats>
      <div><dt>Neighbours growing each week</dt><dd data-count="340">340</dd></div><div><dt>Meals cooked and shared</dt><dd data-count="1200">1,200</dd></div><div><dt>Trainees now in work</dt><dd data-count="46">46</dd></div><div><dt>Years of community growing</dt><dd data-count="12">12</dd></div>
    </dl></div></section>

    <section class="sn-farm" aria-labelledby="farm-t"><div class="rw-wrap">
      <figure class="sn-quote" data-rise>
        <Image src={AMINA_PORTRAIT} alt="Amina, a volunteer, smiling in the greenhouse" width={240} height={240} class="sn-quote__face" />
        <blockquote>“I came for something to do on Saturdays. I stayed because people noticed when I wasn’t there.”</blockquote>
        <figcaption>Amina, volunteer since February</figcaption>
      </figure>
      <h2 id="farm-t" class="sn-h sn-h--sub" data-rise>Stories from the farm</h2>
      <ul class="sn-stories" role="list">{stories.map((s, i) => (
        <li data-rise style={`--d:${i}`}><a href={`${B}/stories/${s.id}/`}>
          <span class="sn-stories__pic"><Image src={STORY_PHOTOS[s.id]} alt="" width={360} height={360} /></span>
          <span class="sn-stories__txt"><b>{s.data.title}</b><span>{s.data.excerpt} <time datetime={s.data.date}>{s.data.category}, {fmt(s.data.date)}.</time></span></span>
        </a></li>
      ))}</ul>
      <p data-rise><a class="rw-link" href={`${B}/stories/`}>All stories</a></p>
    </div></section>

    <section class="sn-give" aria-labelledby="give-t"><div class="rw-wrap rw-two">
      <div><h2 id="give-t" class="sn-h" data-rise>A little goes a long way.</h2><p class="sn-give__p" data-rise style="--d:1">Most of our money comes from people like you. A gift of £12 plants twenty seedlings, and a monthly gift lets us plan for the whole year.</p></div>
      <DonateBox id="home-donate" />
    </div></section>
  </Shell>
</Site>
<script>
  import '../../days/day-043/donate';
  import '../../days/day-043/home';
  import '../../days/day-043/month';
</script>
