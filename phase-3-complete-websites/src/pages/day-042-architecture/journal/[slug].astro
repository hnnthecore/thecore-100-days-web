---
/** Day 042 · Atelier Nord · one article per journal entry: reading progress, a contents list that follows you, and a copy-link button. */
import { getCollection, render } from 'astro:content';
import Site from '../../../layouts/Site.astro';
import Shell from '../../../components/day-042/Shell.astro';

export async function getStaticPaths() {
  const all = (await getCollection('journal')).sort((a, b) => b.data.date.localeCompare(a.data.date));
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry, more: all.filter((p) => p.id !== entry.id).slice(0, 2) } }));
}
const { entry, more } = Astro.props;
const a = entry.data;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
const mins = Math.max(1, Math.round((entry.body ?? '').split(/\s+/).length / 200));
const fmt = (d: string) => new Date(d + 'T00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Site title={`${a.title} · Atelier Nord Journal`} description={a.excerpt} themeColor="#16181b" icon="📐" day={42}>
  <Shell active="journal">
    <div class="an-bar" data-bar aria-hidden="true"></div>
    <header class="an-pagehead">
      <div class="an-wrap">
        <ol class="an-crumbs" aria-label="Breadcrumb"><li><a href="/day-042-architecture/">Home</a></li><li><a href="/day-042-architecture/journal/">Journal</a></li><li aria-current="page">{a.title}</li></ol>
        <p class="an-eyebrow">{a.category}</p>
        <h1 class="an-h1 mt-3" style="font-size:clamp(2.4rem,5.5vw,4.4rem);max-width:18ch">{a.title}</h1>
        <p class="an-byline"><span>By {a.author}</span><time datetime={a.date}>{fmt(a.date)}</time><span>{mins} min read</span></p>
      </div>
    </header>
    <section class="an-section">
      <div class="an-wrap an-article">
        <aside class="an-toc" aria-label="In this article"><h2>In this article</h2><ol data-toc>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></aside>
        <article>
          <p class="an-lede" style="margin-bottom:2rem">{a.excerpt}</p>
          <div class="an-prose" data-prose><Content /></div>
          <div class="an-share"><button type="button" class="an-btn an-btn--line" data-copy>Copy link</button><span role="status" class="text-sm text-(--muted)" data-copy-msg></span></div>
        </article>
      </div>
    </section>
    <section class="an-section an-section--birch" aria-labelledby="more-title">
      <div class="an-wrap"><div class="an-head"><h2 id="more-title" class="an-h2">Keep reading</h2></div>
        <ul class="an-posts" role="list">{more.map((p) => <li><a href={`/day-042-architecture/journal/${p.id}/`} class="an-post"><time datetime={p.data.date}>{fmt(p.data.date)}</time><div><h3 class="an-h3">{p.data.title}</h3><p>{p.data.excerpt}</p></div><span class="an-post__cat">{p.data.category}</span></a></li>)}</ul></div>
    </section>
  </Shell>
</Site>

<script>
  const bar = document.querySelector<HTMLElement>('[data-bar]')!;
  const prose = document.querySelector<HTMLElement>('[data-prose]')!;
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc] a')];
  const heads = links.map((l) => document.getElementById(l.getAttribute('href')!.slice(1))).filter(Boolean) as HTMLElement[];
  function onScroll() {
    const r = prose.getBoundingClientRect();
    const p = Math.max(0, Math.min(1, (innerHeight * 0.3 - r.top) / (r.height - innerHeight * 0.1)));
    bar.style.setProperty('--p', `${(p * 100).toFixed(1)}%`);
    let cur = 0;
    heads.forEach((h, i) => { if (h.getBoundingClientRect().top < innerHeight * 0.35) cur = i; });
    links.forEach((l, i) => l.classList.toggle('is-on', i === cur));
  }
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  document.querySelector('[data-copy]')!.addEventListener('click', async () => {
    const msg = document.querySelector('[data-copy-msg]')!;
    try { await navigator.clipboard.writeText(location.href); msg.textContent = 'Link copied.'; } catch { msg.textContent = 'Copy the address from your browser bar.'; }
  });
</script>
