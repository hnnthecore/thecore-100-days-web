---
/** Day 042 · Atelier Nord · all projects, filterable by type with a grid or list view. */
import { getCollection } from 'astro:content';
import Site from '../../../layouts/Site.astro';
import Shell from '../../../components/day-042/Shell.astro';
import { Image } from 'astro:assets';
import { PROJECT_PHOTOS } from '../../../days/day-042/photos';

const projects = (await getCollection('projects')).sort((a, b) => b.data.year - a.data.year);
const byYear = [...projects].sort((a, b) => a.data.year - b.data.year || a.id.localeCompare(b.id));
const no = (id: string, year: number) => `AN-${year}-${String(byYear.findIndex((x) => x.id === id) + 1).padStart(2, '0')}`;
const types = [...new Set(projects.map((p) => p.data.type))];
---
<Site title="Projects · Atelier Nord" description="Homes, libraries, schools and workplaces designed by Atelier Nord, Edinburgh. Filter by type and explore each case study." themeColor="#16181b" icon="📐" day={42}>
  <Shell active="projects">
    <header class="an-pagehead">
      <div class="an-wrap"><ol class="an-crumbs" aria-label="Breadcrumb"><li><a href="/day-042-architecture/">Home</a></li><li aria-current="page">Projects</li></ol><h1 class="an-h1">Our work</h1><p class="an-lede mt-4">{projects.length} projects across homes, civic buildings, schools and workplaces. Each started with a site and a question.</p></div>
    </header>
    <section class="an-section">
      <div class="an-wrap">
        <div class="an-tools">
          <div class="an-chips" role="group" aria-label="Project type" data-types>
            <button type="button" data-type="all" aria-pressed="true">All</button>
            {types.map((t) => <button type="button" data-type={t} aria-pressed="false">{t}</button>)}
          </div>
          <p class="an-count" aria-live="polite" data-count>{projects.length} projects</p>
        </div>
        <div class="an-sheet">
          <div class="an-sheet__list">
            <div class="an-sheet__head" aria-hidden="true"><span>No.</span><span>Project</span><span>Location</span><span>Type</span><span>Year</span><span>m²</span></div>
            <ol class="an-rows" role="list" data-grid>{projects.map((p) => (
              <li class="an-row" data-project data-slug={p.id} data-type={p.data.type} data-year={p.data.year} data-title={p.data.title.toLowerCase()} data-area={p.data.area}>
                <a href={`/day-042-architecture/projects/${p.id}/`} class="an-row__a">
                  <span class="an-row__no">{no(p.id, p.data.year)}</span>
                  <span class="an-row__t">{p.data.title}</span>
                  <span class="an-row__l">{p.data.location}</span>
                  <span class="an-row__ty">{p.data.type}</span>
                  <span class="an-row__yr">{p.data.year}</span>
                  <span class="an-row__m">{p.data.area.toLocaleString('en-GB')}</span>
                  <Image src={PROJECT_PHOTOS[p.id]} alt="" width={240} class="an-row__thumb" />
                </a>
              </li>
            ))}</ol>
          </div>
          <div class="an-sheet__preview" aria-hidden="true">{projects.map((p, i) => <figure data-for={p.id} class:list={[i === 0 && 'is-on']}><Image src={PROJECT_PHOTOS[p.id]} alt="" width={900} /><figcaption>{p.data.title} · {p.data.location} · {p.data.year}</figcaption></figure>)}</div>
        </div>
      </div>
    </section>
  </Shell>
</Site>

<script>
  import '../../../days/day-042/projects';
</script>
