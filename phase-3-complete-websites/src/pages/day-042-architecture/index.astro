---
/** Day 042 · Atelier Nord · home page. Projects and journal posts come from content collections. */
import { getCollection } from 'astro:content';
import Site from '../../layouts/Site.astro';
import { Image } from 'astro:assets';
import ph_white_house_jpg from '../../assets/day-042/white-house.jpg';
import ph_brick_terrace_jpg from '../../assets/day-042/brick-terrace.jpg';
import ph_facade_jpg from '../../assets/day-042/facade.jpg';
import Shell from '../../components/day-042/Shell.astro';
import ProjectCard from '../../components/day-042/ProjectCard.astro';
import { PROJECT_PHOTOS } from '../../days/day-042/photos';

const projects = (await getCollection('projects')).sort((a, b) => b.data.year - a.data.year);
const featured = projects.filter((p) => p.data.featured).slice(0, 4);
const hero = projects.find((p) => p.id === 'house-on-the-skerry')!;
const posts = (await getCollection('journal')).sort((a, b) => b.data.date.localeCompare(a.data.date)).slice(0, 3);
const fmt = (d: string) => new Date(d + 'T00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Site title="Atelier Nord · Architecture studio, Edinburgh" description="An independent architecture studio in Edinburgh designing quiet, low-carbon buildings for homes, schools, libraries and workplaces. (Day 042 of Thecore's 100 Days of Web, a demo site.)" themeColor="#16181b" icon="📐" day={42}>
  <Shell active="home">
    <section class="an-hero an-hero--full" aria-labelledby="hero-title">
      <Image src={PROJECT_PHOTOS[hero.id]} alt="" width={2000} class="an-hero__img" loading="eager" />
      <div class="an-hero__shade" aria-hidden="true"></div>
      <div class="an-wrap an-hero__text">
        <p class="an-eyebrow">Architecture · Edinburgh · Since 2011</p>
        <h1 id="hero-title" class="an-h1 mt-5">Buildings that <em>listen</em> to their place.</h1>
        <p class="an-lede mt-6">We design quiet, low-carbon homes, schools and civic buildings with a small team, a big pencil and a lot of patience.</p>
        <div class="mt-8 flex flex-wrap gap-3"><a href="/day-042-architecture/projects/" class="an-btn an-btn--lg an-btn--paper">See our work</a><a href="/day-042-architecture/contact/" class="an-btn an-btn--lg an-btn--ghost">Start a project</a></div>
      </div>
      <a href={`/day-042-architecture/projects/${hero.id}/`} class="an-hero__tag">{hero.data.title} · {hero.data.location} →</a>
    </section>
    <div class="an-statsbar"><div class="an-wrap">
      <dl class="an-stats !mt-0"><div><dt>Projects completed</dt><dd>64</dd></div><div><dt>Awards and shortlists</dt><dd>21</dd></div><div><dt>Average energy saving</dt><dd>72%</dd></div><div><dt>Years in practice</dt><dd>15</dd></div></dl>
    </div></div>

    <section class="an-section" aria-labelledby="featured-title">
      <div class="an-wrap">
        <div class="an-head"><div><p class="an-eyebrow">Selected work</p><h2 id="featured-title" class="an-h2 mt-3">Recent projects</h2></div><a href="/day-042-architecture/projects/" class="an-link">All {projects.length} projects →</a></div>
        <ul class="an-grid" role="list">{featured.map((p) => <ProjectCard slug={p.id} {...p.data} />)}</ul>
      </div>
    </section>

    <div class="an-wrap an-band" data-photo-band>
        <figure class="an-band__main"><Image src={ph_white_house_jpg} alt="A white modern house with dark brick panels and a balcony" width={1400} /><figcaption>Quiet, low-carbon homes</figcaption></figure>
        <figure><Image src={ph_brick_terrace_jpg} alt="A contemporary brick townhouse with a stepped gable and neat hedge" width={900} /><figcaption>Built to last</figcaption></figure>
        <figure><Image src={ph_facade_jpg} alt="A white facade with tall translucent windows" width={900} /><figcaption>Light by design</figcaption></figure>
      </div>

    <section class="an-section an-section--ink" aria-labelledby="how-title">
      <div class="an-wrap">
        <div class="an-head"><div><p class="an-eyebrow !text-(--amber)">How we work</p><h2 id="how-title" class="an-h2 mt-3">Three beliefs. <em>Every project.</em></h2></div></div>
        <div class="an-principles">
          <div class="an-principle"><b>01</b><h3 class="an-h3">Start with the site</h3><p>Weather, light, ground and neighbours decide the building. We spend more time looking than drawing.</p></div>
          <div class="an-principle"><b>02</b><h3 class="an-h3">Carbon is a design brief</h3><p>Natural materials, thick walls and honest detailing. Our buildings use about a quarter of the energy of a typical new one.</p></div>
          <div class="an-principle"><b>03</b><h3 class="an-h3">Make it last</h3><p>Repairable, adaptable and loved. A building that is still wanted in a hundred years is the most sustainable one.</p></div>
        </div>
      </div>
    </section>

    <section class="an-section" aria-labelledby="journal-title">
      <div class="an-wrap">
        <div class="an-head"><div><p class="an-eyebrow">Journal</p><h2 id="journal-title" class="an-h2 mt-3">What we’re thinking about</h2></div><a href="/day-042-architecture/journal/" class="an-link">All articles →</a></div>
        <ul class="an-posts" role="list">
          {posts.map((p) => (
            <li><a href={`/day-042-architecture/journal/${p.id}/`} class="an-post"><time datetime={p.data.date}>{fmt(p.data.date)}</time><div><h3 class="an-h3">{p.data.title}</h3><p>{p.data.excerpt}</p></div><span class="an-post__cat">{p.data.category}</span></a></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="an-section an-section--birch" aria-labelledby="cta-title">
      <div class="an-wrap an-cta">
        <div><h2 id="cta-title" class="an-h2">Got a site, a brief or just <em>a feeling?</em></h2><p class="an-lede mt-3">The first conversation is free. Bring a photo of the plot and a list of what matters.</p></div>
        <a href="/day-042-architecture/contact/" class="an-btn an-btn--ink an-btn--lg">Start a conversation</a>
      </div>
    </section>
  </Shell>
</Site>
