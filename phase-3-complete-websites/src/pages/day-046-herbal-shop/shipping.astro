---
/** Day 046 · Wildcombe Herbal · shipping and returns, in plain words. */
import Site from '../../layouts/Site.astro';
import Shell from '../../components/day-046/Shell.astro';
const B = '/day-046-herbal-shop';
const ROWS = [['Standard', '2 to 4 working days', '£3.95', 'Free over £35'], ['Next working day', 'Next working day', '£6.95', 'Order before 1pm, Monday to Thursday'], ['Collection', 'Thursday to Saturday, 10 to 4', 'Free', 'At Wildcombe Farm, Ashprington']] as const;
---
<Site title="Shipping and returns · Wildcombe Herbal" description="How and when we post your order, what it costs, and how to send something back." themeColor="#f3dd6b" icon="W" day={46}>
  <Shell active="help">
    <section class="wi" aria-labelledby="h1"><div class="wh-wrap wi__grid">
      <div class="wi__main">
        <h1 id="h1" class="ws__h">Shipping and returns.</h1>
        <p class="wh-lead">We pack to order at the farm on Tuesdays and Fridays and post by Royal Mail the next working day, so most orders reach you within the week.</p>
        <div class="wt__wrap"><table class="wt__tbl wi__tbl"><thead><tr><th scope="col">Method</th><th scope="col">Time</th><th scope="col">Price</th><th scope="col">Note</th></tr></thead><tbody>{ROWS.map(([a, b, c, d]) => <tr><th scope="row">{a}</th><td data-l="Time">{b}</td><td data-l="Price">{c}</td><td data-l="Note">{d}</td></tr>)}</tbody></table></div>
        <h2>Where we deliver</h2>
        <p>We deliver to all addresses in the United Kingdom, including Northern Ireland, the Isle of Man and the Channel Islands. Orders to Highlands and Islands postcodes can take a day longer. We do not ship outside the UK yet.</p>
        <h2>Tracking</h2>
        <p>Every order has a tracking number, which we email when it is posted. If your parcel has not come after seven working days, write to us and we will chase it or send another.</p>
        <h2>Packaging</h2>
        <p>Teas travel in recycled card and paper pouches. Jars are wrapped in paper, not plastic, and everything goes in a recycled cardboard box that fits through a letterbox where it can.</p>
        <h2>Returns</h2>
        <p>If you are not happy with an unopened product, send it back within 30 days and we will refund the price. Opened food and body products cannot be returned for hygiene reasons, but if something is wrong with it, tell us and we will put it right. Write to hello@wildcombeherbal.co.uk with your order number and we will send you the return address.</p>
        <h2>Damaged or missing</h2>
        <p>If something arrives broken or is missing, send us a photo and we will replace it, no questions asked.</p>
      </div>
      <aside class="wi__side"><h2>Need it fast?</h2><p>Choose next working day at checkout and order before 1pm Monday to Thursday.</p><p><a class="wh-btn" href={`${B}/shop/`}>Shop the cabinet</a></p><p class="wh-soft">Questions? <a class="wh-link" href={`${B}/contact/`}>Get in touch</a>.</p></aside>
    </div></section>
  </Shell>
</Site>
