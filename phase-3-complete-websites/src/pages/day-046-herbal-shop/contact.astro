---
/** Day 046 · Wildcombe Herbal · contact: how to reach the farm, and a short form. */
import Site from '../../layouts/Site.astro';
import Shell from '../../components/day-046/Shell.astro';
import { Image } from 'astro:assets';
import cottages from '../../assets/day-046-photos/stone-cottages.jpg';
---
<Site title="Contact · Wildcombe Herbal" description="Write to the farm, or come and collect your order. Wildcombe Farm, Combe Lane, Ashprington, Totnes." themeColor="#8db4ec" icon="W" day={46}>
  <Shell active="help">
    <section class="wi" aria-labelledby="h1"><div class="wh-wrap wi__grid">
      <div class="wi__main">
        <h1 id="h1" class="ws__h">Contact.</h1>
        <p class="wh-lead">Write to the farm and a person will answer, usually within a day. For orders, include your order number.</p>
        <form class="wk__form wi__form" data-contact novalidate>
          <div class="wk__2"><div class="wk__f"><label class="wh-label" for="m-name">Your name</label><input class="wh-input" id="m-name" autocomplete="name" required /><p class="wh-err" data-err="name"></p></div>
            <div class="wk__f"><label class="wh-label" for="m-email">Email</label><input class="wh-input" id="m-email" type="email" autocomplete="email" required /><p class="wh-err" data-err="email"></p></div></div>
          <div class="wk__f"><label class="wh-label" for="m-topic">What is it about?</label><select class="wh-input" id="m-topic"><option>An order</option><option>A product question</option><option>The tea club</option><option>Wholesale</option><option>Something else</option></select></div>
          <div class="wk__f"><label class="wh-label" for="m-msg">Message</label><textarea class="wh-input" id="m-msg" required></textarea><p class="wh-err" data-err="msg"></p></div>
          <button type="submit" class="wh-btn">Send message</button>
          <p class="wq__ok" data-ok role="status"></p>
        </form>
      </div>
      <aside class="wi__side">
        <h2>Visit the farm</h2>
        <address>Wildcombe Farm, Combe Lane<br />Ashprington, Totnes TQ9 7UT</address>
        <p>Open for collection and a cup of tea, Thursday to Saturday, 10 to 4. Phone 01632 960463 or email hello@wildcombeherbal.co.uk.</p>
        <figure class="wi__pic"><Image src={cottages} alt="A row of stone cottages with climbing roses on a village lane" width={800} /></figure>
      </aside>
    </div></section>
  </Shell>
</Site>
<script>
  import '../../days/day-046/contact';
</script>
