---
/** Day 046 · Wildcombe Herbal · home. Built from days/day-046/DESIGN.md: the shop as a herbarium, with a pinned poster of six plates. */
import { getCollection } from 'astro:content';
import Site from '../../layouts/Site.astro';
import { Image } from 'astro:assets';
import Shell from '../../components/day-046/Shell.astro';
import Plate from '../../components/day-046/Plate.astro';
import ProductCard from '../../components/day-046/ProductCard.astro';
import { PRODUCTS, byId, fromPrice, money, TIMES, TASTES } from '../../days/day-046/products';
import drying from '../../assets/day-046-photos/drying-herbs.jpg';
import cottages from '../../assets/day-046-photos/stone-cottages.jpg';
import infuser from '../../assets/day-046-photos/tea-infuser.jpg';

const B = '/day-046-herbal-shop';
const POSTER = ['chamomile', 'peppermint', 'calendula-salve', 'comfrey-balm', 'nettle', 'elderberry-syrup'].map(byId);
const posts = (await getCollection('herbJournal')).sort((a, b) => b.data.date.localeCompare(a.data.date)).slice(0, 2);
const fmt = (d: string) => new Date(d + 'T00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const BREW = [['Chamomile Flowers', '1 heaped teaspoon', '95°C', '5 minutes'], ['Stinging Nettle Leaf', '1 heaped teaspoon', '100°C', '5 to 7 minutes'], ['Lemon Balm', '1 heaped teaspoon', '95°C', '5 minutes'], ['Peppermint', '1 heaped teaspoon', '95°C', '4 minutes'], ['Lime Blossom', '2 teaspoons', '95°C', '5 to 6 minutes'], ['Quiet Hours Blend', '1 heaped teaspoon', '95°C', '6 minutes']] as const;
---
<Site title="Wildcombe Herbal · Loose-leaf herbal teas, salves and syrups from Devon" description="Herbs grown, dried and blended on a south-facing combe on the edge of Dartmoor. Loose-leaf teas, salves and balms, syrups and tinctures, bath salts and gifts, posted from the farm." themeColor="#f5a623" icon="W" day={46}>
  <Shell>
    <section class="wp" data-poster aria-labelledby="h1">
      <div class="wp__stick"><h1 id="h1" class="wp__title">Wildcombe <i>Herbal</i></h1></div>
      {POSTER.map((p, i) => (
        <article class:list={['wp__panel', i % 2 === 1 && 'is-flip']} style={`--f:${p.field}`} data-panel>
          <div class="wp__text">
            <p class="wh-latin wp__latin">{p.latin}</p>
            <h2 class="wp__name">{p.name}</h2>
            <p class="wp__line">{p.line}</p>
          </div>
          <a class="wp__plate" href={`${B}/shop/${p.id}/`} aria-label={`${p.name}: see the product`}><Plate id={p.id} width={900} loading={i === 0 ? 'eager' : 'lazy'} class="wp__img" /></a>
          <div class="wp__buy">
            <p class="wp__price">{p.sizes.length > 1 ? 'From ' : ''}{money(fromPrice(p))}</p>
            <button type="button" class="wh-btn" data-add={p.id} data-size={p.sizes[0].id}>Add to basket</button>
            <a class="wh-link" href={`${B}/shop/${p.id}/`}>About this plate</a>
          </div>
        </article>
      ))}
    </section>

    <section class="wc" aria-labelledby="wc-t" data-cabinet><div class="wh-wrap">
      <h2 id="wc-t" class="wh-h">What do you fancy a cup of?</h2>
      <div class="wc__pick">
        <div role="group" aria-label="Time of day" class="wc__row"><span class="wc__lab">At</span>
          <button type="button" aria-pressed="true" data-time="">Any hour</button>{(Object.entries(TIMES)).map(([k, v]) => <button type="button" aria-pressed="false" data-time={k}>{v}</button>)}</div>
        <div role="group" aria-label="Taste" class="wc__row"><span class="wc__lab">Tasting</span>
          <button type="button" aria-pressed="true" data-taste="">Anything</button>{(Object.entries(TASTES)).map(([k, v]) => <button type="button" aria-pressed="false" data-taste={k}>{v}</button>)}</div>
      </div>
      <p class="wc__say" data-say role="status" aria-live="polite">Twelve plates in the cabinet. Pick an hour or a taste and the right ones come forward.</p>
      <ul class="wh-cab" data-cab role="list">{PRODUCTS.filter((p) => p.cat !== 'gifts').map((p, i) => <ProductCard id={p.id} eager={i < 4} />)}</ul>
      <p class="wc__more"><a class="wh-link" href={`${B}/shop/`}>See everything, including gifts and kits</a></p>
    </div></section>

    <section class="wb" aria-labelledby="wb-t"><div class="wh-wrap wb__grid">
      <div class="wb__text">
        <h2 id="wb-t" class="wh-h">Grown on a combe above the Dart.</h2>
        <p class="wh-lead">Wildcombe is fourteen small beds on a south-facing slope on the edge of Dartmoor. Everything we sell is picked by hand, dried on racks in the barn the same day, and packed in Totnes on Tuesdays and Fridays.</p>
        <p>We started with a stall at the Friday market in 2011, with a dozen herbs and a hand scale. Now there are a few more people, but the picking is still done by whoever is in that morning. Anything we cannot grow ourselves, we buy from growers we know by name, and we say so on the label.</p>
        <p><a class="wh-link" href={`${B}/about/`}>Read our story</a></p>
      </div>
      <figure class="wb__pic wb__pic--a"><Image src={drying} alt="Bunches of herbs hanging to dry" width={1100} /></figure>
      <figure class="wb__pic wb__pic--b"><Image src={cottages} alt="A row of stone cottages with climbing roses on a village lane" width={900} /></figure>
    </div></section>

    <section class="wt" aria-labelledby="wt-t"><div class="wh-wrap">
      <h2 id="wt-t" class="wh-h">A proper cup, every time.</h2>
      <p class="wh-lead wt__p">Loose herbs like room to move. Use a pot or a large mug with a strainer, warm it first, and cover it while it steeps so the oils stay in.</p>
      <div class="wt__wrap"><table class="wt__tbl"><thead><tr><th scope="col">Tea</th><th scope="col">Per cup</th><th scope="col">Water</th><th scope="col">Steep</th></tr></thead><tbody>{BREW.map(([a, b, c, d]) => <tr><th scope="row">{a}</th><td data-l="Per cup">{b}</td><td data-l="Water">{c}</td><td data-l="Steep">{d}</td></tr>)}</tbody></table></div>
    </div></section>

    <section class="wl" aria-labelledby="wl-t"><div class="wh-wrap wl__grid">
      <div><h2 id="wl-t" class="wh-h">The tea club.</h2>
        <p class="wh-lead">Two or three of our teas, picked by us, posted on the first Monday of each month. Pause, skip or stop whenever you like.</p>
        <p><a class="wh-btn" href={`${B}/tea-club/`}>See the tea club</a></p></div>
      <figure class="wl__pic"><Image src={infuser} alt="A glass cup of herbal tea with an infuser, on a wooden board" width={1000} /></figure>
    </div></section>

    <section class="wj" aria-labelledby="wj-t"><div class="wh-wrap">
      <h2 id="wj-t" class="wh-h">From the journal.</h2>
      <div class="wj__grid">{posts.map((p) => (
        <a href={`${B}/journal/${p.id}/`} class="wj__post"><h3>{p.data.title}</h3><p>{p.data.excerpt}</p><time datetime={p.data.date}>{fmt(p.data.date)}</time></a>
      ))}
        <a href={`${B}/journal/`} class="wj__post wj__post--all"><h3>All the notes</h3><p>Brewing, drying, and a year on the combe.</p><span>Read the journal</span></a></div>
    </div></section>
  </Shell>
</Site>
<script>
  import '../../days/day-046/home';
</script>
