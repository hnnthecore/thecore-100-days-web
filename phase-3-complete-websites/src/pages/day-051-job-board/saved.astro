---
/** Day 051 · Hirewell · "My jobs": saved roles to compare side by side, and roles you have applied for. */
import { getCollection } from 'astro:content';
import Site from '../../layouts/Site.astro';
import Shell from '../../components/day-051/Shell.astro';

const B = '/day-051-job-board';
const jobs = await getCollection('jobs');
const companies = await getCollection('companies');
const index = jobs.map((j) => ({ id: j.id, title: j.data.title, company: companies.find((c) => c.id === j.data.company)!.data.name, colour: companies.find((c) => c.id === j.data.company)!.data.colour, location: j.data.location, mode: j.data.mode, type: j.data.type, level: j.data.level, min: j.data.min, max: j.data.max, url: `${B}/jobs/${j.id}/` }));
---
<Site title="My jobs · Hirewell" description="Your saved jobs and applications on Hirewell, kept on this device." themeColor="#2a44ff" icon="H" day={51}>
  <Shell active="saved">
    <header class="hw-pagehead"><div class="hw-wrap"><ol class="hw-crumbs" aria-label="Breadcrumb"><li><a href={`${B}/`}>Home</a></li><li aria-current="page">My jobs</li></ol><h1 class="hw-h1" style="font-size:clamp(2.2rem,5vw,3.8rem)">My <span class="hw-hl">jobs.</span></h1><p class="hw-lede mt-3">Saved roles and applications live on this device. No account needed.</p></div></header>
    <section class="hw-section !pt-8"><div class="hw-wrap">
      <div class="hw-head"><h2 class="hw-h2" id="sv-t">Saved <span data-n-saved></span></h2></div>
      <div hidden data-compare class="mb-8" style="overflow-x:auto"><table class="w-full text-left" style="min-width:36rem;border-collapse:collapse" aria-label="Saved jobs comparison"><thead><tr data-thead></tr></thead><tbody data-tbody></tbody></table></div>
      <ul class="grid gap-3" role="list" data-saved aria-labelledby="sv-t"></ul>
      <div hidden data-empty class="hw-card"><p class="hw-h3" style="color:var(--ink)">No saved jobs yet.</p><p>Tap the star on any listing and it will appear here.</p><a href={`${B}/jobs/`} class="hw-btn hw-btn--solid self-start">Find jobs</a></div>

      <div class="hw-head mt-14"><h2 class="hw-h2">Applied <span data-n-applied></span></h2></div>
      <ul class="grid gap-3" role="list" data-applied></ul>
      <p style="color:var(--muted)" data-none-applied>You have not applied for anything yet.</p>
    </div></section>
  </Shell>
</Site>

<script define:vars={{ index }}>
  window.__index = index;
</script>
<script>
  import { saved, applied, gbp, pay } from '../../days/day-051/store';
  type J = { id: string; title: string; company: string; colour: string; location: string; mode: string; type: string; level: string; min: number; max: number; url: string };
  const all = (window as unknown as { __index: J[] }).__index;
  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const row = (j: J, star: boolean) => `<li class="hw-card is-link" style="flex-direction:row;align-items:center;gap:1rem"><span class="hw-logo-tile" style="background:${j.colour}" aria-hidden="true">${esc(j.company[0])}</span><a href="${j.url}" style="flex:1"><b class="hw-h3" style="display:block">${esc(j.title)}</b><span style="color:var(--muted)">${esc(j.company)} · ${esc(j.location)} · ${pay(j.min, j.max)}</span></a>${star ? `<button type="button" class="hw-star" style="position:static" data-save="${j.id}" data-title="${esc(j.title)}" aria-pressed="true"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 3l2.7 5.8 6.3.7-4.7 4.3 1.3 6.2L12 17l-5.6 3 1.3-6.2L3 9.5l6.3-.7z" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg></button>` : '<span class="hw-badge">Applied</span>'}</li>`;

  function paint() {
    const mine = saved.all().map((id) => all.find((j) => j.id === id)).filter(Boolean) as J[];
    $('[data-n-saved]').textContent = mine.length ? `(${mine.length})` : '';
    $('[data-saved]').innerHTML = mine.map((j) => row(j, true)).join('');
    $<HTMLElement>('[data-empty]').hidden = mine.length > 0;
    const cmp = $<HTMLElement>('[data-compare]');
    cmp.hidden = mine.length < 2;
    if (mine.length >= 2) {
      const top = Math.max(...mine.map((j) => (j.max < 1000 ? j.max * 250 : j.max)));
      $('[data-thead]').innerHTML = '<th style="padding:.6rem"></th>' + mine.map((j) => `<th style="padding:.6rem;font-family:var(--head)"><a href="${j.url}">${esc(j.title)}</a><br><small style="color:var(--muted);font-weight:500">${esc(j.company)}</small></th>`).join('');
      const line = (label: string, f: (j: J) => string, best?: (j: J) => boolean) => `<tr class="hw-cmp"><th scope="row" style="padding:.6rem;color:var(--muted);font-weight:600">${label}</th>${mine.map((j) => `<td style="padding:.6rem;font-weight:600${best?.(j) ? ';background:var(--lime)' : ''}">${f(j)}</td>`).join('')}</tr>`;
      $('[data-tbody]').innerHTML = line('Pay', (j) => pay(j.min, j.max), (j) => (j.max < 1000 ? j.max * 250 : j.max) === top) + line('Location', (j) => esc(j.location)) + line('Work mode', (j) => j.mode) + line('Contract', (j) => j.type) + line('Level', (j) => j.level);
    }
    const done = applied.all().map((id) => all.find((j) => j.id === id)).filter(Boolean) as J[];
    $('[data-n-applied]').textContent = done.length ? `(${done.length})` : '';
    $('[data-applied]').innerHTML = done.map((j) => row(j, false)).join('');
    $<HTMLElement>('[data-none-applied]').hidden = done.length > 0;
  }
  addEventListener('saved:change', paint);
  addEventListener('applied:change', paint);
  paint();
  void gbp;
</script>
