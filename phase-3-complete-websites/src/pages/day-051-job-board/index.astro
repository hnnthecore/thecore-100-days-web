---
/** Day 051 · Hirewell · home: every role as a bar on one pay scale, with a line you drag to the salary you need. See days/day-051/DESIGN.md. */
import { getCollection } from 'astro:content';
import Site from '../../layouts/Site.astro';
import { Image } from 'astro:assets';
import { COMPANY_PHOTOS, COMPANY_ALTS } from '../../days/day-051/photos';
import Shell from '../../components/day-051/Shell.astro';

const B = '/day-051-job-board';
const all = await getCollection('jobs');
const companies = await getCollection('companies');
const co = (id: string) => companies.find((c) => c.id === id)!;
const annual = all.filter((j) => j.data.max >= 1000).sort((a, b) => b.data.max - a.data.max);
const contract = all.filter((j) => j.data.max < 1000);
const cats = [...new Set(annual.map((j) => j.data.category))].sort();
const LO = 10000, HI = 90000, SPAN = HI - LO;
const pct = (n: number) => ((n - LO) / SPAN) * 100;
const k = (n: number) => '£' + Math.round(n / 1000) + 'k';
const ticks = [10, 20, 30, 40, 50, 60, 70, 80, 90];
const PROMISES = [['The pay is on the listing', 'Every role shows a salary range before you click. If a company will not say, it cannot post here.'], ['Applying takes two minutes', 'A name, an email and a CV. No account, no personality quiz, no asking you to retype your CV into boxes.'], ['Roles close when they are filled', 'When a company hires, the listing comes down the same day, so you are never applying to a role that is gone.']];
const CHART = JSON.stringify(annual.map((j) => ({ id: j.id, min: j.data.min, max: j.data.max, cat: j.data.category, posted: j.data.posted })));
---
<Site title="Hirewell · Jobs where the pay is the first thing you see" description="Hirewell is a job board that shows every salary up front. See twelve roles on one pay scale, drag the line to the salary you need and apply in two minutes." themeColor="#2a44ff" icon="H" day={51}>
  <Shell>
    <section class="hw-wrap hw-hero" aria-labelledby="pay-t">
      <h1 id="pay-t" class="hw-h1">What does it actually pay?</h1>
      <p class="hw-lede">Every salaried role we have open, drawn on one scale. Drag the orange line to the pay you need and see who can afford you.</p>
      <div class="hw-ctl">
        <div class="hw-chips" role="group" aria-label="Category" data-cats>
          <button type="button" aria-pressed="true" data-cat="all">All roles</button>
          {cats.map((c) => <button type="button" aria-pressed="false" data-cat={c}>{c}</button>)}
        </div>
        <div class="hw-line-in"><label for="need">I need at least <output data-out>£0</output></label><input id="need" type="range" min={LO} max={HI} step="1000" value={LO} data-need /></div>
      </div>
      <p class="hw-count" role="status" aria-live="polite" data-count></p>
    </section>

    <section class="hw-wrap" aria-label="Salary ranges, one bar per role" data-chart-root>
      <div class="hw-chart" data-chart style="--x:0">
        <div class="hw-axis" aria-hidden="true">{ticks.map((t) => <span style={`left:${pct(t * 1000)}%`}>£{t}k</span>)}</div>
        <div class="hw-layer" aria-hidden="true">{ticks.slice(0, -1).filter((_, i) => i % 2 === 0).map((t) => <i class="hw-band" style={`left:${pct(t * 1000)}%;width:${pct((t + 10) * 1000) - pct(t * 1000)}%`}></i>)}<i class="hw-yourline" data-line data-t="£10k"></i></div>
        <ol class="hw-rows" role="list" data-rows>
          {annual.map((j, i) => {
            const c = co(j.data.company).data;
            return (
              <li class="hw-row" data-id={j.id} data-cat={j.data.category} data-min={j.data.min} data-max={j.data.max} data-posted={j.data.posted} style={`order:${i}`}>
                <div class="hw-row__who">
                  <span class="hw-logo-tile" style={`background:${c.colour};width:2.6rem;height:2.6rem`} aria-hidden="true">{c.name[0]}</span>
                  <a href={`${B}/jobs/${j.id}/`}><span class="hw-row__t">{j.data.title}</span><br /><span class="hw-row__c">{c.name} · {j.data.location}</span></a>
                </div>
                <div class="hw-row__plot">
                  <div class="hw-bar" style={`left:${pct(j.data.min)}%;width:${pct(j.data.max) - pct(j.data.min)}%`}><span class="hw-bar__lo"></span><span class="hw-bar__hi"></span></div>
                  <span class="hw-lab hw-lab--min" style={`left:${pct(j.data.min)}%`}>{k(j.data.min)}</span>
                  <span class="hw-lab hw-lab--max" style={`left:${pct(j.data.max)}%`}>{k(j.data.max)}</span>
                </div>
                <span class="hw-row__star"><button type="button" class="hw-star" data-save={j.id} data-title={j.data.title} aria-pressed="false" aria-label={`Save ${j.data.title}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l2.7 5.8 6.3.7-4.7 4.3 1.3 6.2L12 17l-5.6 3 1.3-6.2L3 9.5l6.3-.7z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg></button></span>
              </li>
            );
          })}
        </ol>
      </div>
      <p class="mt-4" style="color:var(--muted)">Sorted by the top of each range. <button type="button" class="hw-btn hw-btn--sm" style="min-height:2.25rem;padding:0.3rem 0.8rem" data-sort="date" aria-pressed="false">Show newest first</button></p>

      {contract.map((j) => {
        const c = co(j.data.company).data;
        const a = Math.round(j.data.min * 250 / 1000), b = Math.round(j.data.max * 250 / 1000);
        return (
          <div class="hw-contract">
            <div class="hw-row__who" style="padding-right:0"><span class="hw-logo-tile" style={`background:${c.colour};width:2.6rem;height:2.6rem`} aria-hidden="true">{c.name[0]}</span><a href={`${B}/jobs/${j.id}/`}><span class="hw-row__t">{j.data.title}</span><br /><span class="hw-row__c">{c.name} · Paid by the day</span></a></div>
            <p><b class="hw-h3">£{j.data.min} to £{j.data.max} a day</b><small>About £{a}k to £{b}k a year if you were booked for 250 days. It is a contract, so it is not on the chart above.</small></p>
          </div>
        );
      })}
    </section>

    <section class="hw-section" aria-labelledby="prom-t"><div class="hw-wrap" data-rise>
      <div class="hw-head"><h2 id="prom-t" class="hw-h2">Three things we hold employers to.</h2></div>
      <ul class="hw-promise" role="list">{PROMISES.map(([t, d]) => <li><h3>{t}</h3><p>{d}</p></li>)}</ul>
    </div></section>

    <section class="hw-section hw-section--mint" aria-labelledby="co-t"><div class="hw-wrap" data-rise>
      <div class="hw-head"><h2 id="co-t" class="hw-h2">Who is hiring.</h2><a href={`${B}/companies/`} class="hw-btn">All companies</a></div>
      <ul class="hw-band-pics" role="list">{companies.map((c) => <li><a href={`${B}/companies/${c.id}/`} class="hw-co"><div class="hw-co__pic"><Image src={COMPANY_PHOTOS[c.id]} alt={COMPANY_ALTS[c.id]} width={720} /></div><h3>{c.data.name}</h3><p>{c.data.tagline}. {c.data.size}, {c.data.city}.</p></a></li>)}</ul>
    </div></section>

    <section class="hw-section"><div class="hw-wrap"><div class="hw-cta"><div><h2 class="hw-h2" style="max-width:18ch">Hiring? Show the pay.</h2><p class="mt-3 text-lg">Post a role with its salary range and reach people who read the number first. Plans from £99 a listing.</p></div><div class="flex flex-wrap gap-3 md:justify-end"><a href={`${B}/employers/#post`} class="hw-btn hw-btn--lg">Post a job</a><a href={`${B}/employers/`} class="hw-btn hw-btn--lg" style="background:rgb(255 255 255/.16);color:#fff">See pricing</a></div></div></div></section>
  </Shell>
</Site>

<script define:vars={{ CHART, LO, HI }}>
  window.__chart = JSON.parse(CHART); window.__lo = LO; window.__hi = HI;
</script>
<script>
  const jobs = (window as any).__chart as { id: string; min: number; max: number; cat: string; posted: string }[];
  const LO = (window as any).__lo as number, HI = (window as any).__hi as number;
  const root = document.querySelector<HTMLElement>('[data-chart]')!;
  const need = document.querySelector<HTMLInputElement>('[data-need]')!;
  const out = document.querySelector<HTMLElement>('[data-out]')!;
  const line = root.querySelector<HTMLElement>('[data-line]')!;
  const count = document.querySelector<HTMLElement>('[data-count]')!;
  const rows = [...root.querySelectorAll<HTMLElement>('[data-id]')];
  const gbp = (n: number) => '£' + n.toLocaleString('en-GB');
  let cat = 'all', sort = 'pay';

  function paint() {
    const x = Number(need.value);
    root.style.setProperty('--x', String(((x - LO) / (HI - LO)) * 100));
    line.dataset.t = '£' + Math.round(x / 1000) + 'k';
    out.textContent = gbp(x);
    let shown = 0, reach = 0;
    const tops: number[] = [];
    rows.forEach((r) => {
      const mn = Number(r.dataset.min), mx = Number(r.dataset.max);
      const inCat = cat === 'all' || r.dataset.cat === cat;
      r.hidden = !inCat;
      if (!inCat) return;
      shown++; tops.push(mx);
      const ok = mx >= x;
      if (ok) reach++;
      r.classList.toggle('is-out', !ok);
      const cut = Math.min(1, Math.max(0, (x - mn) / (mx - mn)));
      (r.querySelector('.hw-bar') as HTMLElement).style.setProperty('--cut', String(cut));
    });
    const sorted = [...rows].sort((a, b) => sort === 'pay' ? Number(b.dataset.max) - Number(a.dataset.max) : b.dataset.posted!.localeCompare(a.dataset.posted!));
    sorted.forEach((r, i) => (r.style.order = String(i)));
    tops.sort((a, b) => a - b);
    const med = tops.length ? (tops.length % 2 ? tops[(tops.length - 1) / 2] : (tops[tops.length / 2 - 1] + tops[tops.length / 2]) / 2) : 0;
    count.innerHTML = shown === 0 ? 'No roles in this category.' : x <= LO ? `<b>${shown} roles</b> shown. The middle one tops out at <b>${gbp(Math.round(med))}</b>. Drag the line to see who pays what you need.` : `<b>${reach} of ${shown} roles</b> reach ${gbp(x)} or more. The rest top out below it.`;
  }
  need.addEventListener('input', paint);
  document.querySelectorAll<HTMLButtonElement>('[data-cats] button').forEach((b) => b.addEventListener('click', () => { cat = b.dataset.cat!; document.querySelectorAll('[data-cats] button').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); paint(); }));
  const sortBtn = document.querySelector<HTMLButtonElement>('[data-sort]')!;
  sortBtn.addEventListener('click', () => { sort = sort === 'pay' ? 'date' : 'pay'; sortBtn.textContent = sort === 'pay' ? 'Show newest first' : 'Show highest pay first'; paint(); });
  paint();

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.classList.add('hw-js');
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -10% 0px' });
    document.querySelectorAll('[data-rise]').forEach((el) => io.observe(el));
  }
</script>
