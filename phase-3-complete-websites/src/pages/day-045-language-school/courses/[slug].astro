---
/** Day 045 · Lingua Lane · one page per language, generated from the "courses" collection. */
import { getCollection, render } from 'astro:content';
import Site from '../../../layouts/Site.astro';
import { Image } from 'astro:assets';
import { TEACHER_PHOTOS, COURSE_PHOTOS, COURSE_ALTS } from '../../../days/day-045/photos';
import Shell from '../../../components/day-045/Shell.astro';
import { LEVELS } from '../../../days/day-045/syllabus';

export async function getStaticPaths() {
  const all = await getCollection('courses');
  const teachers = await getCollection('teachers');
  return all.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, teacher: teachers.find((t) => t.id === entry.data.teacher)!, next: all[(i + 1) % all.length] } }));
}
const B = '/day-045-language-school';
const { entry, teacher, next } = Astro.props;
const c = entry.data;
const { Content } = await render(entry);
---
<Site title={`${c.language} classes · Lingua Lane`} description={c.intro} themeColor={c.colour} icon="L" day={45}>
  <Shell active="courses">
    <header class="ll-pagehead" style={`background:${c.colour};color:${c.ink}`}>
      <div class="ll-wrap"><ol class="ll-crumbs" aria-label="Breadcrumb" style="color:inherit"><li><a href={`${B}/`}>Home</a></li><li><a href={`${B}/courses/`}>Courses</a></li><li aria-current="page">{c.language}</li></ol>
        <p class="ll-h1" aria-hidden="true">{c.greeting}</p><h1 class="ll-h2 mt-3" style="max-width:22ch">{c.language} classes in London and online</h1><p class="mt-4 max-w-xl text-lg font-semibold">{c.tagline}. {c.speakers}.</p></div>
    </header>

    <section class="ll-section"><div class="ll-wrap ll-split ll-split--wide">
      <div>
        <figure class="ll-coursephoto"><Image src={COURSE_PHOTOS[entry.id]} alt={COURSE_ALTS[entry.id]} width={900} loading="eager" /></figure>
        <p class="ll-lede" style="color:var(--ink)">{c.intro}</p>
        <ul class="ll-ticks mt-5">{c.highlights.map((h) => <li>{h}</li>)}</ul>
        <div class="ll-prose mt-6"><Content /></div>
      </div>
      <aside class="ll-box" aria-labelledby="meet-t">
        <h2 id="meet-t" class="ll-h3">Your teacher</h2>
        <div class="mt-4 flex items-center gap-4"><Image src={TEACHER_PHOTOS[teacher.id]} alt={`Portrait of ${teacher.data.name}`} width={160} height={160} class="ll-avatar ll-avatar--photo ll-avatar--lg" /><div><b>{teacher.data.name}</b><br /><span style="color:var(--muted)">From {teacher.data.from} · {teacher.data.years} years teaching</span></div></div>
        <p class="mt-4 font-semibold" style="color:var(--muted)">“{teacher.data.quote}”</p>
        <h2 class="ll-h3 mt-6">Class times</h2><ul class="ll-sched mt-3" role="list">{c.schedule.map((s) => <li>{s}</li>)}</ul>
      </aside>
    </div></section>

    <section class="ll-section ll-section--cream" aria-labelledby="lv-t"><div class="ll-wrap" data-syl>
      <div class="ll-head"><div><p class="ll-eyebrow">Syllabus</p><h2 id="lv-t" class="ll-h2 mt-3">From first words to real fluency.</h2></div><p class="ll-lede">Four levels, ten weeks each. Pick a step to see what you will be able to do, week by week.</p></div>
      <div class="ll-syl__steps" role="tablist" aria-label={`${c.language} levels`}>{LEVELS.map((l, i) => <button type="button" role="tab" id={`lv-${l.code}`} aria-controls={`lp-${l.code}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="ll-syl__step" style={`--c:${c.colour};--k:${c.ink}`}><span class="ll-syl__code">{l.code}</span><span class="ll-syl__name">{l.name}</span></button>)}</div>
      {LEVELS.map((l, i) => <div class="ll-syl__panel" role="tabpanel" id={`lp-${l.code}`} aria-labelledby={`lv-${l.code}`} tabindex="0" hidden={i > 0}>
        <div class="ll-syl__top"><div><h3 class="ll-h3">{l.code} · {l.name}</h3><p class="mt-2">{l.blurb.replace('{L}', c.language)}</p></div><a href={`${B}/enrol/?course=${entry.id}&level=${l.code}`} class="ll-btn ll-btn--coral">Enrol at {l.code} · £189</a></div>
        <ol class="ll-syl__weeks" role="list">{l.weeks.map((w, k) => <li><span>Week {k + 1}</span>{w.replace('{L}', c.language)}</li>)}</ol>
      </div>)}
      <div class="mt-8 flex flex-wrap gap-3"><a href={`${B}/level-test/`} class="ll-btn ll-btn--coral">Not sure of your level?</a><a href={`${B}/trial/?course=${entry.id}`} class="ll-btn">Book a free trial lesson</a><a href={`${B}/courses/${next.id}/`} class="ll-btn">Next: {next.data.language} →</a></div>
    </div></section>
  </Shell>
</Site>
<script>
  const root = document.querySelector<HTMLElement>('[data-syl]')!;
  const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
  const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls')!)!);
  function show(i: number, focus = false) {
    tabs.forEach((t, j) => { t.setAttribute('aria-selected', String(i === j)); t.tabIndex = i === j ? 0 : -1; t.classList.toggle('is-done', j < i); panels[j].hidden = i !== j; });
    root.style.setProperty('--p', String(i / (tabs.length - 1)));
    if (focus) tabs[i].focus();
  }
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => show(i));
    t.addEventListener('keydown', (e) => {
      const k = (e as KeyboardEvent).key;
      if (k === 'ArrowRight') { e.preventDefault(); show(Math.min(i + 1, tabs.length - 1), true); }
      if (k === 'ArrowLeft') { e.preventDefault(); show(Math.max(i - 1, 0), true); }
      if (k === 'Home') { e.preventDefault(); show(0, true); }
      if (k === 'End') { e.preventDefault(); show(tabs.length - 1, true); }
    });
  });
  const want = new URLSearchParams(location.search).get('level');
  const start = tabs.findIndex((t) => t.id === 'lv-' + want);
  show(start < 0 ? 0 : start);
</script>
