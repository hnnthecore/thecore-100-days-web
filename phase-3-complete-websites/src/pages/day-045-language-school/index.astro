---
/** Day 045 · Lingua Lane · home. Built from days/day-045/DESIGN.md: a lane of eight doors, and the arched door is the one shape. */
import { getCollection } from 'astro:content';
import Site from '../../layouts/Site.astro';
import { Image } from 'astro:assets';
import Shell from '../../components/day-045/Shell.astro';
import { TEACHER_PHOTOS, COURSE_PHOTOS, COURSE_ALTS } from '../../days/day-045/photos';
import { LANG_CODE } from '../../days/day-045/syllabus';
import gowerMews from '../../assets/day-045/gower-mews.jpg';

const B = '/day-045-language-school';
const ORDER = ['spanish', 'french', 'german', 'italian', 'portuguese', 'japanese', 'mandarin', 'arabic'];
const courses = (await getCollection('courses')).sort((a, b) => ORDER.indexOf(a.id) - ORDER.indexOf(b.id));
const teachers = await getCollection('teachers');
const teacherOf = (id: string) => teachers.find((t) => t.id === id)!;
const STAGES = [
  ['Find your level', 'Take the free five-minute test. It places you at A1, A2, B1 or B2, so you never sit in a class that is too easy or too hard.', 'Take the level test', `${B}/level-test/`, '#1b1030', '#ffffff'],
  ['Try a lesson', 'Join a real class for thirty minutes, free. Meet your teacher, hear the pace and decide with no obligation.', 'Book a free lesson', `${B}/trial/`, '#0c6f6f', '#ffffff'],
  ['Ten weeks', 'One level per course, A1 to B2, with a plan for every week. Evenings, lunchtimes and weekends, in the studio or online.', 'See the courses', `${B}/courses/`, '#ff5a3c', '#1b1030'],
  ['Keep going', 'Move up a level, join the next course or book private lessons. Your teacher tells you what comes next.', 'Enrol', `${B}/enrol/`, '#ffb703', '#1b1030'],
] as const;
const FAQ = [
  ['Experience', 'Do I need any experience?', 'No. Our A1 courses start from zero. If you have studied before, take the free level test and we will place you in the right group.'],
  ['Format', 'Are classes online or in person?', 'Both. Every course runs in our London studio and live online, and you can switch between them week to week.'],
  ['Missed lessons', 'What if I miss a lesson?', 'Every lesson is recorded for you to catch up, and your teacher will send a short summary of what you missed.'],
  ['Trial', 'Can I try before I commit?', 'Yes. Your first lesson is free: if you do not love it, we refund the course in full.'],
  ['Exams', 'Do you prepare for exams?', 'Yes, we prepare students for DELE, DELF, Goethe, JLPT, HSK and more, as part of the course.'],
] as const;
const CARD = [['#ffb703', '#1b1030'], ['#ff5a3c', '#1b1030'], ['#e4e0f2', '#1b1030']] as const;
---
<Site title="Lingua Lane · Language school on Gower Mews, London" description="A small language school on Gower Mews in Bloomsbury. Eight languages, ten-week courses from A1 to B2, a free level test and a free first lesson." themeColor="#ff5a3c" icon="L" day={45}>
  <Shell>
    <section class="dr-hero" aria-labelledby="h1">
      <div class="dr-hero__text">
        <h1 id="h1" class="dr-h1"><span>Eight doors,</span><span>one lane.</span></h1>
        <p class="dr-hero__lede">A small language school on Gower Mews in Bloomsbury. Pick a door, try a free lesson, start speaking.</p>
        <div class="dr-hero__act"><a href={`${B}/trial/`} class="dr-btn dr-btn--coral">Try a free lesson</a><a href="#doors" class="dr-link">See the eight doors</a></div>
      </div>
      <div class="dr-door"><span class="dr-door__plate" aria-hidden="true">14</span><figure class="dr-door__window"><Image src={gowerMews} alt="Gower Mews in Bloomsbury: a narrow brick lane with yellow lines, seen from its entrance" width={900} loading="eager" /></figure><span class="dr-door__knob" aria-hidden="true"></span></div>
    </section>

    <section class="dr-statement" aria-label="What we do"><div class="dr-wrap">
      <p data-rise>You start <span class="dr-thumb"><Image src={COURSE_PHOTOS.spanish} alt="" width={120} /></span> speaking in the first minute. Eight <span class="dr-thumb"><Image src={COURSE_PHOTOS.japanese} alt="" width={120} /></span> languages, small groups, ten <span class="dr-thumb"><Image src={COURSE_PHOTOS.arabic} alt="" width={120} /></span> weeks at a time.</p>
    </div></section>

    <section id="doors" class="dr-doors" aria-labelledby="doors-t"><div class="dr-wrap dr-doors__grid" data-doors>
      <figure class="dr-plate" data-plate>{courses.map((c, i) => <div class:list={['dr-plate__img', i === 0 && 'is-on']} data-img={c.id}><Image src={COURSE_PHOTOS[c.id]} alt={COURSE_ALTS[c.id]} width={900} loading={i === 0 ? 'eager' : 'lazy'} /></div>)}</figure>
      <div>
        <h2 id="doors-t" class="dr-h2" data-rise>Pick a door</h2>
        <div class="dr-tabs" role="tablist" aria-label="Languages">{courses.map((c, i) => <button type="button" role="tab" class="dr-tab" id={`dt-${c.id}`} aria-controls={`dp-${c.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} style={`--c:${c.data.colour}`}>{c.data.language}</button>)}</div>
        {courses.map((c, i) => {
          const t = teacherOf(c.data.teacher);
          return (
            <div role="tabpanel" id={`dp-${c.id}`} aria-labelledby={`dt-${c.id}`} class:list={['dr-panel', i === 0 && 'is-on']} tabindex="0">
              <p class="dr-panel__hi" lang={LANG_CODE[c.id]}>{c.data.greeting}</p>
              <p class="dr-panel__what">{c.data.language} ({c.data.native}). {c.data.tagline}.</p>
              <div class="dr-panel__teacher"><Image src={TEACHER_PHOTOS[t.id]} alt={`Portrait of ${t.data.name}`} width={120} height={140} /><p><b>{t.data.name}</b><br /><span style="color:var(--muted)">From {t.data.from}, {t.data.years} years teaching</span></p></div>
              <dl class="dr-panel__meta"><dt>Class times</dt><dd>{c.data.schedule.join(' · ')}</dd></dl>
              <div class="dr-panel__act"><a href={`${B}/courses/${c.id}/`} class="dr-btn dr-btn--coral">See {c.data.language}</a><a href={`${B}/trial/?course=${c.id}`} class="dr-link">Book a free lesson</a></div>
            </div>
          );
        })}
      </div>
    </div></section>

    <section class="dr-run" aria-labelledby="run-t"><div class="dr-wrap">
      <div class="dr-run__intro"><h2 id="run-t" class="dr-h2" data-rise>How a course runs</h2><p data-rise style="--d:1">From your first question to your first conversation, in four steps. Open one to read it.</p></div>
      <ul class="dr-stages" data-stages role="list">{STAGES.map(([name, text, cta, href, bg, fg], i) => (
        <li class:list={['dr-stage', i === 0 && 'is-on']} style={`--bg:${bg};--fg:${fg}`}>
          <button type="button" class="dr-stage__btn" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`st-${i}`}>{name}</button>
          <div class="dr-stage__body" id={`st-${i}`}><p>{text}</p><a href={href} class="dr-link">{cta}</a></div>
        </li>
      ))}</ul>
    </div></section>

    <section class="dr-teachers" aria-labelledby="tt-t"><div class="dr-wrap">
      <div class="dr-teachers__head"><h2 id="tt-t" class="dr-h2" data-rise>Your teachers</h2><p class="dr-teachers__count">{teachers.length} teachers</p></div>
      <ul class="dr-tlist" role="list">{teachers.map((t, i) => (
        <li class="dr-t" data-rise style={`--d:${i % 4}`}><Image src={TEACHER_PHOTOS[t.id]} alt={`Portrait of ${t.data.name}`} width={160} height={192} /><div><b>{t.data.name}</b><span>From {t.data.from}. {t.data.languages.join(' and ')}.</span></div><em>{t.data.years} years</em></li>
      ))}</ul>
      <p class="mt-8"><a href={`${B}/teachers/`} class="dr-link">Meet everyone</a></p>
    </div></section>

    <section id="faq" class="dr-faq" aria-labelledby="faq-t"><div class="dr-faq__in">
      <h2 id="faq-t" class="dr-h2" data-rise>Questions</h2>
      <ul class="dr-cards" data-cards role="list">{FAQ.map(([topic, q, a], i) => (
        <li class:list={['dr-card', i === 0 && 'is-on']} style={`--bg:${CARD[i % CARD.length][0]};--fg:${CARD[i % CARD.length][1]};--i:${i}`}>
          <span class="dr-card__tab" aria-hidden="true">{topic}</span>
          <button type="button" class="dr-card__q" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`fq-${i}`}>{q}</button>
          <p class="dr-card__a" id={`fq-${i}`}>{a}</p>
        </li>
      ))}</ul>
    </div></section>

    <section class="dr-act" aria-labelledby="act-t">
      <div class="dr-act__row" data-rise-row>
        <div class="dr-act__tile dr-act__photo" style="--d:0"><Image src={COURSE_PHOTOS.portuguese} alt="" width={700} /></div>
        <div class="dr-act__tile dr-act__main" style="--d:1"><h2 id="act-t">Book a free lesson</h2><p>Thirty minutes in a real class with a real teacher. No card and no obligation.</p><div><a href={`${B}/trial/`} class="dr-btn dr-btn--ink">Choose your language</a></div><div class="dr-act__faces" aria-hidden="true">{teachers.slice(0, 3).map((t) => <Image src={TEACHER_PHOTOS[t.id]} alt="" width={240} height={300} />)}</div></div>
        <div class="dr-act__tile dr-act__flat" aria-hidden="true" style="--d:2"></div>
      </div>
    </section>
  </Shell>
</Site>
<script>
  import '../../days/day-045/home';
</script>
