---
/** Day 045 · Lingua Lane · enrol: choose course, level and format with a live price, then your details, then a confirmation. */
import { getCollection } from 'astro:content';
import Site from '../../layouts/Site.astro';
import Shell from '../../components/day-045/Shell.astro';

const B = '/day-045-language-school';
const courses = await getCollection('courses');
---
<Site title="Enrol · Lingua Lane" description="Enrol in a Lingua Lane course. Choose your language, level and format and see the price instantly. First lesson free if you do not love it." themeColor="#ff5a3c" icon="💬" day={45}>
  <Shell active="enrol">
    <header class="ll-pagehead"><div class="ll-wrap"><ol class="ll-crumbs" aria-label="Breadcrumb"><li><a href={`${B}/`}>Home</a></li><li aria-current="page">Enrol</li></ol><h1 class="ll-h1">Let's get <span class="ll-mark">you talking.</span></h1></div></header>
    <section class="ll-section !pt-10"><div class="ll-wrap ll-split ll-split--wide">
      <div class="ll-box" data-enrol>
        <ol class="ll-steps" aria-label="Progress" role="list"><li class="is-on" data-bar></li><li data-bar></li></ol>

        <form data-pane="1" novalidate>
          <h2 class="ll-h3">Build your course</h2>
          <div class="ll-fields mt-5">
            <div><label for="e-course" class="ll-label">Language</label><select id="e-course" class="ll-input" data-f="course">{courses.map((c) => <option value={c.id}>{c.data.language}</option>)}</select></div>
            <div><label for="e-level" class="ll-label">Level</label><select id="e-level" class="ll-input" data-f="level"><option value="A1">A1 · Beginner</option><option value="A2">A2 · Elementary</option><option value="B1">B1 · Intermediate</option><option value="B2">B2 · Upper-intermediate</option></select></div>
            <fieldset class="ll-set col-2"><legend>Format</legend><div class="ll-radios"><label><input type="radio" name="fmt" value="group" checked /><span>Small group<small>10 weeks · £189</small></span></label><label><input type="radio" name="fmt" value="private" /><span>Private lessons<small>10 lessons · £420</small></span></label></div></fieldset>
            <div><label for="e-start" class="ll-label">Start date</label><select id="e-start" class="ll-input" data-f="start"></select></div>
            <div><label for="e-promo" class="ll-label">Promo code (optional)</label><input id="e-promo" class="ll-input" autocomplete="off" placeholder="Try LINGUA10" data-f="promo" /><p class="ll-ok" id="e-promo-m" role="status"></p></div>
            <label class="col-2 flex items-start gap-3 font-semibold"><input type="checkbox" class="mt-1" data-f="pack" /><span>Add the course pack: workbook, audio and online practice (+£15)</span></label>
          </div>
          <button type="submit" class="ll-btn ll-btn--coral ll-btn--lg ll-btn--full mt-6">Continue →</button>
        </form>

        <form data-pane="2" hidden novalidate>
          <h2 class="ll-h3">Your details</h2>
          <div class="ll-fields mt-5">
            <div><label for="e-name" class="ll-label">Full name</label><input id="e-name" class="ll-input" autocomplete="name" data-req aria-describedby="e-name-e" /><p class="ll-err" id="e-name-e" hidden>Please add your name.</p></div>
            <div><label for="e-email" class="ll-label">Email</label><input id="e-email" type="email" class="ll-input" autocomplete="email" data-req aria-describedby="e-email-e" /><p class="ll-err" id="e-email-e" hidden>Enter an email like name@example.com.</p></div>
            <div class="col-2"><label for="e-goal" class="ll-label">Why are you learning? (optional)</label><textarea id="e-goal" class="ll-input" placeholder="A trip, work, family, curiosity..."></textarea></div>
            <label class="col-2 flex items-start gap-3 font-semibold"><input type="checkbox" class="mt-1" id="e-terms" aria-describedby="e-terms-e" /><span>I agree to the terms. My first lesson is free if I do not love it.</span></label>
            <p class="ll-err col-2" id="e-terms-e" hidden>Please tick to continue.</p>
          </div>
          <div class="mt-6 flex gap-3"><button type="button" class="ll-btn ll-btn--lg" data-back>← Back</button><button type="submit" class="ll-btn ll-btn--coral ll-btn--lg" style="flex:1">Confirm enrolment</button></div>
        </form>

        <div data-pane="3" hidden tabindex="-1" class="text-center">
          <span class="ll-result__lvl" style="width:6rem;height:6rem;font-size:2.6rem" aria-hidden="true">✓</span>
          <h2 class="ll-h2 mx-auto mt-5" style="max-width:16ch">Welcome to Lingua Lane, <span data-d-name></span>!</h2>
          <p class="ll-lede mx-auto mt-4" data-d-text></p>
          <a href={`${B}/courses/`} class="ll-btn mt-7">Explore other courses</a>
        </div>
      </div>

      <aside class="ll-summary" aria-labelledby="sum-t">
        <h2 id="sum-t" class="ll-h3">Your order</h2>
        <dl class="mt-5"><dt>Course</dt><dd data-s="course"></dd><dt>Format</dt><dd data-s="fmt"></dd><dt>Starts</dt><dd data-s="start"></dd></dl>
        <div class="ll-total"><span>Total</span><b data-s="total" aria-live="polite">£0</b></div>
        <p class="mt-3 text-sm" style="color:#c7bbe0" data-s="note"></p>
      </aside>
    </div></section>
  </Shell>
</Site>

<script>
  import '../../days/day-045/enrol';
</script>
