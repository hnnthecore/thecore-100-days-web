---
import Site from '../../../layouts/Site.astro';
import { Image } from 'astro:assets';
import Shell from '../../../components/day-054/Shell.astro';
import { RESOURCES } from '../../../days/day-054/content';
import heroImage from '../../../assets/day-045/whiteboard.jpg';
const B = '/day-054-education';
---
<Site title="Resources · Nexora Education" description="Practical guides, field notes and learning tools from Nexora Education." themeColor="#14213D" icon="N" day={54} origin="https://thecoretechnology.github.io/thecore-100-days-web/phase-3-complete-websites/site" showProjectBadge={false}>
  <Shell>
    <section class="e54-page-hero e54-page-hero--resources" aria-labelledby="resources-page-title"><div class="e54-wrap e54-page-hero__grid"><div><p class="e54-kicker">Open resources</p><h1 id="resources-page-title" class="e54-display">Practical ideas for learning <em>well.</em></h1><p class="e54-page-hero__lede">Short, useful materials for framing projects, giving feedback and creating a sustainable learning rhythm.</p></div><figure class="e54-page-hero__media"><Image src={heroImage} alt="A facilitator writing clear prompts on a whiteboard" width={1200} loading="eager" /></figure></div></section>

    <section class="e54-section e54-ivory" aria-labelledby="library-title"><div class="e54-wrap"><div class="e54-section-heading e54-section-heading--row" data-reveal><div><p class="e54-kicker">Resource library</p><h2 id="library-title" class="e54-title">Use one idea. Improve one <em>moment.</em></h2></div><p class="e54-heading-note">These concise resources are designed to support a conversation or working session, not replace a complete learning programme.</p></div><div class="e54-library">{RESOURCES.map((resource, index) => <article id={resource.id} class="e54-library-card" data-reveal><span>{String(index + 1).padStart(2, '0')}</span><div><p class="e54-resource__meta">{resource.type} · {resource.read}</p><h3>{resource.title}</h3><p>{resource.text}</p><a href={`${B}/contact/?topic=${encodeURIComponent(resource.title)}`}>Use this in a learning brief <span aria-hidden="true">↗</span></a></div></article>)}</div></div></section>

    <section class="e54-section e54-blue-panel" aria-labelledby="resource-approach-title"><div class="e54-wrap e54-editorial-split"><div data-reveal><p class="e54-kicker e54-kicker--light">A useful starting point</p><h2 id="resource-approach-title" class="e54-title e54-title--light">Resources support the work. Practice creates the learning.</h2></div><div class="e54-prose e54-prose--light" data-reveal><p class="e54-lede">A guide becomes valuable when learners can apply it to a decision, discuss what happened and decide what to change.</p><p>Explore the Nexora experience to see how resources, facilitation and project work fit together.</p><a class="e54-button" href={`${B}/experience/`}>See the learning experience <span aria-hidden="true">↗</span></a></div></div></section>
  </Shell>
</Site>

