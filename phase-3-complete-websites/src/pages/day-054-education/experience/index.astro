---
import Site from '../../../layouts/Site.astro';
import { Image } from 'astro:assets';
import Shell from '../../../components/day-054/Shell.astro';
import { PRINCIPLES } from '../../../days/day-054/content';
import heroImage from '../../../assets/day-045/about-cafe.jpg';
import studioImage from '../../../assets/day-045/whiteboard.jpg';
const B = '/day-054-education';
const JOURNEY = [
  ['01', 'Frame the question', 'Clarify the audience, the context and the useful change the learning should support.'],
  ['02', 'Explore with guidance', 'Use concise inputs, examples and prompts to build a shared foundation without overloading the learner.'],
  ['03', 'Make and discuss', 'Apply the ideas to a project, bring work in progress to the group and learn through different perspectives.'],
  ['04', 'Improve with feedback', 'Choose what to change, explain the reasoning and strengthen the work through another considered iteration.'],
  ['05', 'Reflect and continue', 'Capture what changed, where confidence grew and which next action will keep the learning useful.'],
];
---
<Site title="Learning Experience · Nexora Education" description="See how Nexora combines project-based learning, facilitation, mentorship, collaboration and reflection." themeColor="#14213D" icon="N" day={54} origin="https://thecoretechnology.github.io/thecore-100-days-web/phase-3-complete-websites/site" showProjectBadge={false}>
  <Shell>
    <section class="e54-page-hero e54-page-hero--experience" aria-labelledby="experience-page-title"><div class="e54-wrap e54-page-hero__grid"><div><p class="e54-kicker">The learning experience</p><h1 id="experience-page-title" class="e54-display">A rhythm that turns attention into <em>progress.</em></h1><p class="e54-page-hero__lede">Learners move between focused input, independent practice, live collaboration and deliberate reflection.</p></div><figure class="e54-page-hero__media"><Image src={heroImage} alt="Learners discussing work together with notebooks open" width={1200} loading="eager" /></figure></div></section>

    <section class="e54-section e54-white" aria-labelledby="journey-title"><div class="e54-wrap e54-journey-layout"><div class="e54-journey-intro" data-reveal><p class="e54-kicker">The journey</p><h2 id="journey-title" class="e54-title">Clear stages. Room for <em>judgement.</em></h2><p>The structure keeps momentum visible while leaving space for learners to make meaningful choices.</p></div><ol class="e54-journey">{JOURNEY.map(([number, title, text]) => <li data-reveal><span>{number}</span><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol></div></section>

    <section class="e54-section e54-navy" aria-labelledby="support-title"><div class="e54-wrap e54-image-split"><figure data-reveal><Image src={studioImage} alt="A facilitator using a whiteboard during a learning studio" width={1000} /></figure><div data-reveal><p class="e54-kicker e54-kicker--light">Guidance and mentorship</p><h2 id="support-title" class="e54-title e54-title--light">Support that strengthens independence.</h2><p>Facilitation is used to frame the work, surface useful questions and help learners interpret feedback. It does not replace the learner’s own decisions.</p><ul class="e54-check-list"><li>Focused prompts before live sessions</li><li>Structured peer and facilitator feedback</li><li>Visible milestones for work in progress</li><li>Reflection that leads to a next action</li></ul></div></div></section>

    <section class="e54-section e54-ivory" aria-labelledby="experience-principles"><div class="e54-wrap"><div class="e54-section-heading" data-reveal><p class="e54-kicker">What learners can expect</p><h2 id="experience-principles" class="e54-title">An active role in the <em>learning.</em></h2></div><div class="e54-value-grid">{PRINCIPLES.map((principle) => <article class="e54-value" data-reveal><span>{principle.number}</span><h3>{principle.title}</h3><p>{principle.text}</p></article>)}</div><div class="e54-section-action"><a class="e54-button e54-button--primary" href={`${B}/programmes/`}>Explore programmes <span aria-hidden="true">↗</span></a></div></div></section>
  </Shell>
</Site>

