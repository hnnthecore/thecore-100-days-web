---
/** Day 047 · Solstice Sound · full line-up from the "artists" collection: filter by day and genre, live search, ★ to add to your plan. */
import { getCollection } from 'astro:content';
import Site from '../../layouts/Site.astro';
import { Image } from 'astro:assets';
import Shell from '../../components/day-047/Shell.astro';
import { STAGE_COLOUR } from '../../days/day-047/art';
import { ACT_PHOTOS, ACT_ALTS } from '../../days/day-047/photos';

const B = '/day-047-music-festival';
const order = { Fri: 0, Sat: 1, Sun: 2 };
const artists = (await getCollection('artists')).sort((a, b) => order[a.data.day] - order[b.data.day] || a.data.start.localeCompare(b.data.start));
const DAYS = [['Fri', 'Friday 16 July'], ['Sat', 'Saturday 17 July'], ['Sun', 'Sunday 18 July']] as const;
const genres = [...new Set(artists.map((a) => a.data.genre))].sort();
---
<Site title="Line-up · Solstice Sound" description="Twelve acts across three stages and three days. Filter by day or genre and star your favourites to build a plan." themeColor="#140824" icon="🌅" day={47}>
  <Shell active="lineup">
    <header class="sf-pagehead"><div class="sf-wrap"><ol class="sf-crumbs" aria-label="Breadcrumb"><li><a href={`${B}/`}>Home</a></li><li aria-current="page">Line-up</li></ol><h1 class="sf-h1" style="font-size:clamp(2.4rem,7vw,5.6rem)">The <span class="sf-sun">line-up</span></h1><p class="sf-lede mt-5">Tap the star on any act to add it to your plan. Then head to the schedule to check for clashes.</p></div></header>
    <section class="sf-section !pt-10"><div class="sf-wrap">
      <div class="mb-8 grid gap-5">
        <div style="max-width:22rem"><label for="l-q" class="sf-label">Search acts</label><input id="l-q" type="search" class="sf-input" placeholder="Name or place" autocomplete="off" data-q /></div>
        <div class="flex flex-wrap gap-x-10 gap-y-5">
          <div><p class="sf-label" id="d-l">Day</p><div class="sf-chips" role="group" aria-labelledby="d-l" data-day><button type="button" data-v="all" aria-pressed="true">All</button><button type="button" data-v="Fri" aria-pressed="false">Friday</button><button type="button" data-v="Sat" aria-pressed="false">Saturday</button><button type="button" data-v="Sun" aria-pressed="false">Sunday</button></div></div>
          <div><p class="sf-label" id="g-l">Genre</p><div class="sf-chips" role="group" aria-labelledby="g-l" data-genre><button type="button" data-v="all" aria-pressed="true">All</button>{genres.map((g) => <button type="button" data-v={g} aria-pressed="false">{g}</button>)}</div></div>
        </div>
      </div>
      <p class="mb-5 font-bold" style="color:var(--muted)" role="status" data-count></p>
      <div class="sf-viewtoggle" role="group" aria-label="Choose a view" data-view><button type="button" data-mode="poster" aria-pressed="true">Poster</button><button type="button" data-mode="cards" aria-pressed="false">Cards</button></div>
      <div class="sf-lineup" data-mode="poster">
        <div class="sf-posterview">
          {DAYS.map(([d, label]) => (
            <section class="sf-poster" aria-label={label}>
              <p class="sf-poster__day">{label}</p>
              <ul class="sf-poster__names" role="list">{artists.filter((a) => a.data.day === d).map((a) => (
                <li data-act data-d={a.data.day} data-g={a.data.genre} data-text={`${a.data.name} ${a.data.origin} ${a.data.genre}`.toLowerCase()}>
                  <a href={`${B}/artists/${a.id}/`} class:list={['sf-poster__name', a.data.headliner && 'is-head']}>{a.data.name}</a>
                  <span class="sf-poster__peek" aria-hidden="true"><Image src={ACT_PHOTOS[a.id]} alt="" width={260} /><small>{a.data.genre} · {a.data.start}</small></span>
                </li>
              ))}</ul>
            </section>
          ))}
          <p class="sf-poster__note">Hover or focus a name to see the act. Switch to Cards to star acts for your plan.</p>
        </div>
        <ul class="sf-grid sf-grid--4 sf-gridview" role="list">{artists.map((a) => (
          <li class="relative" data-act data-d={a.data.day} data-g={a.data.genre} data-text={`${a.data.name} ${a.data.origin} ${a.data.genre}`.toLowerCase()}>
            <button type="button" class="sf-star" data-star={a.id} data-name={a.data.name} aria-pressed="false" aria-label={`Add ${a.data.name} to my plan`}>★</button>
            <a href={`${B}/artists/${a.id}/`} class="sf-act">
              {a.data.headliner && <span class="sf-badge">Headliner</span>}
              <div class="sf-act__art"><Image src={ACT_PHOTOS[a.id]} alt={ACT_ALTS[a.id]} width={480} /></div>
              <div class="sf-act__body"><h2>{a.data.name}</h2><p class="sf-act__meta">{a.data.genre} · {a.data.origin}</p><p class="sf-act__meta"><span class="sf-stage" style={`--c:${STAGE_COLOUR[a.data.stage]}`}>{a.data.stage}</span> · {a.data.day} {a.data.start}</p></div>
            </a>
          </li>
        ))}</ul>
      </div>
      <p class="sf-lede mt-8" hidden data-empty>No acts match. Try clearing a filter.</p>
    </div></section>
  </Shell>
</Site>

<script>
  import '../../days/day-047/stars';
  const items = [...document.querySelectorAll<HTMLElement>('[data-act]')];
  const q = document.querySelector<HTMLInputElement>('[data-q]')!;
  const sel = { day: 'all', genre: 'all' };
  function paint() {
    const term = q.value.trim().toLowerCase();
    let n = 0;
    items.forEach((li) => {
      const ok = (sel.day === 'all' || li.dataset.d === sel.day) && (sel.genre === 'all' || li.dataset.g === sel.genre) && (!term || li.dataset.text!.includes(term));
      li.hidden = !ok; if (ok && li.closest('.sf-gridview')) n++;
    });
    document.querySelector('[data-count]')!.textContent = `${n} act${n === 1 ? '' : 's'}`;
    document.querySelector<HTMLElement>('[data-empty]')!.hidden = n > 0;
  }
  (['day', 'genre'] as const).forEach((k) => document.querySelector(`[data-${k}]`)!.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
    if (!b) return;
    sel[k] = b.dataset.v!;
    b.parentElement!.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    paint();
  }));
  q.addEventListener('input', paint);
  document.querySelector('[data-view]')!.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
    if (!b) return;
    document.querySelector<HTMLElement>('.sf-lineup')!.dataset.mode = b.dataset.mode!;
    b.parentElement!.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
  });
  paint();
</script>
