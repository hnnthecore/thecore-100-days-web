---
/** Day 044 · Fathom · product overview: the six features from the "features" collection and how setup works. */
import { getCollection } from 'astro:content';
import Site from '../../../layouts/Site.astro';
import Shell from '../../../components/day-044/Shell.astro';
import { icon } from '../../../days/day-044/chart';
import { PLAN_LIST, MATRIX } from '../../../days/day-044/plans';

const B = '/day-044-saas-product';
const features = (await getCollection('features')).sort((a, b) => a.data.order - b.data.order);
const STEPS = [['Connect', 'Link your bank and accounting software with secure, read-only access. It takes about two minutes.'], ['Forecast', 'Fathom builds a 13-week forecast from your real invoices, bills and payment habits.'], ['Act', 'Get a short list of what to do this week: who to chase, what to delay, where you are exposed.']];
---
<Site title="Product · Fathom" description="Rolling forecasts, scenarios, invoice chasing, smart alerts, investor-ready reports and accountant access. Everything Fathom does for your cash." themeColor="#3d5afe" icon="📈" day={44}>
  <Shell active="features">
    <header class="fa-pagehead"><div class="fa-wrap"><ol class="fa-crumbs" aria-label="Breadcrumb"><li><a href={`${B}/`}>Home</a></li><li aria-current="page">Product</li></ol><h1 class="fa-h1">One calm place for <span class="fa-grad">all your cash.</span></h1><p class="fa-lede mt-5">Six tools that work together, built for owners who are brilliant at their business and would rather not be spreadsheet experts.</p></div></header>
    <section class="fa-section" aria-labelledby="mx-t"><div class="fa-wrap">
      <div class="fa-head"><div><p class="fa-eyebrow">Compare</p><h2 id="mx-t" class="fa-h2 mt-3">What every plan does, side by side.</h2></div>
        <div class="fa-toggle" role="group" aria-label="Highlight a plan" data-hl>{PLAN_LIST.map((p) => <button type="button" data-col={p.id} aria-pressed="false">{p.name}</button>)}</div></div>
      <div class="fa-tablewrap fa-mx" tabindex="0" role="region" aria-label="Feature comparison, scrolls sideways on small screens">
        <table class="fa-table fa-matrix" data-matrix>
          <thead><tr><th scope="col">Feature</th><th scope="col" class="fa-mx__sheet">A spreadsheet</th>{PLAN_LIST.map((p) => <th scope="col" data-col={p.id}>{p.name}<small>£{p.price} / month</small></th>)}</tr></thead>
          <tbody>{features.map((f) => (
            <tr><th scope="row"><a href={`${B}/features/${f.id}/`} class="fa-mx__name"><span class="fa-ico" set:html={icon(f.data.icon, 18)}></span><span><b>{f.data.title}</b><small>{f.data.tagline}</small></span></a></th>
              <td class="fa-mx__sheet">{MATRIX[f.id].sheet}</td>
              {MATRIX[f.id].plans.map((v, i) => <td data-col={PLAN_LIST[i].id}>{v === false ? <span class="fa-no" aria-label="Not included">—</span> : <><span class="fa-yes" aria-hidden="true">✓</span> {v}</>}</td>)}
            </tr>))}
          </tbody>
        </table>
      </div>
      <p class="mt-5 text-sm" style="color:var(--muted)">Prices shown are monthly; annual billing saves 20%. Not sure which fits? <a href={`${B}/fit/`} class="fa-link">Take the one-minute plan quiz →</a></p>
    </div></section>
    <section class="fa-section fa-section--tint" aria-labelledby="how-t"><div class="fa-wrap">
      <div class="fa-head"><div><p class="fa-eyebrow">How it works</p><h2 id="how-t" class="fa-h2 mt-3">From sign-up to first forecast in ten minutes.</h2></div></div>
      <ol class="fa-grid fa-grid--3" role="list">{STEPS.map(([t, d], i) => <li class="fa-card"><span class="fa-num fa-grad text-5xl font-bold">0{i + 1}</span><h3 class="fa-h3 mt-3">{t}</h3><p class="mt-2">{d}</p></li>)}</ol>
      <div class="mt-10 flex flex-wrap gap-3"><a href={`${B}/pricing/`} class="fa-btn fa-btn--blue fa-btn--lg">Start free</a><a href={`${B}/demo/`} class="fa-btn fa-btn--line fa-btn--lg">Book a demo</a></div>
    </div></section>
  </Shell>
</Site>
<script>
  const hl = document.querySelector('[data-hl]')!;
  const tbl = document.querySelector<HTMLElement>('[data-matrix]')!;
  const btns = [...hl.querySelectorAll<HTMLButtonElement>('button')];
  btns.forEach((b) => b.addEventListener('click', () => {
    const on = b.getAttribute('aria-pressed') === 'true';
    btns.forEach((x) => x.setAttribute('aria-pressed', 'false'));
    if (on) { delete tbl.dataset.hl; return; }
    b.setAttribute('aria-pressed', 'true'); tbl.dataset.hl = b.dataset.col!;
  }));
</script>
