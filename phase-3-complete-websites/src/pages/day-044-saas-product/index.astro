---
/** Day 044 · Fathom · home. Built from days/day-044/DESIGN.md: the forecast itself is the first screen, and the visitor bends it. */
import { getCollection } from 'astro:content';
import Site from '../../layouts/Site.astro';
import { Image } from 'astro:assets';
import { BIZ_PHOTOS, PERSON_PHOTOS, PHOTO_ALTS, PERSON_ALTS } from '../../days/day-044/photos';
import Shell from '../../components/day-044/Shell.astro';
import { demoPoints } from '../../days/day-044/chart';
import { model, verdict, heroChart, storyChart, FLOOR } from '../../days/day-044/forecast';
import { gbp } from '../../days/day-044/chart';

const B = '/day-044-saas-product';
const features = (await getCollection('features')).sort((a, b) => a.data.order - b.data.order);
const customers = await getCollection('customers');
const base = model(0, 0, 0);
const pts = model(0, 4500, 14);
const v = verdict(pts);
const low = Math.min(...pts);
const EVENTS = [
  [1, 'Today', `You have ${gbp(pts[0])} after the first week. Fathom has just read last night’s bank feed.`],
  [3, 'Invoice #1042 is 9 days late', 'A polite reminder to Harbourline is drafted and waiting for your yes.'],
  [4, 'Payroll of £18,000 leaves on the 28th', 'Covered. Nothing to do.'],
  [8, 'The new hire starts', 'Your weekly cost rises by £1,038. Fathom shows the effect now, not in March.'],
  [12, `Lowest point: ${gbp(low)}`, 'Below your £25,000 floor. You can see it in week 1, not in week 12.'],
] as const;
/* A line drawn as a small sparkline for the product screens below. */
const spark = (arr: number[], w: number, h: number, col: string) => {
  const lo = Math.min(...arr), hi = Math.max(...arr), pad = 6;
  const pts2 = arr.map((v, i) => [pad + (i / (arr.length - 1)) * (w - pad * 2), pad + (1 - (v - lo) / (hi - lo || 1)) * (h - pad * 2)]);
  return `<svg viewBox="0 0 ${w} ${h}" width="100%" height="${h}" preserveAspectRatio="none" aria-hidden="true"><path d="${pts2.map((q, i) => (i ? 'L' : 'M') + q[0].toFixed(1) + ' ' + q[1].toFixed(1)).join('')}" fill="none" stroke="${col}" stroke-width="3" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke"/></svg>`;
};
const dp = demoPoints(1), dp2 = demoPoints(3);
const SCREENS: Record<string, string> = {
  forecast: `<div class="ui__kpis"><div><b>${gbp(dp[0])}</b><span>Cash today</span></div><div><b>11.4 months</b><span>Runway</span></div><div><b>${gbp(Math.min(...dp))}</b><span>Lowest, week ${dp.indexOf(Math.min(...dp)) + 1}</span></div></div>${spark(dp, 520, 120, '#0d6b4a')}<p class="ui__note">Updated 7:02 this morning from 3 bank accounts and 41 open invoices.</p>`,
  scenarios: `<div class="ui__cmp"><div><p class="ui__tag">Current plan</p>${spark(dp, 240, 70, '#4d5a54')}<b>${gbp(Math.min(...dp))}</b><span>lowest balance</span></div><div class="is-pick"><p class="ui__tag">Hire in April</p>${spark(dp2, 240, 70, '#0d6b4a')}<b>${gbp(Math.min(...dp2) - 9200)}</b><span>lowest balance</span></div></div><p class="ui__note">Shared with Priya, your accountant. She can comment on week 11.</p>`,
  invoices: `<table class="ui__tbl"><tbody><tr><td>#1042 Harbourline</td><td>£4,800</td><td class="is-late">9 days late</td></tr><tr><td>#1038 Northbound</td><td>£1,250</td><td class="is-late">3 days late</td></tr><tr><td>#1041 Lattice Studio</td><td>£2,900</td><td>Due Friday</td></tr></tbody></table><div class="ui__mail"><p>Hi Imogen, a quick nudge on invoice #1042 for £4,800. It was due on the 12th. Could you let me know when to expect it?</p><span class="ui__btn">Send reminder</span></div>`,
  alerts: `<div class="ui__slack"><b>Fathom</b><time>7:04</time><p>Week 8 dips to <strong>${gbp(Math.min(...pts))}</strong>, below your £25,000 safety floor. It only happens if the new hire starts in March.</p><span class="ui__btn">Open the forecast</span></div><p class="ui__note">Sent to #finance in Slack and to two people by email.</p>`,
  reports: `<table class="ui__tbl"><tbody><tr><td>Runway</td><td>11.4 months</td></tr><tr><td>Weekly burn</td><td>£19,000</td></tr><tr><td>Cash conversion</td><td>41 days</td></tr><tr><td>Largest customer</td><td>23% of revenue</td></tr></tbody></table><p class="ui__note">Exported as a board pack in one click, as PDF or a shared link.</p>`,
  teams: `<ul class="ui__team"><li><i>I</i><b>Imogen Tate</b><span>Owner</span></li><li><i>M</i><b>Mo Haddad</b><span>Bookkeeper, can edit</span></li><li><i>P</i><b>Priya Shah</b><span>Accountant, can comment</span></li></ul><p class="ui__note">Everyone sees the same numbers, so there is one forecast, not three spreadsheets.</p>`,
};
---
<Site title="Fathom · Cash-flow forecasting for small businesses" description="Fathom forecasts your cash 13 weeks ahead, chases late invoices and warns you before trouble arrives. Move three sliders and watch your cash respond. Free for 14 days." themeColor="#0c110f" icon="F" day={44}>
  <Shell home>
    <section class="fh" data-whatif aria-labelledby="h1">
      <div class="fh__top">
        <h1 id="h1" class="fh__h1">Know your cash 13 weeks before it happens.</h1>
        <div class="fh__say">
          <p class:list={['fh__verdict', v.bad && 'is-bad']} data-verdict role="status" aria-live="polite">{v.text}</p>
          <dl class="fh__read" aria-live="polite">
            <div data-low class:list={[v.bad && 'is-bad']}><dt>Lowest balance</dt><dd data-o="low">{gbp(low)}</dd></div>
            <div><dt>In week</dt><dd data-o="week">{pts.indexOf(low) + 1}</dd></div>
            <div><dt>After 13 weeks</dt><dd data-o="end">{gbp(pts[12])}</dd></div>
          </dl>
        </div>
      </div>
      <div class="fh__chart" data-chart set:html={heroChart(pts, base, 1360, 360)}></div>
      <div class="fh__ctl">
        <div class="fh__c"><label for="w-g">Sales change</label><output for="w-g" data-out="g">0%</output><input id="w-g" type="range" min="-30" max="30" step="1" value="0" data-in="g" /></div>
        <div class="fh__c"><label for="w-h">New hire per month</label><output for="w-h" data-out="h">£4,500</output><input id="w-h" type="range" min="0" max="9000" step="250" value="4500" data-in="h" /></div>
        <div class="fh__c"><label for="w-l">Customers pay late by</label><output for="w-l" data-out="l">14 days</output><input id="w-l" type="range" min="0" max="45" step="1" value="14" data-in="l" /></div>
        <div class="fh__act"><a href={`${B}/pricing/`} class="fa-btn fa-btn--mint fa-btn--lg">Start free for 14 days</a><button type="button" class="fh__reset" data-reset>Reset to the current plan</button></div>
      </div>
    </section>

    <section class="fw" data-story aria-labelledby="fw-t">
      <div class="fw__stick">
        <div class="fw__head"><h2 id="fw-t" class="fw__h">Thirteen weeks, one scroll.</h2><p class="fw__wk" aria-hidden="true">Week <b data-wk>1</b></p></div>
        <div class="fw__body">
          <div class="fw__chart" data-story-chart set:html={storyChart(pts, 1000, 380)}></div>
          <ol class="fw__ev" role="list" data-events>{EVENTS.map(([w, t, d]) => (
            <li data-w={w}><b>Week {w}. {t}</b><span>{d}</span></li>
          ))}</ol>
        </div>
      </div>
    </section>

    <section class="fp" aria-labelledby="fp-t"><div class="fa-wrap"><h2 id="fp-t" class="fp__h">What Fathom does</h2><div class="fp__grid">
      <div class="fp__side">
        <ul class="fp__nav" role="list" data-nav>{features.map((f, i) => <li><a href={`#fp-${f.id}`} class:list={[i === 0 && 'is-on']}>{f.data.title}</a></li>)}</ul>
      </div>
      <div class="fp__screens">{features.map((f) => (
        <article class="fp__s" id={`fp-${f.id}`} data-s>
          <h3>{f.data.tagline}</h3>
          <p>{f.data.lede}</p>
          <div class="ui" data-ui set:html={SCREENS[f.id]}></div>
          <a class="fp__go" href={`${B}/features/${f.id}/`}>See {f.data.title}<span class="sr-only"> in detail</span></a>
        </article>
      ))}</div>
    </div></div></section>

    <section class="fn" aria-label="Fathom in numbers"><div class="fa-wrap">
      <ul class="fn__list" role="list">
        <li class="fa-reveal"><b data-count="9" data-suffix=" days">9 days</b><span>faster payment on average</span></li>
        <li class="fa-reveal" style="--d:1"><b data-count="94" data-suffix="%">94%</b><span>forecast accuracy at 4 weeks</span></li>
        <li class="fa-reveal" style="--d:2"><b data-count="10" data-suffix=" min">10 min</b><span>to set up and connect</span></li>
        <li class="fa-reveal" style="--d:3"><b data-count="4200" data-suffix="">4,200</b><span>businesses use Fathom</span></li>
      </ul>
    </div></section>

    <section class="fc" aria-labelledby="cu-t"><div class="fa-wrap">
      <h2 id="cu-t" class="fp__h fa-reveal">Owners sleep better.</h2>
      <div class="fc__tabs" data-tabs>
        <div class="fc__list" role="tablist" aria-label="Customer stories">
          {customers.map((c, i) => <button type="button" role="tab" id={`tab-${c.id}`} aria-controls={`panel-${c.id}`} aria-selected={String(i === 0)} tabindex={i === 0 ? 0 : -1}>{c.data.name}</button>)}
        </div>
        {customers.map((c, i) => (
          <div class="fc__panel" role="tabpanel" id={`panel-${c.id}`} aria-labelledby={`tab-${c.id}`} hidden={i !== 0} tabindex="0">
            <figure class="fc__pic"><Image src={BIZ_PHOTOS[c.id]} alt={PHOTO_ALTS[c.id]} width={900} /></figure>
            <div class="fc__say">
              <p class="fc__quote">“{c.data.quote}”</p>
              <ul class="fc__stats" role="list">{c.data.stats.map((s) => <li><b>{s.value}</b><span>{s.label}</span></li>)}</ul>
              <p class="fc__who"><Image src={PERSON_PHOTOS[c.id]} alt={PERSON_ALTS[c.id]} width={96} height={96} class="fa-face" /><span><b>{c.data.person}</b><span>{c.data.role}, {c.data.name}</span></span></p>
              <a href={`${B}/customers/${c.id}/`} class="fa-btn fa-btn--ink">Read the full story</a>
            </div>
          </div>
        ))}
      </div>
    </div></section>

    <section class="fs" aria-labelledby="cta-t"><div class="fa-wrap">
      <h2 id="cta-t" class="fs__h fa-reveal">See your next 13 weeks.</h2>
      <p class="fs__p fa-reveal">Connect your bank and Fathom builds your first forecast while you finish your tea. Free for 14 days, no card needed. Plans from £29 a month.</p>
      <ul class="fs__biz" role="list">{customers.map((c) => <li class="fa-reveal"><Image src={BIZ_PHOTOS[c.id]} alt={PHOTO_ALTS[c.id]} width={520} loading="lazy" /><span>{c.data.name}</span></li>)}</ul>
      <p class="fs__act fa-reveal"><a href={`${B}/pricing/`} class="fa-btn fa-btn--mint fa-btn--lg">Start free</a><a href={`${B}/demo/`} class="fa-btn fa-btn--lg fs__ghost">Book a demo</a></p>
    </div></section>
  </Shell>
</Site>
<script>
  import '../../days/day-044/home';
</script>
