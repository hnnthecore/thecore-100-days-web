---
/** Day 041 · Pagebound Books · home. Built from days/day-041/DESIGN.md: the whole shop as a contact sheet. */
import { getCollection } from 'astro:content';
import Site from '../../layouts/Site.astro';
import { Image } from 'astro:assets';
import Shell from '../../components/day-041/Shell.astro';
import BookCover from '../../components/day-041/BookCover.astro';
import SheetFrame from '../../components/day-041/SheetFrame.astro';
import { WORLD, world } from '../../days/day-041/world';

const B = '/day-041-bookshop';
const books = (await getCollection('books')).sort((a, b) => a.data.title.localeCompare(b.data.title));
const events = (await getCollection('events')).sort((a, b) => a.data.date.localeCompare(b.data.date));
const gbp = (n: number) => '£' + n.toFixed(2);

/* The hero sheet: six columns of frames, books and pictures of the street, each column offset. */
const OFF = [0, -90, -40, -130, -20, -70];
const STRIPS = [['#2b2622', '#ffffff'], ['#4c443f', '#ffffff'], ['#cfc6c2', '#2b2622'], ['#bdb2ad', '#2b2622']] as const;
type Frame = { kind: 'book'; i: number } | { kind: 'world'; i: number };
const cols: Frame[][] = [0, 1, 2, 3, 4, 5].map((c) => [
  { kind: 'book', i: c }, { kind: 'world', i: (c + 3) % 12 },
]);
const props = (f: Frame, c: number, r: number, extra = '') => ({ kind: f.kind, book: f.kind === 'book' ? books[f.i] : undefined, world: f.kind === 'world' ? f.i : 0, c, r, extra, note: noteOf(f) });
const noteOf = (f: Frame) => f.kind === 'book'
  ? `${books[f.i].data.staff}: ${books[f.i].data.staffPick}`
  : `${WORLD[f.i].cap}. Photograph: ${WORLD[f.i].creator}, ${WORLD[f.i].license}.`;

/* The staff shelf run: four frames, the first one lifted. */
const run = books.filter((b) => b.data.staffPick).slice(0, 4);
const lifted = run[0];
/* What's on, by month. */
const months = [...new Set(events.map((e) => e.data.date.slice(0, 7)))];
const monthName = (ym: string) => new Date(ym + '-01T00:00').toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
const DOTS = ['#2b2622', '#6a615d', '#8f857f', '#bdb2ad'];
const when = (e: { date: string; time: string }) => new Date(e.date + 'T00:00').toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' }) + ', ' + e.time;
/* Reserve and collect: five moments. */
const MOMENTS = [
  ['Browse', 'Walk the sheet above, spine out, or sort it by shelf. Everything we stock is in it.', '163498340', '6rem'],
  ['Read the note', 'Each book carries a bookseller’s note: what it is, who should have it, why we love it.', '33547857', '2.5rem'],
  ['Reserve', 'Add it to your basket and reserve it. It is free, and there is no card to enter.', '157912796', '8rem'],
  ['Pick a time', 'Choose a day and a slot. We hold your books by the door until you arrive.', '141815319', '4rem'],
  ['Collect', 'Come in from Canongate. Your books are waiting, and the kettle is on.', '149942511', '5.5rem'],
] as const;
/* The whole shop: every book interleaved with twelve pictures of the street and the trade. */
const mason = books.flatMap((b, i) => [{ k: 'book' as const, b }, { k: 'world' as const, w: WORLD[5 + i] }]);
const genres = [...new Set(books.map((b) => b.data.genre))];
---
<Site title="Pagebound Books · Independent bookshop on Canongate, Edinburgh" description="An independent bookshop at 42 Canongate on Edinburgh's Royal Mile, open since 1998. Browse the whole shop at a glance, read the booksellers' notes, and reserve for free click and collect." themeColor="#2b2622" icon="P" day={41}>
  <Shell active="home" home>
    <section class="pg-hero" aria-labelledby="h1">
      <h1 id="h1" class="pg-name">Pagebound Books</h1>
      <div class="pg-top">
        <p class="pg-lede">An independent bookshop on Canongate, Edinburgh. Open since 1998.</p>
        <p class="pg-where" data-hover-note aria-live="polite">42 Canongate<br />Edinburgh EH8 8BN</p>
        <nav aria-label="Pagebound"><a href={`${B}/books/`}>Books</a><a href={`${B}/staff-shelf/`}>Staff shelf</a><a href={`${B}/events/`}>Events</a><a href={`${B}/contact/`}>Visit</a><a href={`${B}/basket/`}>Basket</a></nav>
      </div>
      <div class="pg-sheet">
        {[0, 1, 4, 5].map((c) => (
          <div class:list={['pg-col', c > 3 && 'pg-wide']} style={`--off:${OFF[c]}px;--c:${c};grid-column:${c + 1};grid-row:1`}>{cols[c].map((f, r) => <SheetFrame {...props(f, c, r, r === 1 ? 'pg-fill' : '')} />)}</div>
        ))}
        <div class="pg-mid" style="--c:2;grid-column:3 / 5;grid-row:1">
          <SheetFrame {...props(cols[2][0], 2, 0, 'pg-top-f')} /><SheetFrame {...props(cols[3][0], 3, 0, 'pg-top-f')} />
          <div class="pg-panel">
            <p>Browse the whole shop at a glance. Reserve any book for free, and collect it with a cup of tea.</p>
            <a href={`${B}/books/`} class="pg-btn">Browse the shelves</a>
            <nav aria-label="Shortcuts"><a href={`${B}/events/`}>Events</a><a href={`${B}/staff-shelf/`}>Staff shelf</a><a href={`${B}/contact/`}>Visit</a></nav>
          </div>
          <SheetFrame {...props(cols[2][1], 2, 1, 'pg-fill')} /><SheetFrame {...props(cols[3][1], 3, 1, 'pg-fill')} />
        </div>
      </div>
    </section>

    <section class="pg-intro" aria-labelledby="shop-t"><div class="pg-wrap"><div class="pg-intro__col">
      <h2 id="shop-t" class="pg-h" data-rise>The shop</h2>
      <p data-rise style="--d:1">Pagebound is an independent bookshop at 42 Canongate, on the Royal Mile in Edinburgh.</p>
      <p data-rise style="--d:2">We opened in 1998 with two shelves and a kettle. We have more shelves now. The kettle is still on.</p>
      <p data-rise style="--d:3">Every book here has been read by one of us, and the ones we love carry a handwritten note saying why.</p>
      <p data-rise style="--d:4">Browse the whole shop below, spine out. Reserve anything for free, pick a time, and we will have it waiting by the door.</p>
      <p data-rise style="--d:5"><a class="pg-link" href={`${B}/about/`}>Read about the shop</a></p>
    </div></div></section>

    <section class="pg-sec" aria-labelledby="shelf-t"><div class="pg-wrap pg-run">
      <div class="pg-run__side">
        <div><h2 id="shelf-t" class="pg-h" data-rise>On the staff shelf</h2><p style="margin-top:0.75rem"><a class="pg-link" href={`${B}/staff-shelf/`}>All the booksellers’ picks</a></p></div>
        <div class="pg-run__notes">
          <p data-rise><b>{lifted.data.staff}, on {lifted.data.title}</b>{lifted.data.staffPick}</p>
          <p data-rise style="--d:1"><b>{run[2].data.staff}, on {run[2].data.title}</b>{run[2].data.staffPick}</p>
        </div>
      </div>
      <ul class="pg-frames" role="list">{run.map((b, i) => (
        <li class:list={[i === 0 && 'pg-lift is-lift']} data-rise style={`--d:${i}`}><a href={`${B}/books/${b.id}/`} style="display:grid;gap:8px;text-decoration:none">
          <span class="pg-img"><BookCover slug={b.id} title={b.data.title} author={b.data.author} palette={b.data.palette} pattern={b.data.pattern} width={i === 0 ? 700 : 420} /></span>
          <figcaption><span>{b.data.title}</span><span>{gbp(b.data.price)}</span></figcaption></a></li>
      ))}</ul>
    </div></section>

    <section class="pg-sec" aria-labelledby="ev-t"><div class="pg-wrap"><div class="pg-ev">
      <h2 id="ev-t" class="pg-h" data-rise>What’s on</h2>
      {months.map((m) => (
        <div>
          <h3>{monthName(m)}</h3>
          <ul role="list">{events.filter((e) => e.data.date.startsWith(m)).map((e, i) => (
            <li data-rise style={`--d:${i}`}><a href={`${B}/events/`}><span class="dot" style={`--c:${DOTS[i % DOTS.length]}`} aria-hidden="true"></span><b>{e.data.title}<small>{e.data.kind}, {e.data.price ? gbp(e.data.price) : 'free'}</small></b><time datetime={e.data.date}>{when(e.data)}</time></a></li>
          ))}</ul>
        </div>
      ))}
    </div></div></section>

    <section class="pg-sec pg-moments" aria-labelledby="mo-t">
      <div class="pg-moments__head"><h2 id="mo-t" class="pg-h" data-rise>Reserve and collect</h2><div class="pg-moments__btns"><button type="button" data-prev aria-label="Previous step">←</button><button type="button" data-next aria-label="Next step">→</button></div></div>
      <div class="pg-moments__bar" aria-hidden="true"><i data-bar></i></div>
      <ul class="pg-row" data-row role="list" tabindex="0" aria-label="The five steps, scroll sideways">{MOMENTS.map(([name, text, id, gap]) => (
        <li style={`--gap:${gap}`} data-rise><b>{name}</b><p>{text}</p><span class="pg-img"><Image src={world(id).src} alt={world(id).alt} width={560} height={700} /></span></li>
      ))}</ul>
    </section>

    <section class="pg-sec" aria-labelledby="mas-t">
      <div class="pg-mason__top"><h2 id="mas-t" class="pg-h" data-rise>The whole shop</h2><div>
        <p data-rise>Every book on the shelves this month, and a few of the streets and presses behind them. Sort by shelf.</p>
        <ul class="pg-chips" role="group" aria-label="Sort by shelf" data-chips><li><button type="button" data-g="all" aria-pressed="true">All</button></li>{genres.map((g) => <li><button type="button" data-g={g} aria-pressed="false">{g} ({books.filter((b) => b.data.genre === g).length})</button></li>)}</ul>
      </div></div>
      <div class="pg-mason" data-mason>{mason.map((t) => t.k === 'book' ? (
        <figure data-genre={t.b.data.genre} data-rise><a href={`${B}/books/${t.b.id}/`} style="display:block;text-decoration:none"><span class="pg-img" style="--r:1.5"><BookCover slug={t.b.id} title={t.b.data.title} author={t.b.data.author} palette={t.b.data.palette} pattern={t.b.data.pattern} width={360} /></span><figcaption>{t.b.data.title}<span class="pg-kind">, {t.b.data.genre}</span></figcaption></a></figure>
      ) : (
        <figure class="pg-world" data-genre="photo" data-rise><span class="pg-img" style={`--r:${t.w.ratio}`}><Image src={t.w.src} alt={t.w.alt} width={420} /></span><figcaption>{t.w.cap}<span class="pg-kind">, photograph</span></figcaption></figure>
      ))}</div>
    </section>

    <section class="pg-cta" aria-labelledby="cta-t"><div class="pg-wrap"><div class="pg-cta__col">
      <h2 id="cta-t" class="sr-only">Reserve a book</h2>
      <p data-rise>Reserve a book and we will have it waiting, kettle on.</p>
      <div class="pg-cta__act" data-rise style="--d:1"><a href={`${B}/books/`} class="pg-btn">Browse the shelves</a><a href={`${B}/contact/`} class="pg-link">Visit the shop</a></div>
    </div></div></section>
  </Shell>
</Site>
<script>
  import '../../days/day-041/home';
</script>
