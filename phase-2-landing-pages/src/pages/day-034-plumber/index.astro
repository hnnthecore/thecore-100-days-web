---
/**
 * Day 034 · Plumber landing page · “Copperline Plumbing & Heating”, Bristol & Bath (fictional).
 * Six signature sections: Hero + today's slots · Price list & quote basket · Boiler repair-or-replace advisor · Leak cost calculator · Care plans · Book an engineer.
 * Mood: warm trades. Cream, deep teal, copper and water blue; pipe motifs; Bricolage Grotesque.
 */
import '@fontsource-variable/bricolage-grotesque';
import Landing from '../../layouts/Landing.astro';
import { Image } from 'astro:assets';
import photoTrap from '../../assets/day-034/pipe-wall.jpg';
import photoCabinet from '../../assets/day-034/cabinet.jpg';
import '../../days/day-034/styles.css';

const PRICES = {
  plumbing: [
    { id: 'tap', name: 'Tap repair or replacement', price: 85, note: 'Includes standard tap if supplied by us +£35' },
    { id: 'toilet', name: 'Toilet repair', price: 95, note: 'Flush, fill valve or leak' },
    { id: 'drain', name: 'Unblock sink or drain', price: 110, note: 'Kitchen, bath or outside drain' },
    { id: 'leak', name: 'Leak detection & repair', price: 120, note: 'Thermal camera and moisture meter' },
    { id: 'rad', name: 'Radiator swap', price: 130, note: 'Drain, swap and refill system' },
    { id: 'outtap', name: 'Outside tap fitted', price: 95, note: 'Includes isolation valve' },
  ],
  heating: [
    { id: 'service', name: 'Boiler service', price: 89, note: 'Gas Safe engineer, full report' },
    { id: 'flush', name: 'Powerflush', price: 449, note: 'Cleans sludge from the whole system' },
    { id: 'stat', name: 'Smart thermostat fitted', price: 145, note: 'Supply and fit, app setup included' },
    { id: 'ufh', name: 'Underfloor heating repair', price: 180, note: 'Manifold and actuators' },
    { id: 'cp12', name: 'Gas safety certificate', price: 75, note: 'Same-day certificate' },
    { id: 'bcall', name: 'Boiler repair call-out', price: 110, note: 'Includes first 30 min of repair' },
  ],
  bathrooms: [
    { id: 'shower', name: 'Shower fitted', price: 380, note: 'Electric or mixer, excl. tiling' },
    { id: 'wc', name: 'Toilet replaced', price: 260, note: 'Standard close-coupled' },
    { id: 'basin', name: 'Basin & tap fitted', price: 290, note: 'Includes waste and traps' },
    { id: 'bath', name: 'Bath replaced', price: 420, note: 'Strip out, fit and seal' },
    { id: 'wet', name: 'Wet room conversion', price: 3800, note: 'Full install, tanked and tiled' },
    { id: 'refit', name: 'Full bathroom refit', price: 4200, note: 'Design, strip, fit and finish' },
  ],
  landlord: [
    { id: 'lcp12', name: 'Landlord gas safety record', price: 75, note: 'Legal annual check' },
    { id: 'legio', name: 'Legionella risk assessment', price: 90, note: 'Written report for tenants' },
    { id: 'multi', name: 'Portfolio boiler service', price: 79, note: 'Per property, 3 or more' },
    { id: 'tenant', name: 'Emergency tenant call-out', price: 95, note: 'Within 4 hours, 7 days a week' },
    { id: 'void', name: 'Void property drain-down', price: 110, note: 'Protects pipes over winter' },
    { id: 'plan', name: 'Annual landlord plan', price: 149, note: 'Per property, service and cover' },
  ],
};
const TABS = [['plumbing', 'Plumbing'], ['heating', 'Heating'], ['bathrooms', 'Bathrooms'], ['landlord', 'Landlords']] as const;
const PLANS = [
  { id: 'basic', name: 'Boiler Check', price: 9, blurb: 'A yearly service and a discount on anything else.', feats: [['Annual boiler service', true], ['10% off all repairs', true], ['Priority booking', false], ['Parts & labour covered', false], ['Plumbing & drains', false], ['24/7 emergency call-out', false]] },
  { id: 'cover', name: 'Boiler Cover', price: 19, blurb: 'Breakdowns covered, parts and labour included.', feats: [['Annual boiler service', true], ['10% off all repairs', true], ['Priority booking', true], ['Parts & labour covered', true], ['Plumbing & drains', false], ['24/7 emergency call-out', false]], hot: true },
  { id: 'home', name: 'Whole Home', price: 34, blurb: 'Boiler, plumbing and drains. Sleep easy.', feats: [['Annual boiler service', true], ['10% off all repairs', true], ['Priority booking', true], ['Parts & labour covered', true], ['Plumbing & drains', true], ['24/7 emergency call-out', true]] },
];
const REVIEWS = [['Hannah, Clifton', 'Burst pipe at 11 pm, Dan was here in 50 minutes and sorted it by midnight. Left the floor drier than he found it.'], ['Mr Pritchard, Bath', 'Replaced a 20-year-old boiler. Explained every option, no pressure, and my bills have dropped a third.'], ['Aisha, Bedminster', 'Fixed price, on time, tidy. Rare in this trade.']];
---
<Landing
  title="Copperline Plumbing & Heating · Plumbers in Bristol and Bath"
  description="Gas Safe plumbers and heating engineers in Bristol and Bath. Fixed prices, same-day slots, boiler advice and care plans. (Day 034 of Thecore's 100 Days of Web, a demo concept.)"
  themeColor="#0e3f44"
  icon="🔧"
  day={34}
>
  <div class="cp" data-prices={JSON.stringify(PRICES)} data-plans={JSON.stringify(PLANS.map((p) => ({ id: p.id, name: p.name, price: p.price })))}>
    <!-- =========================== HEADER =========================== -->
    <header class="cp-header" data-header>
      <div class="cp-wrap flex h-18 items-center justify-between gap-6">
        <a href="#top" class="cp-logo" aria-label="Copperline, home"><svg viewBox="0 0 32 32" class="size-8" aria-hidden="true"><rect width="32" height="32" rx="9" fill="var(--teal)" /><path d="M6 12h12a4 4 0 0 1 4 4v6" fill="none" stroke="var(--copper)" stroke-width="3.2" stroke-linecap="round" /><circle cx="22" cy="24" r="2.4" fill="#7fd0e4" /></svg><span>Copper<em>line</em></span></a>
        <nav aria-label="Main" class="hidden lg:block">
          <ul class="flex gap-8 text-[15px] font-semibold">
            <li><a href="#prices">Prices</a></li><li><a href="#boiler">Boiler advice</a></li><li><a href="#leaks">Leak calculator</a></li><li><a href="#plans">Care plans</a></li>
          </ul>
        </nav>
        <a href="#book" class="cp-btn cp-btn--copper whitespace-nowrap">Book an engineer</a>
      </div>
    </header>

    <main id="main">
      <!-- =========================== 1 · HERO =========================== -->
      <section id="top" class="cp-hero" aria-labelledby="hero-title">
        <div class="cp-wrap grid grid-cols-1 items-center gap-12 pt-12 pb-20 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:pt-16">
          <div>
            <p class="cp-pill"><span class="cp-dot"></span>Gas Safe registered · Bristol & Bath</p>
            <h1 id="hero-title" class="cp-display mt-6">Fixed. <span class="cp-copper">Properly.</span> First time.</h1>
            <p class="mt-6 max-w-lg text-lg leading-relaxed text-(--muted)">Leaks, boilers, bathrooms and blocked drains, sorted by engineers who arrive when they say, tell you the price before they start and clear up after.</p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href="#book" class="cp-btn cp-btn--teal cp-btn--lg">Book online</a>
              <a href="#prices" class="cp-btn cp-btn--line cp-btn--lg">See our prices</a>
            </div>
            <ul class="cp-trust mt-10" role="list"><li><b>4.9</b> from 2,640 reviews</li><li><b>60 min</b> emergency response</li><li><b>12 months</b> guarantee</li></ul>
          </div>
          <div class="cp-today" aria-labelledby="today-title">
            <svg viewBox="0 0 400 120" class="cp-pipes" aria-hidden="true"><path class="cp-pipe" d="M0 60h120q20 0 20 20v20h120v-60q0-20 20-20h120" /><path class="cp-flow" d="M0 60h120q20 0 20 20v20h120v-60q0-20 20-20h120" pathLength="100" /><circle cx="140" cy="100" r="7" fill="#c86b3c" /><circle cx="260" cy="40" r="7" fill="#c86b3c" /></svg>
            <h2 id="today-title" class="cp-today__t">Today’s availability</h2>
            <p class="cp-today__sub" data-today-sub>Checking the van schedule…</p>
            <ul class="cp-slots" role="list" data-today></ul>
            <a href="#book" class="cp-btn cp-btn--copper w-full">Book one of these</a>
          </div>
        </div>
      </section>

      <div class="cp-wrap cp-band">
        <figure class="cp-band__main"><Image src={photoTrap} alt="A plumber reaching under a kitchen sink to fit a white waste pipe" width={1400} /><figcaption>Fixed prices, no call-out surprises</figcaption></figure>
        <figure><Image src={photoCabinet} alt="A plumber checking the waste trap and valves in a sink cabinet" width={800} /><figcaption>Tidy, careful work</figcaption></figure>
      </div>

      <!-- =========================== 2 · PRICES =========================== -->
      <section id="prices" class="cp-section" aria-labelledby="prices-title">
        <div class="cp-wrap">
          <div class="cp-head"><p class="cp-eyebrow">Price list</p><h2 id="prices-title" class="cp-h2">No surprises. <span class="cp-copper">Just prices.</span></h2></div>
          <div class="cp-tabs" role="tablist" aria-label="Price categories" data-tabs>
            {TABS.map(([k, l], i) => <button type="button" role="tab" id={`pt-${k}`} aria-controls={`pp-${k}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{l}</button>)}
          </div>
          {TABS.map(([k], i) => (
            <div role="tabpanel" id={`pp-${k}`} aria-labelledby={`pt-${k}`} hidden={i !== 0}>
              <ul class="cp-list" role="list">
                {PRICES[k].map((p) => (
                  <li class="cp-item">
                    <div><h3>{p.name}</h3><p>{p.note}</p></div>
                    <p class="cp-item__price"><small>from</small> £{p.price.toLocaleString('en-GB')}</p>
                    <button type="button" class="cp-add" data-add={p.id} aria-pressed="false" aria-label={`Add ${p.name} to my quote`}><span aria-hidden="true">+</span></button>
                  </li>
                ))}
              </ul>
            </div>
          ))}
          <div class="cp-basket" data-basket hidden>
            <p aria-live="polite"><b data-b-count>0</b> job<span data-b-s>s</span> in your quote · from <b data-b-total>£0</b></p>
            <a href="#book" class="cp-btn cp-btn--copper" data-b-go>Request this quote</a>
          </div>
        </div>
      </section>

      <!-- =========================== 3 · BOILER =========================== -->
      <section id="boiler" class="cp-section cp-section--teal" aria-labelledby="boiler-title">
        <div class="cp-wrap">
          <div class="cp-head"><p class="cp-eyebrow cp-eyebrow--light">Boiler advisor</p><h2 id="boiler-title" class="cp-h2">Repair it, or <span class="cp-water">replace it?</span></h2></div>
          <form class="grid grid-cols-1 items-start gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]" data-boiler novalidate>
            <div class="cp-panel">
              <div><div class="cp-row"><label for="bo-age">Age of your boiler</label><b data-age-out>10 years</b></div><input id="bo-age" class="cp-range" type="range" min="1" max="25" value="10" /></div>
              <div><div class="cp-row"><label for="bo-rep">Repairs in the last 2 years</label><b data-rep-out>1</b></div><input id="bo-rep" class="cp-range" type="range" min="0" max="5" value="1" /></div>
              <div><div class="cp-row"><label for="bo-bill">Yearly gas bill</label><b data-bill-out>£1,400</b></div><input id="bo-bill" class="cp-range" type="range" min="600" max="3000" step="50" value="1400" /></div>
              <fieldset><legend>Any of these?</legend>
                <div class="cp-checks">
                  <label><input type="checkbox" value="noise" /><span>Banging or whistling</span></label>
                  <label><input type="checkbox" value="pilot" /><span>Pilot light going out</span></label>
                  <label><input type="checkbox" value="cold" /><span>Radiators cold at the bottom</span></label>
                  <label><input type="checkbox" value="parts" /><span>Engineer says parts are obsolete</span></label>
                </div>
              </fieldset>
            </div>
            <div class="cp-verdict" aria-live="polite">
              <p class="cp-verdict__k">Our advice</p>
              <h3 class="cp-verdict__t" data-verdict></h3>
              <div class="cp-meter" aria-hidden="true"><span>Repair</span><span>Plan to replace</span><span>Replace</span><i data-marker></i></div>
              <ul class="cp-verdict__list" data-reasons></ul>
              <p class="cp-verdict__save" data-saving></p>
              <a href="#book" class="cp-btn cp-btn--copper cp-btn--lg" data-b-advice>Get a fixed-price quote</a>
            </div>
          </form>
        </div>
      </section>

      <!-- =========================== 4 · LEAKS =========================== -->
      <section id="leaks" class="cp-section" aria-labelledby="leaks-title">
        <div class="cp-wrap grid grid-cols-1 items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
          <div>
            <p class="cp-eyebrow">Leak calculator</p>
            <h2 id="leaks-title" class="cp-h2 mt-4">What is that drip <span class="cp-copper">really costing?</span></h2>
            <form class="cp-leakform" data-leak novalidate>
              <fieldset><legend>What’s leaking?</legend>
                <div class="cp-opts">
                  <label><input type="radio" name="leak" value="15" checked /><span>Dripping tap</span></label>
                  <label><input type="radio" name="leak" value="200" /><span>Running toilet</span></label>
                  <label><input type="radio" name="leak" value="500" /><span>Leaking pipe</span></label>
                </div>
              </fieldset>
              <div><div class="cp-row"><label for="lk-days">Left for</label><b data-days-out>30 days</b></div><input id="lk-days" class="cp-range" type="range" min="1" max="365" value="30" /></div>
              <fieldset><legend>How bad?</legend>
                <div class="cp-opts">
                  <label><input type="radio" name="sev" value="0.5" /><span>Slow</span></label>
                  <label><input type="radio" name="sev" value="1" checked /><span>Steady</span></label>
                  <label><input type="radio" name="sev" value="2" /><span>Fast</span></label>
                </div>
              </fieldset>
            </form>
          </div>
          <div class="cp-bucket" aria-live="polite">
            <svg viewBox="0 0 220 260" role="img" aria-label="Bucket filling with wasted water">
              <defs><clipPath id="bk"><path d="M40 70h140l-14 168a8 8 0 0 1-8 7H62a8 8 0 0 1-8-7z" /></clipPath></defs>
              <path d="M40 70h140l-14 168a8 8 0 0 1-8 7H62a8 8 0 0 1-8-7z" fill="#fff" stroke="#0e3f44" stroke-width="5" />
              <g clip-path="url(#bk)"><rect class="cp-water-fill" data-fill x="30" y="245" width="170" height="190" fill="#6ec1d9" /><g data-wave style="transition:transform 1s cubic-bezier(.16,1,.3,1)"><path class="cp-wave" d="M20 245q22-10 45 0t45 0t45 0t45 0t45 0v12H20z" fill="#8ad3e8" /></g></g>
              <path d="M30 70h160" stroke="#0e3f44" stroke-width="7" stroke-linecap="round" />
              <path class="cp-drop" d="M110 14c-8 12-12 18-12 24a12 12 0 0 0 24 0c0-6-4-12-12-24z" fill="#6ec1d9" />
            </svg>
            <p class="cp-bucket__big"><b data-litres>0</b><span>litres wasted</span></p>
            <p class="cp-bucket__sub" data-baths></p>
            <p class="cp-bucket__cost">That’s about <b data-cost>£0</b> down the drain.</p>
            <a href="#book" class="cp-btn cp-btn--teal" data-leak-book>Get it fixed today</a>
          </div>
        </div>
      </section>

      <!-- =========================== 5 · PLANS =========================== -->
      <section id="plans" class="cp-section cp-section--cream2" aria-labelledby="plans-title">
        <div class="cp-wrap">
          <div class="cp-head"><p class="cp-eyebrow">Care plans</p><h2 id="plans-title" class="cp-h2">Peace of mind, <span class="cp-copper">monthly.</span></h2></div>
          <label class="cp-bill"><input type="checkbox" data-annual /><span class="cp-bill__ui" aria-hidden="true"></span><span>Pay annually <b>2 months free</b></span></label>
          <div class="cp-plans" role="radiogroup" aria-label="Choose a care plan" data-plans-list>
            {PLANS.map((p) => (
              <label class={`cp-plan${p.hot ? ' is-hot' : ''}`}>
                <input type="radio" name="plan" value={p.id} checked={p.id === 'cover'} />
                <span class="cp-plan__card">
                  {p.hot && <em class="cp-plan__tag">Most popular</em>}
                  <b class="cp-plan__name">{p.name}</b>
                  <span class="cp-plan__blurb">{p.blurb}</span>
                  <span class="cp-plan__price"><b data-price={p.price}>£{p.price}</b><small>/month</small></span>
                  <ul class="cp-plan__feats" role="list">{p.feats.map(([f, on]) => <li class={on ? 'on' : 'off'}><span class="sr-only">{on ? 'Included: ' : 'Not included: '}</span>{f}</li>)}</ul>
                </span>
              </label>
            ))}
          </div>
          <p class="cp-plansum" aria-live="polite" data-plan-sum></p>
          <ul class="cp-reviews" role="list">{REVIEWS.map(([n, q]) => <li><blockquote>“{q}”</blockquote><p>{n}</p></li>)}</ul>
        </div>
      </section>

      <!-- =========================== 6 · BOOK =========================== -->
      <section id="book" class="cp-section" aria-labelledby="book-title">
        <div class="cp-wrap">
          <div class="cp-head"><p class="cp-eyebrow">Book an engineer</p><h2 id="book-title" class="cp-h2">Tell us what’s wrong. <span class="cp-copper">We’ll fix it.</span></h2></div>
          <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-[minmax(0,1.25fr)_minmax(0,0.75fr)]">
            <form class="cp-card" data-book novalidate>
              <label class="cp-emerg"><input type="checkbox" data-emerg /><span><b>It’s an emergency</b> <small>Burst pipe, no heating or hot water in winter, flooding. We aim to be with you within 60 minutes. £60 emergency fee applies.</small></span></label>
              <div data-sched>
                <fieldset class="mt-6"><legend>Day</legend><div class="cp-days" data-days></div></fieldset>
                <fieldset class="mt-5"><legend>Arrival window</legend><div class="cp-windows" data-windows></div></fieldset>
              </div>
              <div class="cp-fields mt-6">
                <div class="sm:col-span-2"><label for="b-job">What do you need?</label><select id="b-job" class="cp-input" data-job><option>Leak or burst pipe</option><option>Boiler or heating</option><option>Blocked drain or toilet</option><option>Bathroom work</option><option>Landlord certificate</option><option>Something else</option></select></div>
                <div><label for="b-name">Full name</label><input id="b-name" class="cp-input" autocomplete="name" data-req aria-describedby="b-name-e" /><p class="cp-err" id="b-name-e" hidden>Please add your name.</p></div>
                <div><label for="b-phone">Mobile</label><input id="b-phone" type="tel" class="cp-input" autocomplete="tel" data-req aria-describedby="b-phone-e" /><p class="cp-err" id="b-phone-e" hidden>Enter a phone number with at least 10 digits.</p></div>
                <div><label for="b-pc">Postcode</label><input id="b-pc" class="cp-input" autocomplete="postal-code" maxlength="9" data-req aria-describedby="b-pc-e" /><p class="cp-err" id="b-pc-e" hidden>Enter a Bristol or Bath postcode, e.g. BS1 4DJ.</p></div>
                <div class="sm:col-span-2"><label for="b-note">Tell us more <span class="opacity-60">(optional)</span></label><textarea id="b-note" class="cp-input min-h-24" data-note placeholder="Where is the problem? Is the water off? Any photos you can text us?"></textarea></div>
              </div>
              <p class="cp-err mt-4" role="alert" data-book-err hidden></p>
              <button type="submit" class="cp-btn cp-btn--teal cp-btn--lg mt-6" data-book-btn>Book engineer</button>
            </form>
            <aside class="cp-sum" data-sum>
              <h3>Your booking</h3>
              <dl><div><dt>Job</dt><dd data-s-job></dd></div><div><dt>When</dt><dd data-s-when></dd></div><div><dt>Fee</dt><dd data-s-fee></dd></div><div><dt>Quote items</dt><dd data-s-items>None</dd></div></dl>
              <ul class="cp-sum__list" role="list"><li>Price agreed before work starts</li><li>Gas Safe registered engineers</li><li>12-month workmanship guarantee</li></ul>
            </aside>
            <div class="cp-done lg:col-span-2" data-done hidden tabindex="-1">
              <div class="cp-done__ico" aria-hidden="true">🔧</div>
              <h3 class="cp-h2" style="max-width:none">On the list, <span class="cp-copper" data-done-name></span>.</h3>
              <p class="mt-3 text-lg" data-done-text></p>
              <p class="cp-ref mt-6">Job reference <b data-ref></b></p>
              <button type="button" class="cp-btn cp-btn--teal mt-8" data-again>Book another</button>
              <p class="mt-4 text-sm opacity-60">Demo only: nothing was sent.</p>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="cp-footer">
      <div class="cp-wrap flex flex-wrap items-center justify-between gap-4 py-10 text-sm">
        <p class="cp-logo"><span>Copper<em>line</em></span></p>
        <p>A fictional plumbing company created for Thecore's 100 Days of Web (Day 034). Prices, engineers and reviews are demo content.</p>
      </div>
    </footer>
  </div>
</Landing>

<script>
  import '../../days/day-034/script';
</script>

<style is:global>
/* Contrast fixes from the audit (this page): text now meets WCAG AA (4.5:1, or 3:1 for large text). */
html section#top > div:nth-child(1) > div:nth-child(2) > a:nth-child(5) { color: #15110d !important; }
html section#boiler > div:nth-child(1) > form:nth-child(2) > div:nth-child(2) > a:nth-child(6) { color: #15110d !important; }
html section#plans > div:nth-child(1) > div:nth-child(1) > p:nth-child(1) { color: #9e4e28 !important; }
html section#plans > div:nth-child(1) > label:nth-child(2) > span:nth-child(3) > b:nth-child(1) { color: #9e4e28 !important; }
html section#plans > div:nth-child(1) > div:nth-child(3) > label:nth-child(2) > span:nth-child(2) > em:nth-child(1) { color: #15110d !important; }
</style>
