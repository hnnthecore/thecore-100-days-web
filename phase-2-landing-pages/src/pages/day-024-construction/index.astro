---
/**
 * Day 024 · Construction company landing page · “Halden & Rowe”, design & build contractor, London.
 * Six signature sections: Hero (building rises) · Sectors · Projects (case-study dialogs) · Process · Cost estimator · Start a project.
 * Mood: architectural & editorial. Stone white, charcoal, one construction-yellow accent, blueprint blue for drawings.
 */
import '@fontsource-variable/space-grotesk';
import '@fontsource/instrument-serif/400-italic.css';
import Landing from '../../layouts/Landing.astro';
import Iso from '../../components/day-024/Iso.astro';
import '../../days/day-024/styles.css';

const SECTORS = [
  { id: 'residential', name: 'Residential', title: 'Homes that age beautifully.', text: 'From single-family new builds to 120-unit apartment schemes, built to Passivhaus principles where clients want them.', points: ['New-build houses & apartments', 'Extensions & basements', 'Passivhaus & net-zero'], stat: ['1,840', 'homes delivered'], iso: { w: 3, d: 3, floors: 4, material: 'brick' as const } },
  { id: 'commercial', name: 'Commercial', title: 'Workplaces people want to return to.', text: 'Cat A and Cat B fit-outs, new office buildings and mixed-use schemes, delivered while neighbours keep working.', points: ['Offices & mixed use', 'Cat A / Cat B fit-out', 'Retail & hospitality'], stat: ['2.1M', 'sq ft built'], iso: { w: 4, d: 3, floors: 7, material: 'glass' as const } },
  { id: 'education', name: 'Education', title: 'Schools built around term time.', text: 'Classroom blocks, labs and sports halls phased to the school calendar, with zero days of lost teaching on our last 20 projects.', points: ['Primary & secondary schools', 'University labs', 'Sports & community'], stat: ['36', 'schools'], iso: { w: 5, d: 3, floors: 3, material: 'timber' as const } },
  { id: 'heritage', name: 'Heritage', title: 'Listed buildings, handled with care.', text: 'Conservation-led restoration and sensitive new insertions in Grade I and II listed buildings, working hand-in-hand with Historic England.', points: ['Listed building restoration', 'Façade retention', 'Lime & stonework'], stat: ['48', 'listed buildings'], iso: { w: 4, d: 2, floors: 4, material: 'stone' as const } },
];

const PROJECTS = [
  { id: 'wharf', name: 'Canal Wharf', sector: 'residential', place: 'Hackney Wick', year: 2025, value: '£38M', size: '11,200 m²', weeks: 96, iso: { w: 4, d: 3, floors: 8, material: 'brick' as const }, scope: ['112 apartments over 8 storeys', 'Mass-timber frame on concrete podium', 'Air-source heat pumps, EPC A'], quote: 'Handed over three weeks early, with the snag list closed before residents moved in.', who: 'Development Director, Tideway Homes (demo)' },
  { id: 'atlas', name: 'Atlas House', sector: 'commercial', place: 'Farringdon', year: 2024, value: '£52M', size: '18,600 m²', weeks: 110, iso: { w: 4, d: 4, floors: 9, material: 'glass' as const }, scope: ['BREEAM Outstanding office', 'Retained 1930s façade', 'Roof terrace & cycle hub'], quote: 'They solved the façade retention puzzle that two other contractors walked away from.', who: 'Project Director, Meridian Estates (demo)' },
  { id: 'oak', name: 'Oakfield Academy', sector: 'education', place: 'Croydon', year: 2024, value: '£19M', size: '7,400 m²', weeks: 64, iso: { w: 5, d: 3, floors: 3, material: 'timber' as const }, scope: ['1,200-pupil secondary school', 'Built across two summer holidays', 'Net-zero in operation'], quote: 'Not one lesson lost. The children watched it grow from their windows.', who: 'Headteacher, Oakfield Academy (demo)' },
  { id: 'chapel', name: 'St Clement’s Chapel', sector: 'heritage', place: 'Clerkenwell', year: 2023, value: '£6.4M', size: '1,900 m²', weeks: 58, iso: { w: 3, d: 2, floors: 3, material: 'stone' as const }, scope: ['Grade II* chapel to arts venue', 'Lime render & stone repair', 'New glass rear extension'], quote: 'Craftsmanship of a kind we didn’t think still existed.', who: 'Trustee, Clement Arts Trust (demo)' },
  { id: 'mews', name: 'Brunswick Mews', sector: 'residential', place: 'Islington', year: 2023, value: '£9.2M', size: '2,600 m²', weeks: 52, iso: { w: 5, d: 2, floors: 3, material: 'brick' as const }, scope: ['14 mews houses', 'Basement excavation in a conservation area', 'Hand-laid London stock brick'], quote: 'The neighbours sent a thank-you card when the hoardings came down.', who: 'Founder, Northbank Living (demo)' },
  { id: 'lab', name: 'Kingsway Labs', sector: 'education', place: 'Bloomsbury', year: 2025, value: '£27M', size: '6,800 m²', weeks: 88, iso: { w: 3, d: 3, floors: 6, material: 'glass' as const }, scope: ['University teaching labs', 'Vibration-isolated floors', 'Live campus, phased delivery'], quote: 'Labs ready for the new term, to the day.', who: 'Estates Director, Kingsway University (demo)' },
];

const STEPS = [
  { n: '01', title: 'Brief & feasibility', time: '2–4 weeks', text: 'We visit, listen and test the numbers: site constraints, planning risk, budget and programme, before anything is drawn.' },
  { n: '02', title: 'Design & planning', time: '8–16 weeks', text: 'Our architects and engineers work with yours. We cost the design as it develops, so there are no surprises at tender.' },
  { n: '03', title: 'Fixed-price contract', time: '2 weeks', text: 'A single price and a single programme, with every risk listed and owned. One contract, one point of contact.' },
  { n: '04', title: 'Build', time: 'Programme-led', text: 'A dedicated site team, weekly photo reports and a live programme you can see. Considerate Constructors on every site.' },
  { n: '05', title: 'Handover & aftercare', time: '12 months+', text: 'Snag-free handover, O&M manuals in a searchable portal, and a 12-month defects visit, with a 10-year structural warranty.' },
];

const TYPES = [
  { id: 'ext', name: 'Rear extension', rate: 2400, min: 10, max: 80, base: 10 },
  { id: 'loft', name: 'Loft conversion', rate: 2100, min: 15, max: 60, base: 8 },
  { id: 'house', name: 'New-build house', rate: 2800, min: 80, max: 400, base: 26 },
  { id: 'fitout', name: 'Office fit-out', rate: 1450, min: 100, max: 2000, base: 10 },
  { id: 'refurb', name: 'Full refurbishment', rate: 1200, min: 40, max: 400, base: 12 },
];
---
<Landing
  title="Halden & Rowe · Design & build construction, London"
  description="Design & build contractor delivering homes, workplaces, schools and listed buildings across London since 1987. Get an instant cost estimate. (Day 024 of Thecore's 100 Days of Web, a demo concept.)"
  themeColor="#1b1b1a"
  icon="🏗️"
  day={24}
>
  <div class="hr">
    <!-- =========================== HEADER =========================== -->
    <header class="hr-header" data-header>
      <div class="hr-wrap flex h-20 items-center justify-between gap-6">
        <a href="#top" class="hr-logo" aria-label="Halden and Rowe Construction, home"><b>Halden &amp; Rowe</b><span>Construction · Est. 1987</span></a>
        <nav aria-label="Main" class="hidden lg:block">
          <ul class="flex gap-9 text-[15px]">
            <li><a href="#sectors">Sectors</a></li><li><a href="#projects">Projects</a></li><li><a href="#process">Process</a></li><li><a href="#estimate">Estimate</a></li>
          </ul>
        </nav>
        <a href="#contact" class="hr-btn hr-btn--dark whitespace-nowrap"><span class="sm:hidden">Contact</span><span class="hidden sm:inline">Start a project</span></a>
      </div>
    </header>

    <main id="main">
      <!-- =========================== 1 · HERO =========================== -->
      <section id="top" class="hr-hero" aria-labelledby="hero-title">
        <div class="hr-wrap grid grid-cols-1 items-center gap-10 pt-12 pb-12 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:pt-24">
          <div>
            <p class="hr-eyebrow">Design &amp; build · London</p>
            <h1 id="hero-title" class="hr-display mt-6">We build what <em>architects</em> draw.</h1>
            <p class="mt-7 max-w-xl text-lg leading-relaxed text-(--ink-2)">Homes, workplaces, schools and listed buildings, delivered on a fixed price and a programme you can see. Thirty-eight years, 412 projects, one standard.</p>
            <div class="mt-9 flex flex-wrap gap-3">
              <a href="#estimate" class="hr-btn hr-btn--accent">Estimate your project</a>
              <a href="#projects" class="hr-btn hr-btn--line">See our work</a>
            </div>
          </div>
          <div class="hr-hero__art">
            <Iso w={5} d={4} floors={9} material="glass" crane class="hr-rise" label="Isometric drawing of a nine-storey glass building under construction, with a tower crane" />
            <p class="hr-tag hr-tag--a" aria-hidden="true"><b>L09</b> Topping out</p>
            <p class="hr-tag hr-tag--b" aria-hidden="true"><b>96 wk</b> On programme</p>
          </div>
        </div>
        <div class="hr-wrap">
          <dl class="hr-stats">
            <div><dt>Projects delivered</dt><dd>412</dd></div>
            <div><dt>Value built</dt><dd>£1.2bn</dd></div>
            <div><dt>On time or early</dt><dd>94%</dd></div>
            <div><dt>Days since a lost-time injury</dt><dd data-safe-days>2,190</dd></div>
          </dl>
        </div>
      </section>

      <!-- =========================== 2 · SECTORS =========================== -->
      <section id="sectors" class="hr-section" aria-labelledby="sectors-title">
        <div class="hr-wrap">
          <div class="hr-head"><p class="hr-eyebrow">01 · Sectors</p><h2 id="sectors-title" class="hr-h2">Four specialisms. <em>One standard.</em></h2></div>
          <div class="hr-tabs" role="tablist" aria-label="Sectors" data-sector-tabs>
            {SECTORS.map((s, i) => <button type="button" role="tab" id={`st-${s.id}`} aria-controls={`sp-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{s.name}</button>)}
          </div>
          {SECTORS.map((s, i) => (
            <div class="hr-sector" role="tabpanel" id={`sp-${s.id}`} aria-labelledby={`st-${s.id}`} hidden={i !== 0} tabindex="0">
              <div>
                <h3 class="hr-h3">{s.title}</h3>
                <p class="mt-4 max-w-lg text-lg leading-relaxed text-(--ink-2)">{s.text}</p>
                <ul class="hr-points mt-7" role="list">{s.points.map((p) => <li>{p}</li>)}</ul>
                <p class="hr-sector__stat"><b>{s.stat[0]}</b>{s.stat[1]}</p>
              </div>
              <div class="hr-sector__art"><Iso {...s.iso} class="w-full" /></div>
            </div>
          ))}
        </div>
      </section>

      <!-- =========================== 3 · PROJECTS =========================== -->
      <section id="projects" class="hr-section hr-section--dark" aria-labelledby="projects-title">
        <div class="hr-wrap">
          <div class="hr-head hr-head--split">
            <div><p class="hr-eyebrow">02 · Selected projects</p><h2 id="projects-title" class="hr-h2">Built, handed over, <em>still standing proud.</em></h2></div>
            <div class="hr-filters" role="group" aria-label="Filter projects" data-filters>
              <button type="button" aria-pressed="true" data-f="all">All</button>
              {SECTORS.map((s) => <button type="button" aria-pressed="false" data-f={s.id}>{s.name}</button>)}
            </div>
          </div>
          <p class="sr-only" aria-live="polite" data-project-count></p>
          <ul class="hr-projects" role="list">
            {PROJECTS.map((p) => (
              <li class="hr-project" data-sector={p.sector}>
                <button type="button" class="hr-project__btn" data-open={p.id} aria-haspopup="dialog">
                  <span class="hr-project__art"><Iso {...p.iso} class="w-full" /></span>
                  <span class="hr-project__meta"><span>{p.place} · {p.year}</span><span>{p.value}</span></span>
                  <span class="hr-project__name">{p.name}</span>
                  <span class="hr-project__more" aria-hidden="true">View case study →</span>
                </button>
              </li>
            ))}
          </ul>
        </div>
        {PROJECTS.map((p) => (
          <dialog class="hr-dialog" id={`dlg-${p.id}`} aria-labelledby={`dlg-${p.id}-t`}>
            <div class="hr-dialog__art"><Iso {...p.iso} class="w-full" /></div>
            <div class="hr-dialog__body">
              <form method="dialog"><button class="hr-close" aria-label="Close case study">✕</button></form>
              <p class="hr-eyebrow">{SECTORS.find((s) => s.id === p.sector)?.name} · {p.place}</p>
              <h3 id={`dlg-${p.id}-t`} class="hr-h3 mt-3">{p.name}</h3>
              <dl class="hr-facts mt-6">
                <div><dt>Value</dt><dd>{p.value}</dd></div><div><dt>Area</dt><dd>{p.size}</dd></div><div><dt>Programme</dt><dd>{p.weeks} weeks</dd></div><div><dt>Completed</dt><dd>{p.year}</dd></div>
              </dl>
              <ul class="hr-points mt-6" role="list">{p.scope.map((s) => <li>{s}</li>)}</ul>
              <blockquote class="hr-quote mt-7">“{p.quote}”<footer>{p.who}</footer></blockquote>
            </div>
          </dialog>
        ))}
      </section>

      <!-- =========================== 4 · PROCESS =========================== -->
      <section id="process" class="hr-section" aria-labelledby="process-title">
        <div class="hr-wrap grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
          <div class="lg:sticky lg:top-28 lg:self-start">
            <p class="hr-eyebrow">03 · How we work</p>
            <h2 id="process-title" class="hr-h2 mt-4">One team from <em>first sketch</em> to final key.</h2>
            <p class="mt-5 max-w-md text-lg leading-relaxed text-(--ink-2)">Design &amp; build means one contract, one point of contact and one team that owns every risk, so problems get solved, not passed on.</p>
          </div>
          <div class="hr-steps-wrap" data-steps>
          <span class="hr-steps__line" aria-hidden="true"><i data-steps-fill></i></span>
          <ol class="hr-steps">
            {STEPS.map((s) => (
              <li class="hr-step" data-step>
                <span class="hr-step__n" aria-hidden="true">{s.n}</span>
                <div>
                  <h3 class="hr-step__t">{s.title}</h3>
                  <p class="hr-step__time">{s.time}</p>
                  <p class="mt-3 leading-relaxed text-(--ink-2)">{s.text}</p>
                </div>
              </li>
            ))}
          </ol>
          </div>
        </div>
      </section>

      <!-- =========================== 5 · ESTIMATOR =========================== -->
      <section id="estimate" class="hr-section hr-section--blue" aria-labelledby="estimate-title">
        <div class="hr-wrap">
          <div class="hr-head"><p class="hr-eyebrow">04 · Cost estimator</p><h2 id="estimate-title" class="hr-h2">What will it <em>cost?</em> An honest first number.</h2></div>
          <form class="hr-estimator" data-estimator novalidate>
            <div class="hr-estimator__inputs">
              <fieldset>
                <legend class="hr-label">Project type</legend>
                <div class="hr-types">
                  {TYPES.map((t, i) => <label><input type="radio" name="type" value={t.id} data-rate={t.rate} data-min={t.min} data-max={t.max} data-base={t.base} checked={i === 0} /><span>{t.name}<small>from £{t.rate.toLocaleString('en-GB')}/m²</small></span></label>)}
                </div>
              </fieldset>
              <div class="mt-7">
                <div class="flex items-baseline justify-between"><label class="hr-label" for="area">Floor area</label><output class="hr-area" for="area" data-area-out>30 m²</output></div>
                <input type="range" id="area" class="hr-range" min="10" max="80" step="1" value="30" data-area />
                <p class="mt-1 flex justify-between text-sm text-(--ink-3)"><span data-area-min>10 m²</span><span data-area-max>80 m²</span></p>
              </div>
              <fieldset class="mt-7">
                <legend class="hr-label">Specification</legend>
                <div class="hr-seg">
                  <label><input type="radio" name="spec" value="1" checked /><span>Standard</span></label>
                  <label><input type="radio" name="spec" value="1.25" /><span>Premium</span></label>
                  <label><input type="radio" name="spec" value="1.6" /><span>Bespoke</span></label>
                </div>
              </fieldset>
              <fieldset class="mt-7">
                <legend class="hr-label">Location</legend>
                <div class="hr-seg">
                  <label><input type="radio" name="loc" value="1.15" checked /><span>Inner London</span></label>
                  <label><input type="radio" name="loc" value="1.05" /><span>Outer London</span></label>
                  <label><input type="radio" name="loc" value="0.95" /><span>Home counties</span></label>
                </div>
              </fieldset>
            </div>
            <div class="hr-estimator__out" aria-live="polite">
              <p class="hr-label">Estimated build cost <span class="normal-case tracking-normal">(ex VAT)</span></p>
              <p class="hr-range-out" data-est-range>£0</p>
              <dl class="hr-facts hr-facts--light mt-6">
                <div><dt>Per m²</dt><dd data-est-rate>–</dd></div>
                <div><dt>Build time</dt><dd data-est-weeks>–</dd></div>
              </dl>
              <div class="hr-split mt-6" aria-hidden="true" data-split><span style="--w:12%">Design</span><span style="--w:18%">Approvals</span><span style="--w:70%">Build</span></div>
              <p class="mt-4 text-sm leading-relaxed text-(--blue-ink)/80" data-est-note></p>
              <a href="#contact" class="hr-btn hr-btn--accent mt-6 w-full justify-center" data-est-cta>Turn this into a fixed quote</a>
            </div>
          </form>
        </div>
      </section>

      <!-- =========================== 6 · CONTACT =========================== -->
      <section id="contact" class="hr-section" aria-labelledby="contact-title">
        <div class="hr-wrap grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)]">
          <div>
            <p class="hr-eyebrow">05 · Start a project</p>
            <h2 id="contact-title" class="hr-h2 mt-4">Tell us what you're <em>planning.</em></h2>
            <form class="hr-form mt-9" data-contact novalidate>
              <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                <div><label class="hr-label" for="c-name">Name</label><input id="c-name" class="hr-input" autocomplete="name" data-req aria-describedby="c-name-e" /><p id="c-name-e" class="hr-err" hidden>Please add your name.</p></div>
                <div><label class="hr-label" for="c-email">Email</label><input id="c-email" type="email" class="hr-input" autocomplete="email" data-req aria-describedby="c-email-e" /><p id="c-email-e" class="hr-err" hidden>Enter an email like name@company.com.</p></div>
                <div><label class="hr-label" for="c-type">Project type</label><select id="c-type" class="hr-input" data-c-type>{TYPES.map((t) => <option>{t.name}</option>)}<option>Something else</option></select></div>
                <div><label class="hr-label" for="c-budget">Budget</label><input id="c-budget" class="hr-input" placeholder="e.g. £150k–£200k" data-c-budget /></div>
              </div>
              <div class="mt-5"><label class="hr-label" for="c-msg">About the project</label><textarea id="c-msg" class="hr-input min-h-32" placeholder="Site address, timeline, anything we should know" data-c-msg></textarea></div>
              <div class="mt-5">
                <span class="hr-label" id="drop-l">Drawings &amp; documents <span class="normal-case tracking-normal text-(--ink-3)">(optional · PDF, DWG, JPG · up to 20 MB each)</span></span>
                <label class="hr-drop" data-drop aria-describedby="drop-l">
                  <input type="file" multiple accept=".pdf,.dwg,.dxf,.jpg,.jpeg,.png" class="sr-only" data-files />
                  <span><b>Choose files</b> or drop them here</span>
                </label>
                <ul class="hr-files" role="list" data-file-list></ul>
                <p class="hr-err" role="alert" data-file-err></p>
              </div>
              <button type="submit" class="hr-btn hr-btn--dark mt-7">Send enquiry</button>
              <p class="hr-err mt-3" role="alert" data-form-err></p>
            </form>
            <div class="hr-done" hidden tabindex="-1" data-done>
              <p class="hr-eyebrow">Enquiry received</p>
              <p class="hr-h3 mt-3" data-done-title></p>
              <p class="mt-3 text-(--ink-2)" data-done-text></p>
              <p class="mt-3 text-sm text-(--ink-3)">Demo only: nothing was sent and no files left your device.</p>
            </div>
          </div>
          <aside class="hr-office" aria-label="Office and accreditations">
            <h3 class="hr-label">Head office</h3>
            <address class="mt-3 not-italic text-lg leading-relaxed">14 Clerkenwell Close<br />London EC1R 0AA</address>
            <p class="mt-3"><a class="hr-link" href="tel:+442070000002">020 7000 0002</a><br /><a class="hr-link" href="mailto:tenders@haldenrowe.example">tenders@haldenrowe.example</a></p>
            <h3 class="hr-label mt-9">Accreditations</h3>
            <ul class="hr-badges mt-3" role="list"><li>ISO 9001</li><li>ISO 14001</li><li>ISO 45001</li><li>Considerate Constructors</li><li>CHAS</li></ul>
            <p class="mt-9 text-sm text-(--ink-3)">Typical response: one working day. Tender documents welcome via the form or by email.</p>
          </aside>
        </div>
      </section>
    </main>

    <footer class="hr-footer">
      <div class="hr-wrap flex flex-wrap items-end justify-between gap-6 py-12">
        <p class="hr-footer__mark">Halden <em>&amp;</em> Rowe</p>
        <p class="max-w-md text-sm text-(--ink-3)">A fictional contractor designed for Thecore's 100 Days of Web (Day 024). Projects, clients and figures are demo content.</p>
      </div>
    </footer>
  </div>
</Landing>

<script>
  import '../../days/day-024/script';
</script>
