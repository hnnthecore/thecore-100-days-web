---
/**
 * Day 025 · Transport company landing page · “Pace Logistics”, UK road freight & distribution.
 * Six signature sections: Hero + live tracking · Services · Instant freight quote · Live network map · Sustainability · Contact & careers.
 * Mood: crisp logistics-tech. White, deep navy, electric blue, a lime signal colour; Manrope + JetBrains Mono.
 */
import '@fontsource-variable/manrope';
import '@fontsource-variable/jetbrains-mono';
import Landing from '../../layouts/Landing.astro';
import { HUBS, ROUTES, hub, curve } from '../../days/day-025/data';
import '../../days/day-025/styles.css';

const SERVICES = [
  { name: 'Pallet network', text: 'From one pallet to 26. Next-day to 98% of UK postcodes, tracked to the minute.', stat: '18,400 pallets / night', icon: 'M3 7h18v10H3zM3 12h18M8 7v10M16 7v10' },
  { name: 'Full truckloads', text: 'Dedicated 44-tonne artics with live GPS and a named planner for every load.', stat: '640 trucks', icon: 'M2 7h12v9H2zM14 10h4l3 3v3h-7zM6 19a2 2 0 1 0 0-.1M17 19a2 2 0 1 0 0-.1' },
  { name: 'Same-day courier', text: 'A van at your door within 60 minutes in 12 cities. Signed for at the other end.', stat: '60-min pickup', icon: 'M12 3v9l5 3M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z' },
  { name: 'Warehousing', text: '1.6M sq ft across 10 hubs: pick, pack, cross-dock and returns, with stock visible in real time.', stat: '1.6M sq ft', icon: 'M3 10 12 4l9 6v10H3zM8 20v-6h8v6' },
  { name: 'Temperature-controlled', text: 'Chilled and frozen from −25 °C to +25 °C, with every degree logged for compliance.', stat: '−25 to +25 °C', icon: 'M12 3v12M8 7l4-4 4 4M9 15a3 3 0 1 0 6 0' },
  { name: 'EU & ports', text: 'Daily groupage to the EU via Dover and Felixstowe, with customs paperwork handled in-house.', stat: '27 countries', icon: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18' },
];

/** Hubs whose label sits to the left of the dot, so labels never collide. */
const LEFT = new Set(['gla', 'cdf', 'dov', 'fxt']);

const JOBS = [
  { title: 'Class 1 HGV driver (nights)', place: 'Birmingham hub', pay: '£19.80/h + overtime' },
  { title: 'Transport planner', place: 'Manchester hub', pay: '£36k–£42k' },
  { title: 'Warehouse team leader', place: 'London (Park Royal)', pay: '£34k + shift allowance' },
];
---
<Landing
  title="Pace Logistics · UK road freight, pallets & warehousing"
  description="Next-day pallet delivery to 98% of the UK, full loads, same-day couriers and warehousing. Track a shipment or get an instant freight quote. (Day 025 of Thecore's 100 Days of Web, a demo concept.)"
  themeColor="#0b1b3a"
  icon="🚚"
  day={25}
>
  <div class="pl">
    <!-- =========================== HEADER =========================== -->
    <header class="pl-header" data-header>
      <div class="pl-wrap flex h-18 items-center justify-between gap-6">
        <a href="#top" class="pl-logo" aria-label="Pace Logistics, home">
          <svg viewBox="0 0 32 32" class="size-8" aria-hidden="true"><rect width="32" height="32" rx="9" fill="var(--blue)" /><path d="M8 21 15 11l4 6 5-6" fill="none" stroke="var(--lime)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /></svg>
          <span>Pace<b>Logistics</b></span>
        </a>
        <nav aria-label="Main" class="hidden lg:block">
          <ul class="flex gap-8 text-[15px] font-semibold text-(--ink-2)">
            <li><a href="#services">Services</a></li><li><a href="#quote">Get a quote</a></li><li><a href="#network">Network</a></li><li><a href="#green">Sustainability</a></li><li><a href="#contact">Careers</a></li>
          </ul>
        </nav>
        <a href="#quote" class="pl-btn pl-btn--blue whitespace-nowrap"><span class="sm:hidden">Quote</span><span class="hidden sm:inline">Instant quote</span></a>
      </div>
    </header>

    <main id="main">
      <!-- =========================== 1 · HERO + TRACKING =========================== -->
      <section id="top" class="pl-hero" aria-labelledby="hero-title">
        <div class="pl-wrap grid grid-cols-1 items-center gap-12 pt-14 pb-20 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:pt-20">
          <div>
            <p class="pl-chip"><span class="pl-live"></span><b data-on-road>412</b> trucks on the road right now</p>
            <h1 id="hero-title" class="pl-display mt-6">Freight that moves at the <span class="pl-grad">pace of your business.</span></h1>
            <p class="mt-6 max-w-xl text-lg leading-relaxed text-(--ink-2)">Next-day pallets to 98% of UK postcodes, full loads, same-day couriers and warehousing, all on one platform with live tracking and honest pricing.</p>
            <div class="mt-9 flex flex-wrap gap-3">
              <a href="#quote" class="pl-btn pl-btn--blue pl-btn--lg">Get an instant quote</a>
              <a href="#network" class="pl-btn pl-btn--ghost pl-btn--lg">See our network</a>
            </div>
            <dl class="pl-kpis mt-12">
              <div><dt>On time, last 30 days</dt><dd>98.7%</dd></div>
              <div><dt>Deliveries today</dt><dd data-today>0</dd></div>
              <div><dt>Trustpilot</dt><dd>4.8<small>/5</small></dd></div>
            </dl>
          </div>

          <div class="pl-track" aria-labelledby="track-title">
            <h2 id="track-title" class="text-lg font-bold">Track a shipment</h2>
            <form class="pl-track__form" data-track-form novalidate>
              <label for="trk" class="sr-only">Tracking number</label>
              <input id="trk" class="pl-input pl-mono" placeholder="PCE-482-193" autocomplete="off" spellcheck="false" aria-describedby="trk-msg" data-trk />
              <button class="pl-btn pl-btn--dark" type="submit">Track</button>
            </form>
            <p id="trk-msg" class="mt-2 min-h-5 text-sm text-(--ink-3)" aria-live="polite" data-trk-msg></p>
            <p class="text-sm text-(--ink-3)">Demo numbers: <button type="button" class="pl-link pl-mono" data-try="PCE-482-193">PCE-482-193</button> · <button type="button" class="pl-link pl-mono" data-try="PCE-105-774">PCE-105-774</button></p>
            <div class="pl-track__result" hidden data-trk-result>
              <div class="flex items-start justify-between gap-4">
                <div><p class="text-sm text-(--ink-3)">Status</p><p class="text-xl font-bold" data-trk-status></p></div>
                <div class="text-right"><p class="text-sm text-(--ink-3)">Estimated arrival</p><p class="text-xl font-bold text-(--blue)" data-trk-eta></p></div>
              </div>
              <div class="pl-route mt-6" aria-hidden="true">
                <span class="pl-route__end" data-trk-from></span>
                <div class="pl-route__bar"><i data-trk-bar></i><span class="pl-route__truck" data-trk-truck>🚚</span></div>
                <span class="pl-route__end pl-route__end--to" data-trk-to></span>
              </div>
              <ol class="pl-events mt-6" data-trk-events></ol>
            </div>
            <div class="pl-track__empty" data-trk-empty>
              <svg viewBox="0 0 120 70" aria-hidden="true"><path d="M8 52h70V18H8zM78 30h18l14 12v10H78z" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round" /><circle cx="26" cy="56" r="8" fill="var(--paper)" stroke="currentColor" stroke-width="3" /><circle cx="94" cy="56" r="8" fill="var(--paper)" stroke="currentColor" stroke-width="3" /></svg>
              <p>Enter a tracking number from your confirmation email or label.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- =========================== 2 · SERVICES =========================== -->
      <section id="services" class="pl-section" aria-labelledby="services-title">
        <div class="pl-wrap">
          <div class="pl-head"><p class="pl-eyebrow">Services</p><h2 id="services-title" class="pl-h2">One partner for everything that moves.</h2></div>
          <ul class="pl-services" role="list">
            {SERVICES.map((s) => (
              <li class="pl-service">
                <span class="pl-service__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={s.icon} /></svg></span>
                <h3 class="mt-5 text-xl font-bold">{s.name}</h3>
                <p class="mt-2 text-(--ink-2)">{s.text}</p>
                <p class="pl-service__stat">{s.stat}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- =========================== 3 · QUOTE =========================== -->
      <section id="quote" class="pl-section pl-section--navy" aria-labelledby="quote-title">
        <div class="pl-wrap">
          <div class="pl-head"><p class="pl-eyebrow pl-eyebrow--lime">Instant quote</p><h2 id="quote-title" class="pl-h2">Compare speeds and prices in seconds.</h2></div>
          <form class="pl-quote" data-quote novalidate>
            <div class="pl-quote__row">
              <div><label class="pl-label" for="q-from">Collect from</label><select id="q-from" class="pl-input pl-input--dark" data-from>{HUBS.map((h) => <option value={h.id} selected={h.id === 'man'}>{h.name}</option>)}</select></div>
              <button type="button" class="pl-swap" aria-label="Swap collection and delivery" data-swap>⇄</button>
              <div><label class="pl-label" for="q-to">Deliver to</label><select id="q-to" class="pl-input pl-input--dark" data-to>{HUBS.map((h) => <option value={h.id} selected={h.id === 'lon'}>{h.name}</option>)}</select></div>
              <div>
                <span class="pl-label" id="pal-l">Pallets</span>
                <div class="pl-stepper" role="group" aria-labelledby="pal-l">
                  <button type="button" aria-label="Fewer pallets" data-pal="-1">−</button>
                  <output data-pal-out aria-live="polite">2</output>
                  <button type="button" aria-label="More pallets" data-pal="1">+</button>
                </div>
              </div>
              <div><label class="pl-label" for="q-weight">Weight per pallet</label><select id="q-weight" class="pl-input pl-input--dark" data-weight><option value="0.9">Up to 250 kg</option><option value="1" selected>Up to 500 kg</option><option value="1.2">Up to 1,000 kg</option></select></div>
            </div>
            <p class="mt-4 min-h-5 text-sm text-(--lime)" aria-live="polite" data-q-summary></p>
            <div class="pl-options" role="radiogroup" aria-label="Service options" data-options></div>
            <div class="mt-8 flex flex-wrap items-center justify-between gap-4">
              <p class="text-sm text-white/60">Prices exclude VAT and include fuel surcharge, tail-lift and tracking.</p>
              <a href="#contact" class="pl-btn pl-btn--lime pl-btn--lg" data-book-quote>Book this shipment</a>
            </div>
          </form>
        </div>
      </section>

      <!-- =========================== 4 · NETWORK =========================== -->
      <section id="network" class="pl-section" aria-labelledby="network-title">
        <div class="pl-wrap grid grid-cols-1 items-center gap-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
          <div>
            <p class="pl-eyebrow">Live network</p>
            <h2 id="network-title" class="pl-h2 mt-4">12 hubs. 15 trunk routes. Every night.</h2>
            <p class="mt-5 max-w-md text-lg leading-relaxed text-(--ink-2)">Freight collected by 5 pm is trunked overnight between our hubs and out for delivery by 7 am. Pick a hub on the map to see it.</p>
            <div class="pl-hubcard mt-8" aria-live="polite" data-hubcard>
              <p class="text-sm text-(--ink-3)">Selected hub</p>
              <p class="mt-1 text-2xl font-bold" data-hub-name>Birmingham</p>
              <dl class="pl-mini mt-4"><div><dt>Trucks based</dt><dd data-hub-trucks>88</dd></div><div><dt>Facility</dt><dd data-hub-size>260,000 sq ft</dd></div><div><dt>Routes</dt><dd data-hub-routes>5</dd></div></dl>
            </div>
          </div>
          <div class="pl-mapcard">
            <svg viewBox="30 120 390 440" class="pl-map" role="group" aria-label="Pace network map. Use the hub buttons to explore." data-map>
              <defs><pattern id="dots" width="12" height="12" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1.2" class="pl-map__dot" /></pattern></defs>
              <rect x="30" y="120" width="390" height="440" fill="url(#dots)" />
              <g class="pl-map__routes">{ROUTES.map(([a, b]) => <path d={curve(hub(a), hub(b))} data-route={`${a}-${b}`} pathLength="1" />)}</g>
              <g class="pl-map__flow">{ROUTES.map(([a, b], i) => <path d={curve(hub(a), hub(b))} pathLength="1" style={`--d:${(i % 5) * 0.6}s`} />)}</g>
              {HUBS.map((h) => (
                <g class="pl-hub" transform={`translate(${h.x} ${h.y})`} data-hub={h.id} tabindex="0" role="button" aria-label={`${h.name} hub, ${h.trucks} trucks`} aria-pressed={h.id === 'bhm' ? 'true' : 'false'}>
                  <circle r="16" class="pl-hub__halo" />
                  <circle r={h.trucks > 80 ? 7 : 5.5} class="pl-hub__dot" />
                  <text x={LEFT.has(h.id) ? -12 : 12} y="4" text-anchor={LEFT.has(h.id) ? 'end' : 'start'}>{h.name}</text>
                </g>
              ))}
            </svg>
            <p class="pl-map__note">Stylised map, not to scale</p>
          </div>
        </div>
      </section>

      <!-- =========================== 5 · SUSTAINABILITY =========================== -->
      <section id="green" class="pl-section pl-section--soft" aria-labelledby="green-title">
        <div class="pl-wrap">
          <div class="pl-head"><p class="pl-eyebrow">Sustainability</p><h2 id="green-title" class="pl-h2">Cleaner miles, measured, not promised.</h2></div>
          <div class="pl-green">
            <div class="pl-green__big">
              <p class="text-sm font-semibold text-(--ink-3)">CO₂e avoided this year vs. 2019 fleet</p>
              <p class="pl-green__num"><span data-co2>0</span><small> tonnes</small></p>
              <p class="mt-3 text-(--ink-2)">Equal to taking <b data-cars>0</b> cars off the road for a year.</p>
            </div>
            <ul class="pl-fleet" role="list" aria-label="Fleet energy mix">
              <li style="--w:32%;--c:var(--lime)"><span>Battery electric</span><b>32%</b><i></i></li>
              <li style="--w:41%;--c:var(--blue)"><span>HVO renewable diesel</span><b>41%</b><i></i></li>
              <li style="--w:27%;--c:#9aa6bf"><span>Euro 6 diesel</span><b>27%</b><i></i></li>
            </ul>
            <div class="pl-goal">
              <p class="text-sm font-semibold text-(--ink-3)">Road to net-zero</p>
              <ol class="pl-goal__steps"><li class="is-done"><b>2022</b>First 40 e-vans</li><li class="is-done"><b>2024</b>All diesel on HVO</li><li class="is-now"><b>2027</b>50% electric</li><li><b>2030</b>Net-zero fleet</li></ol>
            </div>
          </div>
        </div>
      </section>

      <!-- =========================== 6 · CONTACT & CAREERS =========================== -->
      <section id="contact" class="pl-section" aria-labelledby="contact-title">
        <div class="pl-wrap">
          <div class="pl-head"><p class="pl-eyebrow">Get in touch</p><h2 id="contact-title" class="pl-h2">Ship with us, or drive with us.</h2></div>
          <div class="pl-tabs" role="tablist" aria-label="Contact options" data-ctabs>
            <button type="button" role="tab" id="ct-ship" aria-controls="cp-ship" aria-selected="true">Ship with us</button>
            <button type="button" role="tab" id="ct-drive" aria-controls="cp-drive" aria-selected="false" tabindex="-1">Careers <span class="pl-badge">3 open</span></button>
          </div>
          <div id="cp-ship" role="tabpanel" aria-labelledby="ct-ship" class="pl-panel">
            <form class="grid grid-cols-1 gap-5 sm:grid-cols-2" data-contact novalidate>
              <div><label class="pl-label" for="f-name">Name</label><input id="f-name" class="pl-input" autocomplete="name" data-req aria-describedby="f-name-e" /><p id="f-name-e" class="pl-err" hidden>Please add your name.</p></div>
              <div><label class="pl-label" for="f-email">Work email</label><input id="f-email" type="email" class="pl-input" autocomplete="email" data-req aria-describedby="f-email-e" /><p id="f-email-e" class="pl-err" hidden>Enter an email like name@company.com.</p></div>
              <div><label class="pl-label" for="f-co">Company</label><input id="f-co" class="pl-input" autocomplete="organization" /></div>
              <div><label class="pl-label" for="f-vol">Weekly volume</label><select id="f-vol" class="pl-input"><option>1–10 pallets</option><option>11–50 pallets</option><option>51–200 pallets</option><option>Full loads</option></select></div>
              <div class="sm:col-span-2"><label class="pl-label" for="f-msg">What do you need to move?</label><textarea id="f-msg" class="pl-input min-h-28" data-f-msg></textarea></div>
              <div class="sm:col-span-2 flex flex-wrap items-center gap-4"><button class="pl-btn pl-btn--blue pl-btn--lg" type="submit">Request a callback</button><p class="text-sm text-(--ink-3)">A logistics manager replies within 2 working hours.</p></div>
              <p class="pl-ok sm:col-span-2" role="status" data-contact-ok></p>
            </form>
          </div>
          <div id="cp-drive" role="tabpanel" aria-labelledby="ct-drive" class="pl-panel" hidden>
            <ul class="pl-jobs" role="list">
              {JOBS.map((j) => (
                <li class="pl-job">
                  <div><h3 class="text-lg font-bold">{j.title}</h3><p class="text-(--ink-3)">{j.place} · {j.pay}</p></div>
                  <button type="button" class="pl-btn pl-btn--ghost" data-apply={j.title}>Apply in 2 minutes</button>
                </li>
              ))}
            </ul>
            <p class="pl-ok mt-4" role="status" data-apply-ok></p>
          </div>
        </div>
      </section>
    </main>

    <footer class="pl-footer">
      <div class="pl-wrap flex flex-wrap items-center justify-between gap-4 py-10 text-sm text-white/60">
        <p class="pl-logo text-white"><span>Pace<b>Logistics</b></span></p>
        <p>A fictional haulier created for Thecore's 100 Days of Web (Day 025). Tracking, quotes and figures are demo content.</p>
      </div>
    </footer>
  </div>
</Landing>

<script>
  import '../../days/day-025/script';
</script>
