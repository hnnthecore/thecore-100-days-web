---
/**
 * Day 030 · Gym landing page · “Rival Athletic Club”, three clubs across the north of England (fictional).
 * Six signature sections: Hero + live busyness · Class timetable · Membership plans · Week builder · 30-day challenge · Free pass.
 * Mood: athletic poster. Black, white and hot magenta; Anton (display, uppercase) + Archivo.
 */
import '@fontsource/anton';
import '@fontsource-variable/archivo';
import Landing from '../../layouts/Landing.astro';
import { Image } from 'astro:assets';
import photoFloor from '../../assets/day-030/floor.jpg';
import photoDumbbells from '../../assets/day-030/dumbbells.jpg';
import '../../days/day-030/styles.css';

const PLANS = [
  { id: 'base', name: 'Base', price: 24, blurb: 'The floor, the weights, the lot. One club.', feats: [['Gym floor, 5 am to 11 pm', true], ['1 home club', true], ['Group classes', false], ['All 3 clubs', false], ['Recovery suite', false], ['Monthly PT session', false]] },
  { id: 'rival', name: 'Rival', price: 39, blurb: 'Every class, every club, the app.', feats: [['Gym floor, 5 am to 11 pm', true], ['All 3 clubs', true], ['Unlimited group classes', true], ['Rival app + programmes', true], ['Recovery suite', false], ['Monthly PT session', false]], hot: true },
  { id: 'elite', name: 'Elite', price: 69, blurb: 'Everything, plus a coach in your corner.', feats: [['Gym floor, 5 am to 11 pm', true], ['All 3 clubs', true], ['Unlimited group classes', true], ['Rival app + programmes', true], ['Sauna, ice bath, recovery suite', true], ['Monthly PT session + 2 guest passes', true]] },
];
const CLUBS = ['Leeds Central', 'Manchester Northern Quarter', 'Sheffield Kelham Island'];
const MEMBERS = [
  ['Sam O.', 412], ['Priya K.', 388], ['Danny R.', 355], ['Lena W.', 331], ['Marcus T.', 290], ['Chloe B.', 246], ['Tom H.', 198], ['Aisha N.', 164],
];
---
<Landing
  title="Rival Athletic Club · Gyms in Leeds, Manchester & Sheffield"
  description="Strength, classes and recovery across three northern clubs. See how busy we are right now, book a class, build your week and claim a free 3-day pass. (Day 030 of Thecore's 100 Days of Web, a demo concept.)"
  themeColor="#0a0a0a"
  icon="🏋️"
  day={30}
>
  <div class="rv" data-members={JSON.stringify(MEMBERS)} data-clubs={JSON.stringify(CLUBS)}>
    <!-- =========================== HEADER =========================== -->
    <header class="rv-header" data-header>
      <div class="rv-wrap flex h-18 items-center justify-between gap-6">
        <a href="#top" class="rv-logo" aria-label="Rival Athletic Club, home">RIVAL<span>/</span>AC</a>
        <nav aria-label="Main" class="hidden lg:block">
          <ul class="flex gap-8 text-sm font-bold tracking-widest uppercase">
            <li><a href="#classes">Classes</a></li><li><a href="#plans">Membership</a></li><li><a href="#build">Build a week</a></li><li><a href="#challenge">Challenge</a></li>
          </ul>
        </nav>
        <a href="#pass" class="rv-btn rv-btn--pink whitespace-nowrap">Free 3-day pass</a>
      </div>
    </header>

    <main id="main">
      <!-- =========================== 1 · HERO =========================== -->
      <section id="top" class="rv-hero" aria-labelledby="hero-title">
        <div class="rv-wrap grid grid-cols-1 items-end gap-12 pt-14 pb-16 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,0.7fr)] lg:pt-20">
          <div>
            <p class="rv-kicker">Leeds · Manchester · Sheffield</p>
            <h1 id="hero-title" class="rv-display">Earn<br />it<span class="rv-pink">.</span></h1>
            <p class="mt-8 max-w-lg text-lg leading-relaxed text-white/70">Serious equipment, brilliant classes and coaches who actually know your name. Open 5 am to 11 pm, every day.</p>
            <div class="mt-9 flex flex-wrap gap-3">
              <a href="#pass" class="rv-btn rv-btn--pink rv-btn--lg">Claim a free pass</a>
              <a href="#classes" class="rv-btn rv-btn--line rv-btn--lg">See today’s classes</a>
            </div>
          </div>
          <div class="rv-live" aria-labelledby="live-title">
            <p id="live-title" class="rv-live__label"><span class="rv-dot"></span>Live in the gym</p>
            <div class="rv-clubs" role="group" aria-label="Choose a club" data-clubs-btn></div>
            <p class="rv-live__pct"><b data-live-pct>0</b><span>% full</span></p>
            <div class="rv-meter" aria-hidden="true"><i data-live-bar></i></div>
            <p class="rv-live__text" aria-live="polite" data-live-text></p>
            <p class="rv-live__tip" data-live-tip></p>
          </div>
        </div>
        <div class="rv-ticker" aria-hidden="true"><div class="rv-ticker__track"><span>STRENGTH ✦ SPEED ✦ SWEAT ✦ SPIRIT ✦ STRENGTH ✦ SPEED ✦ SWEAT ✦ SPIRIT ✦ </span><span>STRENGTH ✦ SPEED ✦ SWEAT ✦ SPIRIT ✦ STRENGTH ✦ SPEED ✦ SWEAT ✦ SPIRIT ✦ </span></div></div>
      </section>

      <div class="rv-wrap rv-band">
        <figure class="rv-band__main"><Image src={photoFloor} alt="A long rack of dumbbells in a bright gym with a member training in the background" width={1400} /><figcaption>Free weights up to 60 kg</figcaption></figure>
        <figure class="rv-band__side"><Image src={photoDumbbells} alt="Rubber dumbbells lined up on a rack, close up" width={700} /><figcaption>Open 5 am to 11 pm</figcaption></figure>
      </div>

      <!-- =========================== 2 · CLASSES =========================== -->
      <section id="classes" class="rv-section" aria-labelledby="classes-title">
        <div class="rv-wrap">
          <div class="rv-head"><p class="rv-kicker rv-kicker--dark">Timetable</p><h2 id="classes-title" class="rv-h2">Book your <span class="rv-pink">spot.</span></h2></div>
          <div class="rv-tt-bar">
            <div class="rv-days" role="group" aria-label="Day of the week" data-days></div>
            <div class="rv-types" role="group" aria-label="Filter by class type" data-types>
              <button type="button" data-type="all" aria-pressed="true">All</button>
              <button type="button" data-type="hiit" aria-pressed="false">HIIT</button>
              <button type="button" data-type="strength" aria-pressed="false">Strength</button>
              <button type="button" data-type="cycle" aria-pressed="false">Cycle</button>
              <button type="button" data-type="boxing" aria-pressed="false">Boxing</button>
              <button type="button" data-type="yoga" aria-pressed="false">Yoga</button>
            </div>
          </div>
          <ul class="rv-classes" role="list" data-classes></ul>
          <p class="rv-mybook" aria-live="polite" data-mybook></p>
        </div>
      </section>

      <!-- =========================== 3 · PLANS =========================== -->
      <section id="plans" class="rv-section rv-section--dark" aria-labelledby="plans-title">
        <div class="rv-wrap">
          <div class="rv-head"><p class="rv-kicker">Membership</p><h2 id="plans-title" class="rv-h2">No contracts. <span class="rv-pink">No excuses.</span></h2></div>
          <label class="rv-bill"><input type="checkbox" data-annual /><span class="rv-bill__ui" aria-hidden="true"></span><span>Pay annually <b>2 months free + no joining fee</b></span></label>
          <div class="rv-plans" role="radiogroup" aria-label="Choose a plan" data-plans>
            {PLANS.map((p) => (
              <label class={`rv-plan${p.hot ? ' is-hot' : ''}`}>
                <input type="radio" name="plan" value={p.id} checked={p.id === 'rival'} />
                <span class="rv-plan__card">
                  {p.hot && <em class="rv-plan__tag">Most popular</em>}
                  <b class="rv-plan__name">{p.name}</b>
                  <span class="rv-plan__blurb">{p.blurb}</span>
                  <span class="rv-plan__price"><b data-price={p.price}>£{p.price}</b><small data-per>/month</small></span>
                  <ul class="rv-plan__feats" role="list">
                    {p.feats.map(([f, on]) => <li class={on ? 'on' : 'off'}><span class="sr-only">{on ? 'Included: ' : 'Not included: '}</span>{f}</li>)}
                  </ul>
                </span>
              </label>
            ))}
          </div>
          <p class="rv-plansum" aria-live="polite" data-plan-sum></p>
        </div>
      </section>

      <!-- =========================== 4 · BUILD =========================== -->
      <section id="build" class="rv-section" aria-labelledby="build-title">
        <div class="rv-wrap">
          <div class="rv-head"><p class="rv-kicker rv-kicker--dark">Week builder</p><h2 id="build-title" class="rv-h2">Your week, <span class="rv-pink">sorted.</span></h2></div>
          <form class="rv-builder" data-builder novalidate>
            <fieldset><legend>Main goal</legend>
              <div class="rv-opts">
                <label><input type="radio" name="goal" value="strength" checked /><span>Get stronger</span></label>
                <label><input type="radio" name="goal" value="muscle" /><span>Build muscle</span></label>
                <label><input type="radio" name="goal" value="fat" /><span>Lose fat</span></label>
                <label><input type="radio" name="goal" value="endurance" /><span>More energy</span></label>
              </div>
            </fieldset>
            <fieldset><legend>Days per week</legend>
              <div class="rv-opts">
                {[2, 3, 4, 5, 6].map((n) => <label><input type="radio" name="days" value={n} checked={n === 3} /><span>{n}</span></label>)}
              </div>
            </fieldset>
            <fieldset><legend>Experience</legend>
              <div class="rv-opts">
                <label><input type="radio" name="level" value="new" /><span>New</span></label>
                <label><input type="radio" name="level" value="some" checked /><span>Some</span></label>
                <label><input type="radio" name="level" value="pro" /><span>Experienced</span></label>
              </div>
            </fieldset>
          </form>
          <p class="rv-buildsum" aria-live="polite" data-build-sum></p>
          <ol class="rv-week" data-week></ol>
          <div class="mt-6 flex flex-wrap items-center gap-4">
            <button type="button" class="rv-btn rv-btn--ink" data-copy>Copy my plan</button>
            <p class="text-sm opacity-70" role="status" data-copy-msg></p>
          </div>
        </div>
      </section>

      <!-- =========================== 5 · CHALLENGE =========================== -->
      <section id="challenge" class="rv-section rv-section--pink" aria-labelledby="challenge-title">
        <div class="rv-wrap grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
          <div>
            <p class="rv-kicker rv-kicker--dark">The Rival 30</p>
            <h2 id="challenge-title" class="rv-h2">30 days. <span class="rv-ink">One board.</span></h2>
            <p class="mt-6 max-w-sm text-lg leading-relaxed">Every session you log earns points. Top three at the end win a year of Elite. Day <b>19</b> of 30, and 11 days left to catch Sam.</p>
            <form class="rv-join" data-join novalidate>
              <label for="j-name">Join the board</label>
              <div class="flex gap-3"><input id="j-name" class="rv-input" placeholder="Your first name" maxlength="14" autocomplete="given-name" aria-describedby="j-name-e" /><button type="submit" class="rv-btn rv-btn--ink">Join</button></div>
              <p class="rv-err" id="j-name-e" hidden>Add a name of 2 to 14 letters.</p>
            </form>
            <div class="rv-me" data-me hidden>
              <p><b data-me-name></b>, you’re <b data-me-rank></b></p>
              <button type="button" class="rv-btn rv-btn--ink rv-btn--lg" data-log>+ Log a workout <small>+10 pts</small></button>
              <p class="text-sm" data-me-note></p>
            </div>
          </div>
          <ol class="rv-board" data-board aria-live="off"></ol>
        </div>
      </section>

      <!-- =========================== 6 · PASS =========================== -->
      <section id="pass" class="rv-section rv-section--dark" aria-labelledby="pass-title">
        <div class="rv-wrap grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
          <div>
            <p class="rv-kicker">Try before you join</p>
            <h2 id="pass-title" class="rv-h2">3 days. <span class="rv-pink">On us.</span></h2>
            <p class="mt-6 max-w-sm text-lg leading-relaxed text-white/70">Full access to the gym, classes and recovery suite. No card needed, no hard sell, and a free coach intro on day one.</p>
            <ul class="rv-perks" role="list"><li>All 3 clubs</li><li>Every class</li><li>Free coach intro</li><li>No card details</li></ul>
          </div>
          <form class="rv-pass" data-pass novalidate>
            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
              <div><label for="p-name">Full name</label><input id="p-name" class="rv-input" autocomplete="name" data-req aria-describedby="p-name-e" /><p class="rv-err" id="p-name-e" hidden>Please add your name.</p></div>
              <div><label for="p-email">Email</label><input id="p-email" type="email" class="rv-input" autocomplete="email" data-req aria-describedby="p-email-e" /><p class="rv-err" id="p-email-e" hidden>Enter an email like name@example.com.</p></div>
              <div><label for="p-club">Club</label><select id="p-club" class="rv-input" data-club-select>{CLUBS.map((c) => <option>{c}</option>)}</select></div>
              <div><label for="p-date">First visit</label><input id="p-date" type="date" class="rv-input" data-req aria-describedby="p-date-e" /><p class="rv-err" id="p-date-e" hidden>Choose today or a future date.</p></div>
              <div class="sm:col-span-2"><label for="p-goal">What do you want from us?</label><select id="p-goal" class="rv-input"><option>Get stronger</option><option>Build muscle</option><option>Lose fat</option><option>More energy</option><option>Just curious</option></select></div>
            </div>
            <label class="rv-consent"><input type="checkbox" data-consent /><span>I’m 16 or over and happy to be contacted about my pass.</span></label>
            <p class="rv-err" id="p-consent-e" hidden>Please tick to confirm.</p>
            <button type="submit" class="rv-btn rv-btn--pink rv-btn--lg w-full">Get my free pass</button>
            <div class="rv-ticket" data-ticket hidden tabindex="-1">
              <p class="rv-ticket__k">Your pass</p>
              <p class="rv-ticket__code" data-code></p>
              <p data-ticket-text></p>
            </div>
          </form>
        </div>
      </section>
    </main>

    <footer class="rv-footer">
      <div class="rv-wrap flex flex-wrap items-center justify-between gap-4 py-10 text-sm">
        <p class="rv-logo">RIVAL<span>/</span>AC</p>
        <p>A fictional gym created for Thecore's 100 Days of Web (Day 030). Classes, prices and members are demo content.</p>
      </div>
    </footer>
  </div>
</Landing>

<script>
  import '../../days/day-030/script';
</script>

<style is:global>
/* Contrast fixes from the audit (this page): text now meets WCAG AA (4.5:1, or 3:1 for large text). */
html section#top > div:nth-child(1) > div:nth-child(1) > div:nth-child(4) > a:nth-child(1) { color: #15110d !important; }
html section#classes > div:nth-child(1) > div:nth-child(2) > div:nth-child(2) > button:nth-child(1) { color: #15110d !important; }
html section#plans > div:nth-child(1) > div:nth-child(3) > label:nth-child(2) > span:nth-child(2) > em:nth-child(1) { color: #15110d !important; }
html section#pass > div:nth-child(1) > form:nth-child(2) > button:nth-child(4) { color: #15110d !important; }
</style>
