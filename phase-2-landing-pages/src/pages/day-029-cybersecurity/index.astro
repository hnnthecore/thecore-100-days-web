---
/**
 * Day 029 · Cybersecurity company landing page · “Ironveil”, managed detection & response for UK businesses (fictional).
 * Six signature sections: Hero + threat radar · Services · Attack simulator · Spot the phish · Inside our SOC · Domain scan & hotline.
 * Mood: security operations centre. Near-black, signal green, alert red/amber; Archivo + JetBrains Mono.
 */
import '@fontsource-variable/archivo';
import '@fontsource-variable/jetbrains-mono';
import Landing from '../../layouts/Landing.astro';
import '../../days/day-029/styles.css';

const SERVICES = [
  { name: 'Managed detection & response', text: '24/7 analysts watching every endpoint, mailbox and login. We investigate and contain threats while you sleep.', tag: 'MDR', stat: '8 min mean time to contain' },
  { name: 'Penetration testing', text: 'Ethical hackers attack your web apps, network and people first, then give you a plain-English fix list.', tag: 'TEST', stat: '412 tests delivered' },
  { name: 'Incident response', text: 'Breach at 3 am? Our retainer team is on a call with you in 15 minutes, on site within 4 hours.', tag: 'IR', stat: '15 min to first call' },
  { name: 'Compliance', text: 'Cyber Essentials Plus, ISO 27001 and NIS2 readiness, without drowning in spreadsheets.', tag: 'GRC', stat: '96% first-time pass rate' },
  { name: 'Awareness training', text: 'Short, funny, realistic phishing simulations that people actually remember.', tag: 'HUMAN', stat: '−71% click rate in 6 months' },
  { name: 'Virtual CISO', text: 'A senior security leader for the board, a few days a month, at a fraction of a full-time hire.', tag: 'VCISO', stat: '2 days / month from £2.4k' },
];

const STAGES = [
  { id: 'phish', t: '00:00', name: 'Phishing email opened', text: 'An employee clicks a link in a convincing invoice email.' },
  { id: 'creds', t: '00:04', name: 'Credentials stolen', text: 'A fake sign-in page captures their username, password and session.' },
  { id: 'move', t: '00:47', name: 'Lateral movement', text: 'The attacker logs in from abroad and explores file servers and admin accounts.' },
  { id: 'exfil', t: '01:52', name: 'Data exfiltrated', text: '38 GB of client records and contracts are copied to an attacker-controlled server.' },
  { id: 'ransom', t: '03:20', name: 'Ransomware deployed', text: 'Every server and laptop is encrypted. A ransom note appears on every screen.' },
];

const EMAILS = [
  { from: 'IT Support', addr: 'helpdesk@micros0ft-support.com', subject: 'Your mailbox is 98% full: action required', body: 'Dear user, your mailbox will be suspended in 24 hours. Click “Increase storage” now to avoid losing your emails.', phish: true, flags: ['Look-alike domain: “micros0ft” uses a zero', 'Artificial urgency: “24 hours”', 'Generic greeting: “Dear user”'] },
  { from: 'Priya Shah', addr: 'priya.shah@yourcompany.co.uk', subject: 'Thursday rota (as discussed)', body: 'Hi, attached is the rota we talked about in this morning’s stand-up. Shout if anything clashes.', phish: false, flags: ['Known colleague on your real domain', 'Refers to a conversation you actually had', 'No pressure, no unusual request'] },
  { from: 'Daniel Okafor (CEO)', addr: 'd.okafor.ceo@gmail.com', subject: 'Quick favour, please keep this between us', body: 'I’m in a meeting and can’t talk. Can you buy 5 × £100 gift cards for a client? I’ll reimburse you today. Send me the codes.', phish: true, flags: ['The CEO writing from a free Gmail address', 'Secrecy: “keep this between us”', 'Gift cards are the classic payment fraud'] },
  { from: 'ParcelPoint', addr: 'redelivery@parcel-fee.top', subject: 'Missed delivery: pay £1.99 to rebook', body: 'We couldn’t deliver your parcel. Pay a small fee at bit.ly/3xRdlv to reschedule.', phish: true, flags: ['Shortened link hides the real destination', 'Unexpected small payment (card details are the goal)', 'Odd “.top” domain'] },
  { from: 'People Team', addr: 'payroll@yourcompany.co.uk', subject: 'Your October payslip is ready', body: 'Your payslip is now available. Please log in to the staff portal from your usual bookmark to view it.', phish: false, flags: ['Real internal domain', 'No link or attachment: it asks you to use your own bookmark', 'Expected monthly routine'] },
];

---
<Landing
  title="Ironveil · Managed detection & response, pen testing, incident response"
  description="24/7 managed security for UK businesses. Watch an attack unfold, spot the phish, see inside our SOC and scan your domain. (Day 029 of Thecore's 100 Days of Web, a demo concept.)"
  themeColor="#05080a"
  icon="🛡️"
  day={29}
>
  <div class="iv" data-stages={JSON.stringify(STAGES)} data-emails={JSON.stringify(EMAILS)}>
    <!-- =========================== HEADER =========================== -->
    <header class="iv-header" data-header>
      <div class="iv-wrap flex h-18 items-center justify-between gap-6">
        <a href="#top" class="iv-logo" aria-label="Ironveil, home"><svg viewBox="0 0 28 28" class="size-7" aria-hidden="true"><path d="M14 2 4 6v8c0 6 4 10 10 12 6-2 10-6 10-12V6z" fill="none" stroke="var(--green)" stroke-width="2" /><path d="M9 14l4 4 6-8" fill="none" stroke="var(--green)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>IRONVEIL</a>
        <nav aria-label="Main" class="hidden lg:block">
          <ul class="flex gap-8 text-sm font-semibold tracking-wide uppercase">
            <li><a href="#services">Services</a></li><li><a href="#attack">Attack demo</a></li><li><a href="#phish">Spot the phish</a></li><li><a href="#soc">Our SOC</a></li>
          </ul>
        </nav>
        <a href="#scan" class="iv-btn iv-btn--green whitespace-nowrap">Free domain scan</a>
      </div>
    </header>

    <main id="main">
      <!-- =========================== 1 · HERO =========================== -->
      <section id="top" class="iv-hero" aria-labelledby="hero-title">
        <div class="iv-wrap grid grid-cols-1 items-center gap-12 py-16 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:py-24">
          <div>
            <p class="iv-tag"><span class="iv-dot"></span>SOC online · 6 analysts on shift</p>
            <h1 id="hero-title" class="iv-display mt-7">Attackers only need to be right <span class="iv-green">once.</span></h1>
            <p class="mt-7 max-w-xl text-lg leading-relaxed text-(--muted)">Ironveil watches your systems around the clock and stops attacks in minutes, not months. Managed detection, penetration testing and incident response for UK businesses.</p>
            <div class="mt-9 flex flex-wrap gap-3">
              <a href="#attack" class="iv-btn iv-btn--green iv-btn--lg">See an attack unfold</a>
              <a href="#scan" class="iv-btn iv-btn--line iv-btn--lg">Scan my domain</a>
            </div>
            <dl class="iv-stats mt-12">
              <div><dt>Attacks blocked today</dt><dd class="iv-mono" data-blocked>0</dd></div>
              <div><dt>Mean time to contain</dt><dd class="iv-mono">8 min</dd></div>
              <div><dt>Clients protected</dt><dd class="iv-mono">640</dd></div>
            </dl>
          </div>
          <div class="iv-radar" aria-hidden="true">
            <svg viewBox="-110 -110 220 220">
              <defs>
                <radialGradient id="sweep" cx="0" cy="0" r="1"><stop offset="0" stop-color="#2cf59b" stop-opacity="0.35" /><stop offset="1" stop-color="#2cf59b" stop-opacity="0" /></radialGradient>
              </defs>
              <circle r="100" class="iv-ring" /><circle r="75" class="iv-ring" /><circle r="50" class="iv-ring" /><circle r="25" class="iv-ring" />
              <path d="M-100 0H100M0 -100V100" class="iv-ring" />
              <g class="iv-sweep"><path d="M0 0 100 0A100 100 0 0 0 70.7 -70.7Z" fill="url(#sweep)" /><path d="M0 0H100" stroke="#2cf59b" stroke-width="1.2" /></g>
              <g data-blips></g>
              <circle r="4" fill="#2cf59b" />
            </svg>
            <p class="iv-radar__cap iv-mono" data-radar-cap>Monitoring 14,208 endpoints…</p>
          </div>
        </div>
      </section>

      <!-- =========================== 2 · SERVICES =========================== -->
      <section id="services" class="iv-section" aria-labelledby="services-title">
        <div class="iv-wrap">
          <div class="iv-head"><p class="iv-eyebrow">// capabilities</p><h2 id="services-title" class="iv-h2">One team between you and <span class="iv-green">the breach.</span></h2></div>
          <ul class="iv-services" role="list">
            {SERVICES.map((s) => (
              <li class="iv-svc">
                <span class="iv-svc__tag iv-mono">{s.tag}</span>
                <h3 class="iv-svc__t">{s.name}</h3>
                <p class="iv-svc__p">{s.text}</p>
                <p class="iv-svc__stat iv-mono">{s.stat}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- =========================== 3 · ATTACK SIMULATOR =========================== -->
      <section id="attack" class="iv-section iv-section--panel" aria-labelledby="attack-title">
        <div class="iv-wrap">
          <div class="iv-head"><p class="iv-eyebrow">// attack simulator</p><h2 id="attack-title" class="iv-h2">Same attack. <span class="iv-green">Two outcomes.</span></h2></div>
          <div class="iv-sim">
            <div class="iv-sim__ctrl">
              <label class="iv-switch"><input type="checkbox" data-protect checked /><span class="iv-switch__ui" aria-hidden="true"></span><span>Ironveil protection <b data-protect-label>ON</b></span></label>
              <button type="button" class="iv-btn iv-btn--green" data-run>▶ Run the attack</button>
            </div>
            <ol class="iv-chain" data-chain>
              {STAGES.map((s, i) => (
                <li class="iv-stage" data-stage={s.id}>
                  <span class="iv-stage__n iv-mono">{i + 1}</span>
                  <div><p class="iv-stage__t">{s.name}</p><p class="iv-stage__p">{s.text}</p></div>
                  <span class="iv-stage__time iv-mono">T+{s.t}</span>
                  <span class="iv-stage__state iv-mono"></span>
                </li>
              ))}
            </ol>
            <div class="iv-outcome" data-outcome aria-live="polite" hidden>
              <p class="iv-outcome__t" data-outcome-title></p>
              <dl class="iv-outcome__stats"><div><dt>Files encrypted</dt><dd class="iv-mono" data-o-files>0</dd></div><div><dt>Estimated cost</dt><dd class="iv-mono" data-o-cost>£0</dd></div><div><dt>Downtime</dt><dd class="iv-mono" data-o-down>0 days</dd></div></dl>
            </div>
          </div>
        </div>
      </section>

      <!-- =========================== 4 · SPOT THE PHISH =========================== -->
      <section id="phish" class="iv-section" aria-labelledby="phish-title">
        <div class="iv-wrap grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
          <div>
            <p class="iv-eyebrow">// awareness</p>
            <h2 id="phish-title" class="iv-h2 mt-4">Spot the <span class="iv-red">phish.</span></h2>
            <p class="mt-6 max-w-sm text-lg leading-relaxed text-(--muted)">91% of breaches start with an email. Five messages: which ones would you click?</p>
            <p class="iv-score iv-mono mt-8" aria-live="polite" data-phish-score>Score 0 / 5</p>
          </div>
          <div class="iv-mail" data-mail>
            <div class="iv-mail__head">
              <p class="iv-mail__from"><b data-m-from></b> <span class="iv-mono" data-m-addr></span></p>
              <p class="iv-mail__subject" data-m-subject></p>
            </div>
            <p class="iv-mail__body" data-m-body></p>
            <div class="iv-mail__actions" data-m-actions>
              <button type="button" class="iv-btn iv-btn--red" data-vote="phish">⚠ Phishing</button>
              <button type="button" class="iv-btn iv-btn--green" data-vote="legit">✓ Legitimate</button>
            </div>
            <div class="iv-verdict" data-verdict aria-live="polite" hidden>
              <p class="iv-verdict__t" data-verdict-title></p>
              <ul class="iv-verdict__flags" data-flags></ul>
              <button type="button" class="iv-btn iv-btn--line" data-next-mail>Next email →</button>
            </div>
            <p class="iv-mail__count iv-mono" data-m-count></p>
          </div>
        </div>
      </section>

      <!-- =========================== 5 · SOC =========================== -->
      <section id="soc" class="iv-section iv-section--panel" aria-labelledby="soc-title">
        <div class="iv-wrap">
          <div class="iv-head"><p class="iv-eyebrow">// inside the soc</p><h2 id="soc-title" class="iv-h2">What 3 a.m. looks like <span class="iv-green">from here.</span></h2></div>
          <div class="iv-soc">
            <div class="iv-soc__bar">
              <div class="iv-chips" role="group" aria-label="Filter by severity" data-sev>
                <button type="button" data-sev="all" aria-pressed="true">All</button>
                <button type="button" data-sev="critical" aria-pressed="false"><i class="s-critical"></i>Critical</button>
                <button type="button" data-sev="high" aria-pressed="false"><i class="s-high"></i>High</button>
                <button type="button" data-sev="medium" aria-pressed="false"><i class="s-medium"></i>Medium</button>
                <button type="button" data-sev="low" aria-pressed="false"><i class="s-low"></i>Low</button>
              </div>
              <button type="button" class="iv-btn iv-btn--line" data-pause aria-pressed="false">❚❚ Pause</button>
            </div>
            <div class="iv-soc__counts iv-mono" data-counts></div>
            <ol class="iv-feed iv-mono" data-feed aria-label="Live security events"></ol>
          </div>
        </div>
      </section>

      <!-- =========================== 6 · SCAN & HOTLINE =========================== -->
      <section id="scan" class="iv-section" aria-labelledby="scan-title">
        <div class="iv-wrap grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)]">
          <div>
            <p class="iv-eyebrow">// free domain scan</p>
            <h2 id="scan-title" class="iv-h2 mt-4">How exposed is <span class="iv-green">your domain?</span></h2>
            <form class="iv-scanform" data-scan novalidate>
              <label for="s-domain" class="sr-only">Your domain</label>
              <input id="s-domain" class="iv-input iv-mono" placeholder="yourcompany.co.uk" autocomplete="off" spellcheck="false" aria-describedby="s-domain-e" />
              <button type="submit" class="iv-btn iv-btn--green" data-scan-btn>Run scan</button>
            </form>
            <p class="iv-err" id="s-domain-e" hidden></p>
            <p class="mt-2 text-sm text-(--muted)">This demo is simulated: results are generated in your browser and no request is made to your domain.</p>
            <ul class="iv-checks" data-checks aria-live="polite"></ul>
            <div class="iv-grade" data-grade hidden>
              <span class="iv-grade__letter" data-grade-letter>A</span>
              <div><p class="iv-grade__t" data-grade-title></p><p class="text-sm text-(--muted)" data-grade-text></p></div>
            </div>
            <form class="iv-report" data-report hidden novalidate>
              <label for="s-email">Email me the full report</label>
              <div class="flex flex-wrap gap-3"><input id="s-email" type="email" class="iv-input" autocomplete="email" aria-describedby="s-email-e" /><button type="submit" class="iv-btn iv-btn--green">Send report</button></div>
              <p class="iv-err" id="s-email-e" hidden>Enter an email like name@company.com.</p>
              <p class="iv-ok" role="status" data-report-ok></p>
            </form>
          </div>
          <aside class="iv-hotline">
            <p class="iv-eyebrow iv-red">Under attack right now?</p>
            <p class="iv-hotline__num iv-mono">0800 000 4729</p>
            <p class="text-(--muted)">Our incident line is answered by a human analyst, day or night. Average pick-up: 11 seconds.</p>
            <ol class="iv-hotline__steps">
              <li><b>1.</b> Disconnect the affected device from Wi-Fi and cables. Don’t switch it off.</li>
              <li><b>2.</b> Call us. We start containment while you talk.</li>
              <li><b>3.</b> Don’t pay anything or delete anything.</li>
            </ol>
          </aside>
        </div>
      </section>
    </main>

    <footer class="iv-footer">
      <div class="iv-wrap flex flex-wrap items-center justify-between gap-4 py-10 text-sm">
        <p class="iv-logo !text-white">IRONVEIL</p>
        <p>A fictional security company created for Thecore's 100 Days of Web (Day 029). Figures, clients and the hotline number are demo content.</p>
      </div>
    </footer>
  </div>
</Landing>

<script>
  import '../../days/day-029/script';
</script>
