---
/**
 * Day 033 · Electrician landing page · “Voltline Electrical”, domestic & commercial electricians in the West Midlands (fictional).
 * Six signature sections: Hero + engineer ETA · Interactive house tour · Emergency triage · EV charger calculator · Safety certificate checker · Book a visit.
 * Mood: bold and electric. Ultramarine, night navy, volt yellow, white; diagonal cuts and bolt shapes; Sora.
 */
import '@fontsource-variable/sora';
import Landing from '../../layouts/Landing.astro';
import { Image } from 'astro:assets';
import photoWiring from '../../assets/day-033/wiring.jpg';
import photoPanel from '../../assets/day-033/panel.jpg';
import '../../days/day-033/styles.css';

const SPOTS = [
  { id: 'kitchen', name: 'Kitchen', x: 24, y: 68, title: 'Sockets, hobs & appliances', jobs: [['Add a double socket', '£85–£130', '1 hr'], ['Electric hob or oven circuit', '£180–£320', '2–3 hrs'], ['Under-cabinet lighting', '£140–£260', '2 hrs']] },
  { id: 'board', name: 'Fuse board', x: 47, y: 71, title: 'Consumer units & safety', jobs: [['Consumer unit upgrade', '£520–£780', '4–5 hrs'], ['Fault finding (per hour)', '£75', 'Same day'], ['Add RCD protection to a circuit', '£120–£200', '1–2 hrs']] },
  { id: 'lounge', name: 'Lounge', x: 66, y: 62, title: 'Lighting & smart control', jobs: [['LED downlights (6)', '£280–£460', '3 hrs'], ['Dimmer switches (each)', '£55–£90', '30 min'], ['Smart lighting hub setup', '£90–£160', '1–2 hrs']] },
  { id: 'bath', name: 'Bathroom', x: 24, y: 40, title: 'Wet-room safety', jobs: [['Extractor fan fitted', '£110–£190', '1–2 hrs'], ['Electric shower circuit', '£260–£420', '3–4 hrs'], ['Shaver socket & zoned lights', '£95–£170', '1–2 hrs']] },
  { id: 'loft', name: 'Bedrooms & loft', x: 56, y: 38, title: 'Rewires & extensions', jobs: [['Full rewire (3-bed house)', '£3,200–£4,800', '5–7 days'], ['Loft conversion circuits', '£650–£1,150', '1–2 days'], ['Smoke & heat alarms (interlinked)', '£240–£420', '3 hrs']] },
  { id: 'garage', name: 'Garage', x: 87, y: 71, title: 'EV chargers & outdoor power', jobs: [['7 kW home EV charger fitted', '£899–£1,150', '3–4 hrs'], ['Garage consumer unit & sockets', '£360–£620', '1 day'], ['Garden lights & outdoor sockets', '£220–£540', '3–5 hrs']] },
];
const SYMPTOMS = [
  { id: 'fire', label: 'I can see smoke, flames or sparks', level: 'danger', title: 'Call 999 now', steps: ['Get everyone out of the building and stay out.', 'Call 999 and ask for the fire service.', 'Never use water on an electrical fire.', 'Only switch off at the mains if you can reach it safely, without delay.'] },
  { id: 'water', label: 'Water has got into sockets or the fuse board', level: 'danger', title: 'Keep away and cut the power', steps: ['Do not touch anything electrical while standing in or near water.', 'If the consumer unit is dry and you can reach it safely, switch off the main switch.', 'If you can’t reach it safely, call 999 or your network operator.', 'Call us once it’s safe: we’ll dry out, test and make safe.'] },
  { id: 'burn', label: 'A burning smell from a socket or fuse board', level: 'urgent', title: 'Switch off and call our emergency line', steps: ['Switch off the circuit (or the main switch) at the fuse board if you can reach it safely.', 'Unplug everything from the affected area if it’s safe to do so.', 'Do not use that socket or circuit again.', 'Call us: an engineer can be with you within the hour.'] },
  { id: 'hot', label: 'Sockets or switches are hot, brown or buzzing', level: 'urgent', title: 'Stop using it. This is urgent', steps: ['Turn off and unplug appliances from that socket.', 'Switch off the circuit at the fuse board.', 'Don’t keep using it “just for now”. Heat means a loose or failing connection.', 'Book an emergency visit.'] },
  { id: 'trip', label: 'A trip switch keeps tripping', level: 'soon', title: 'Find the cause before it gets worse', steps: ['Unplug everything on that circuit, then reset the switch.', 'Plug items back in one at a time. The one that trips it is the culprit.', 'If it trips with nothing plugged in, there’s a wiring fault. Stop and call us.', 'We can find and fix the fault, usually the same day.'] },
  { id: 'flicker', label: 'Lights flicker or dim', level: 'soon', title: 'Usually a loose connection', steps: ['Note whether it’s one room or the whole house.', 'Whole house: it may be your supply or main switch, so book a visit soon.', 'One room: a loose connection or failing fitting.', 'It’s not an emergency, but don’t leave it for months.'] },
  { id: 'out', label: 'Power is out across the whole house', level: 'soon', title: 'Check the simple things first', steps: ['Look outside: are your neighbours also without power? If so, call your network operator on 105.', 'Check the main switch and trip switches at your fuse board.', 'Unplug everything, then try resetting once.', 'If only you are affected and it won’t reset, call us.'] },
];
const COVER = ['B', 'CV', 'WS', 'WV', 'DY', 'ST', 'TF'];
---
<Landing
  title="Voltline Electrical · Electricians in Birmingham & the West Midlands"
  description="Emergency and domestic electricians in the West Midlands. Check your nearest engineer, explore typical jobs and prices, get EV charger savings and book online. (Day 033 of Thecore's 100 Days of Web, a demo concept.)"
  themeColor="#1b2bdb"
  icon="⚡"
  day={33}
>
  <div class="ev" data-spots={JSON.stringify(SPOTS)} data-symptoms={JSON.stringify(SYMPTOMS)} data-cover={JSON.stringify(COVER)}>
    <!-- =========================== HEADER =========================== -->
    <header class="ev-header" data-header>
      <div class="ev-wrap flex h-18 items-center justify-between gap-6">
        <a href="#top" class="ev-logo" aria-label="Voltline Electrical, home"><svg viewBox="0 0 28 28" class="size-8" aria-hidden="true"><rect width="28" height="28" rx="8" fill="var(--blue)" /><path d="M16 3 7 16h6l-2 9 10-14h-6z" fill="var(--volt)" /></svg><span>Volt<em>line</em></span></a>
        <nav aria-label="Main" class="hidden lg:block">
          <ul class="flex gap-8 text-[15px] font-semibold">
            <li><a href="#triage">Emergency help</a></li><li><a href="#jobs">Jobs & prices</a></li><li><a href="#safety">Safety checks</a></li><li><a href="#ev">EV chargers</a></li>
          </ul>
        </nav>
        <a href="#book" class="ev-btn ev-btn--volt whitespace-nowrap">Book an electrician</a>
      </div>
    </header>

    <!-- reordered -->
    <main id="main">
      <!-- =========================== 1 · HERO =========================== -->
      <section id="top" class="ev-hero" aria-labelledby="hero-title">
        <div class="ev-wrap relative grid grid-cols-1 items-center gap-12 pt-14 pb-28 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:pt-20">
          <div>
            <p class="ev-tag"><span class="ev-pulse"></span>Engineers on call now · 24/7</p>
            <h1 id="hero-title" class="ev-display mt-6">Power problems? <span class="ev-volt">We’re on our way.</span></h1>
            <p class="mt-6 max-w-lg text-lg leading-relaxed text-white/75">Qualified, insured West Midlands electricians for emergencies, rewires, fuse boards and EV chargers. Fixed prices before we start, and a certificate when we finish.</p>
            <form class="ev-eta" data-eta novalidate>
              <label for="e-pc">Where are you?</label>
              <div class="flex gap-2"><input id="e-pc" class="ev-input" placeholder="B1 1BB" autocomplete="postal-code" maxlength="9" aria-describedby="e-pc-msg" /><button type="submit" class="ev-btn ev-btn--volt">Find my engineer</button></div>
              <p class="ev-eta__msg" id="e-pc-msg" aria-live="polite" data-eta-msg></p>
            </form>
            <ul class="ev-badges mt-8" role="list"><li>Part P registered</li><li>18th Edition qualified</li><li>£2m insured</li><li>Fixed-price quotes</li></ul>
          </div>
          <div class="ev-bolt" aria-hidden="true">
            <svg viewBox="0 0 240 300"><defs><linearGradient id="bg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ffe45c" /><stop offset="1" stop-color="#ffb800" /></linearGradient></defs>
              <circle cx="120" cy="150" r="118" fill="none" stroke="rgb(255 255 255 / .12)" stroke-width="2" stroke-dasharray="3 9" />
              <circle cx="120" cy="150" r="88" fill="rgb(255 255 255 / .05)" />
              <path class="ev-bolt__shape" d="M140 8 40 168h72l-26 124 114-170h-74z" fill="url(#bg)" />
            </svg>
            <p class="ev-bolt__tag">Average arrival: 38 min</p>
          </div>
        </div>
      </section>

      <div class="ev-wrap ev-band">
        <figure class="ev-band__main"><Image src={photoWiring} alt="An electrician in a yellow hard hat and gloves fitting a wall switch" width={1400} /><figcaption>Qualified, insured, local</figcaption></figure>
        <figure><Image src={photoPanel} alt="Gloved hands testing a consumer unit with a multimeter" width={900} /><figcaption>Every circuit tested</figcaption></figure>
      </div>

      <!-- =========================== 2 · TRIAGE =========================== -->
      <section id="triage" class="ev-section ev-section--night" aria-labelledby="triage-title">
        <div class="ev-wrap">
          <div class="ev-head"><p class="ev-eyebrow ev-eyebrow--volt">Emergency help</p><h2 id="triage-title" class="ev-h2">What’s <span class="ev-volt">happening?</span></h2></div>
          <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
            <div class="ev-symptoms" role="radiogroup" aria-label="Choose the closest description" data-symptoms>
              {SYMPTOMS.map((s) => <label class={`ev-sym ev-sym--${s.level}`}><input type="radio" name="symptom" value={s.id} /><span>{s.label}</span></label>)}
            </div>
            <div class="ev-advice" data-advice aria-live="polite">
              <p class="ev-advice__empty" data-advice-empty>Pick the closest match on the left and we’ll tell you exactly what to do. If anyone is in danger, call <b>999</b> first.</p>
              <div data-advice-body hidden>
                <p class="ev-advice__level" data-level></p>
                <h3 class="ev-advice__t" data-advice-t></h3>
                <ol class="ev-advice__steps" data-steps></ol>
                <a class="ev-btn ev-btn--volt ev-btn--lg" data-advice-cta href="#book"></a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- =========================== 3 · HOUSE TOUR =========================== -->
      <section id="jobs" class="ev-section" aria-labelledby="jobs-title">
        <div class="ev-wrap">
          <div class="ev-head"><p class="ev-eyebrow">Jobs & prices</p><h2 id="jobs-title" class="ev-h2">Tap a room. <span class="ev-blue">See the price.</span></h2></div>
          <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-[minmax(0,1.25fr)_minmax(0,0.75fr)]">
            <div class="ev-house">
              <svg viewBox="0 0 600 420" role="img" aria-label="Cutaway illustration of a house showing kitchen, bathroom, fuse board, lounge, bedrooms, loft and garage">
                <rect width="600" height="420" fill="#e7ecff" />
                <rect y="352" width="600" height="68" fill="#b9e0a8" />
                <path d="M40 120 305 28 570 120z" fill="#1b2bdb" /><path d="M60 118 305 40 550 118" fill="none" stroke="#ffd400" stroke-width="3" />
                <rect x="60" y="120" width="170" height="110" fill="#fff" stroke="#0a0f3d" stroke-width="3" />
                <rect x="230" y="120" width="240" height="110" fill="#fff8d6" stroke="#0a0f3d" stroke-width="3" />
                <rect x="60" y="230" width="170" height="122" fill="#fff" stroke="#0a0f3d" stroke-width="3" />
                <rect x="230" y="230" width="100" height="122" fill="#dfe5ff" stroke="#0a0f3d" stroke-width="3" />
                <rect x="330" y="230" width="140" height="122" fill="#fff" stroke="#0a0f3d" stroke-width="3" />
                <rect x="470" y="230" width="110" height="122" fill="#eef0f6" stroke="#0a0f3d" stroke-width="3" />
                <rect x="480" y="262" width="90" height="90" fill="#cfd5e8" />
                <!-- kitchen -->
                <rect x="72" y="296" width="120" height="14" fill="#c7cfee" /><rect x="72" y="310" width="120" height="42" fill="#8f9bd6" /><circle cx="110" cy="290" r="8" fill="#0a0f3d" /><rect x="140" y="250" width="38" height="30" fill="#ffd400" opacity=".7" />
                <!-- bathroom -->
                <rect x="80" y="196" width="100" height="26" rx="12" fill="#bfe3f5" stroke="#0a0f3d" stroke-width="2" /><circle cx="196" cy="150" r="14" fill="#ffd400" />
                <!-- fuse board -->
                <rect x="262" y="268" width="36" height="48" rx="3" fill="#0a0f3d" />{[0, 1, 2, 3].map((i) => <rect x={268 + (i % 2) * 14} y={274 + Math.floor(i / 2) * 14} width="10" height="10" fill="#ffd400" />)}
                <!-- lounge -->
                <rect x="352" y="312" width="90" height="26" rx="8" fill="#1b2bdb" /><path d="M390 232v22" stroke="#0a0f3d" stroke-width="2" /><path d="M376 254h28l-6 12h-16z" fill="#ffd400" />
                <!-- bedroom -->
                <rect x="270" y="188" width="120" height="34" rx="6" fill="#8f9bd6" /><rect x="270" y="176" width="14" height="46" fill="#0a0f3d" /><path d="M420 124v26" stroke="#0a0f3d" stroke-width="2" /><circle cx="420" cy="158" r="10" fill="#ffd400" />
                <!-- garage car -->
                <rect x="486" y="316" width="78" height="26" rx="10" fill="#0a0f3d" /><circle cx="506" cy="344" r="8" fill="#444" /><circle cx="546" cy="344" r="8" fill="#444" /><rect x="474" y="278" width="12" height="22" rx="3" fill="#1fbf6a" />
              </svg>
              <div class="ev-spots" data-spots-wrap>
                {SPOTS.map((s) => <button type="button" class="ev-spot" style={`left:${s.x}%;top:${s.y}%`} data-spot={s.id} aria-pressed={s.id === 'board' ? 'true' : 'false'} aria-label={`${s.name}: ${s.title}`}><span>{s.name}</span></button>)}
              </div>
            </div>
            <div class="ev-jobs" aria-live="polite" data-jobs>
              <p class="ev-jobs__k" data-job-k></p>
              <h3 class="ev-jobs__t" data-job-t></h3>
              <ul class="ev-jobs__list" role="list" data-job-list></ul>
              <p class="ev-jobs__note">Fixed quote before we start. Prices include materials, labour and certification.</p>
              <a href="#book" class="ev-btn ev-btn--blue" data-job-book>Book this job</a>
            </div>
          </div>
        </div>
      </section>

      <!-- =========================== 4 · SAFETY =========================== -->
      <section id="safety" class="ev-section ev-section--blue" aria-labelledby="safety-title">
        <div class="ev-wrap grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
          <div>
            <p class="ev-eyebrow ev-eyebrow--volt">Electrical safety</p>
            <h2 id="safety-title" class="ev-h2 mt-4">Is your <span class="ev-volt">certificate</span> in date?</h2>
            <p class="mt-6 max-w-sm text-lg leading-relaxed text-white/80">An Electrical Installation Condition Report (EICR) checks the wiring in your property. Tell us when yours was last done.</p>
            <ul class="ev-eicr-facts" role="list"><li>1–2 hours for a typical home</li><li>Written report with codes and fixes</li><li>From £149 for a 2-bed flat</li></ul>
          </div>
          <form class="ev-eicr" data-eicr novalidate>
            <fieldset><legend>I am a…</legend>
              <div class="ev-opts">
                <label><input type="radio" name="kind" value="landlord" checked /><span>Landlord</span></label>
                <label><input type="radio" name="kind" value="home" /><span>Homeowner</span></label>
                <label><input type="radio" name="kind" value="biz" /><span>Business</span></label>
              </div>
            </fieldset>
            <div>
              <label for="x-date">Last EICR date</label>
              <input id="x-date" type="date" class="ev-input" aria-describedby="x-msg" />
              <label class="ev-check"><input type="checkbox" data-unknown /><span>I don’t have one / I’m not sure</span></label>
            </div>
            <div class="ev-status" data-status aria-live="polite" data-state="idle">
              <p class="ev-status__t" id="x-msg" data-status-t>Enter a date to check.</p>
              <p class="ev-status__p" data-status-p></p>
              <a href="#book" class="ev-btn ev-btn--volt" data-eicr-book hidden>Book an EICR</a>
            </div>
          </form>
        </div>
      </section>

      <!-- =========================== 5 · EV =========================== -->
      <section id="ev" class="ev-section" aria-labelledby="ev-title">
        <div class="ev-wrap">
          <div class="ev-head"><p class="ev-eyebrow">EV chargers</p><h2 id="ev-title" class="ev-h2">Charge at home. <span class="ev-blue">Keep the difference.</span></h2></div>
          <form class="grid grid-cols-1 items-start gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]" data-evcalc novalidate>
            <div class="ev-panel">
              <div>
                <div class="ev-row"><label for="ev-miles">Miles you drive a month</label><b data-miles-out>800</b></div>
                <input id="ev-miles" class="ev-range" type="range" min="200" max="2000" step="50" value="800" />
              </div>
              <div>
                <div class="ev-row"><label for="ev-share">Charged at home</label><b data-share-out>80%</b></div>
                <input id="ev-share" class="ev-range" type="range" min="0" max="100" step="5" value="80" />
              </div>
              <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div><label for="ev-eff">Your car</label><select id="ev-eff" class="ev-input"><option value="4.2">Small hatchback (4.2 mi/kWh)</option><option value="3.5" selected>Family car (3.5 mi/kWh)</option><option value="2.8">Large SUV (2.8 mi/kWh)</option></select></div>
                <div><label for="ev-tariff">Home tariff</label><select id="ev-tariff" class="ev-input"><option value="28" selected>Standard (28p/kWh)</option><option value="9">Smart overnight (9p/kWh)</option></select></div>
              </div>
              <p class="ev-note">Public rapid charging assumed at 79p/kWh. Figures are illustrative.</p>
            </div>
            <div class="ev-result" aria-live="polite">
              <p class="ev-result__k">You could save</p>
              <p class="ev-result__big"><b data-save-year>£0</b><span>a year</span></p>
              <div class="ev-bars" aria-hidden="true">
                <div><span>All public</span><i><b data-bar-a></b></i><em data-cost-a></em></div>
                <div><span>With a home charger</span><i><b data-bar-b class="is-volt"></b></i><em data-cost-b></em></div>
              </div>
              <p class="ev-result__pay" data-payback></p>
              <a href="#book" class="ev-btn ev-btn--volt ev-btn--lg mt-4" data-ev-book>Get a fixed-price install quote</a>
            </div>
          </form>
        </div>
      </section>

      <!-- =========================== 6 · BOOK =========================== -->
      <section id="book" class="ev-section" aria-labelledby="book-title">
        <div class="ev-wrap">
          <div class="ev-head"><p class="ev-eyebrow">Book a visit</p><h2 id="book-title" class="ev-h2">Tell us the job. <span class="ev-blue">We’ll do the rest.</span></h2></div>
          <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)]">
            <form class="ev-card" data-book novalidate>
              <div class="ev-fields">
                <div class="sm:col-span-2"><label for="b-job">What do you need?</label>
                  <select id="b-job" class="ev-input" data-job>
                    <option value="emergency">Emergency, no power or unsafe</option><option value="fault">Fault finding</option><option value="board">Fuse board upgrade</option><option value="rewire">Rewire</option><option value="ev">EV charger install</option><option value="lighting">Lighting & sockets</option><option value="eicr">EICR safety certificate</option><option value="other">Something else</option>
                  </select></div>
                <div data-when-wrap class="sm:col-span-2">
                  <fieldset><legend>Day</legend><div class="ev-days" data-days></div></fieldset>
                  <fieldset class="mt-4"><legend>Time window</legend><div class="ev-slots" data-slots></div></fieldset>
                </div>
                <p class="ev-emerg sm:col-span-2" data-emerg hidden><b>Emergency:</b> we’ll call you within 5 minutes and send the nearest engineer. No need to pick a time.</p>
                <div><label for="b-name">Full name</label><input id="b-name" class="ev-input" autocomplete="name" data-req aria-describedby="b-name-e" /><p class="ev-err" id="b-name-e" hidden>Please add your name.</p></div>
                <div><label for="b-phone">Mobile</label><input id="b-phone" type="tel" class="ev-input" autocomplete="tel" data-req aria-describedby="b-phone-e" /><p class="ev-err" id="b-phone-e" hidden>Enter a phone number with at least 10 digits.</p></div>
                <div><label for="b-pc">Postcode</label><input id="b-pc" class="ev-input" autocomplete="postal-code" maxlength="9" data-req aria-describedby="b-pc-e" /><p class="ev-err" id="b-pc-e" hidden>Enter a West Midlands postcode, e.g. B1 1BB.</p></div>
                <div class="sm:col-span-2"><label for="b-note">Anything we should know? <span class="opacity-60">(optional)</span></label><textarea id="b-note" class="ev-input min-h-24" data-note></textarea></div>
              </div>
              <p class="ev-err mt-4" role="alert" data-book-err hidden></p>
              <button type="submit" class="ev-btn ev-btn--blue ev-btn--lg mt-6" data-book-btn>Book now</button>
            </form>
            <aside class="ev-sum" data-sum>
              <h3>Your booking</h3>
              <dl><div><dt>Job</dt><dd data-s-job></dd></div><div><dt>When</dt><dd data-s-when></dd></div><div><dt>Call-out</dt><dd data-s-fee></dd></div></dl>
              <ul class="ev-sum__list" role="list"><li>Fixed price agreed before work starts</li><li>Certificate on completion</li><li>12-month workmanship guarantee</li></ul>
            </aside>
            <div class="ev-done lg:col-span-2" data-done hidden tabindex="-1">
              <div class="ev-done__ico" aria-hidden="true">⚡</div>
              <h3 class="ev-h2" style="max-width:none">Booked, <span class="ev-blue" data-done-name></span>.</h3>
              <p class="mt-3 text-lg" data-done-text></p>
              <p class="ev-ref mt-6">Job reference <b data-ref></b></p>
              <button type="button" class="ev-btn ev-btn--blue mt-8" data-again>Make another booking</button>
              <p class="mt-4 text-sm opacity-60">Demo only: nothing was sent.</p>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="ev-footer">
      <div class="ev-wrap flex flex-wrap items-center justify-between gap-4 py-10 text-sm">
        <p class="ev-logo"><span>Volt<em>line</em></span></p>
        <p>A fictional electrician created for Thecore's 100 Days of Web (Day 033). Prices and advice are illustrative. In an emergency always call 999.</p>
      </div>
    </footer>
  </div>
</Landing>

<script>
  import '../../days/day-033/script';
</script>

<style is:global>
/* Contrast fixes from the audit (this page): text now meets WCAG AA (4.5:1, or 3:1 for large text). */
html section#triage > div:nth-child(1) > div:nth-child(2) > div:nth-child(2) > p:nth-child(1) > b:nth-child(1) { color: #e22236 !important; }
</style>
