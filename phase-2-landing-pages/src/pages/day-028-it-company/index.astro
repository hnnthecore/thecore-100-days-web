---
/**
 * Day 028 · IT company landing page · “Stackwell”, managed IT support for growing UK businesses (fictional).
 * Six signature sections: Hero + live ticket console · Services bento · Plan builder · Live status & SLA · Client results · IT health check.
 * Mood: friendly, confident tech. Warm paper, graphite, signal orange; Space Grotesk + JetBrains Mono.
 */
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import Landing from '../../layouts/Landing.astro';
import '../../days/day-028/styles.css';

const SERVICES = [
  { id: 'managed', name: 'Managed IT', text: 'Every laptop, phone and licence looked after for one predictable monthly fee. Patched, monitored and replaced before it fails.', stat: '1,840 devices managed', big: true },
  { id: 'help', name: 'Helpdesk', text: 'Real engineers, answered in under a minute.', stat: '47 s average answer' },
  { id: 'cloud', name: 'Cloud & Microsoft 365', text: 'Migrations without the weekend outage.', stat: '112 migrations' },
  { id: 'sec', name: 'Security essentials', text: 'MFA, endpoint protection, phishing training and Cyber Essentials Plus, wrapped into your plan.', stat: '0 breaches on plan' },
  { id: 'hw', name: 'Hardware & lifecycle', text: 'Ordered, configured, shipped to your people ready to use, and collected when they’re done.', stat: 'Ready in 48 h' },
  { id: 'proj', name: 'Projects & offices', text: 'New office, new Wi-Fi, new everything. Planned, cabled and switched on by one team.', stat: '60 office moves' },
];
const ADDONS = [
  { id: 'h247', name: '24/7 helpdesk', price: 9, text: 'Nights, weekends, bank holidays' },
  { id: 'backup', name: 'Cloud backup', price: 6, text: 'Microsoft 365 + servers, 30-day restore' },
  { id: 'life', name: 'Device lifecycle', price: 11, text: 'Replacement every 4 years, included' },
  { id: 'sec', name: 'Security stack', price: 8, text: 'EDR, DNS filtering, phishing training' },
];
const SYSTEMS = ['Helpdesk phones', 'Remote support', 'Backup vault', 'Monitoring', 'Ticket portal', 'VPN gateway'];
const CASES = [
  { id: 'law', who: 'Harcourt & Lane', kind: 'Law firm · 45 staff', metrics: [['−86%', 'unplanned downtime'], ['92%', 'fixed on first contact'], ['£31k', 'saved per year']], quote: 'We used to dread Mondays. Now nobody thinks about IT, which is exactly the point.', by: 'Managing partner' },
  { id: 'arch', who: 'Studio Fenwick', kind: 'Architects · 22 staff', metrics: [['4×', 'faster file access'], ['100%', 'remote-ready in a week'], ['£12k', 'saved per year']], quote: 'They moved our entire archive to the cloud over a bank holiday. Monday morning, everything just worked.', by: 'Office director' },
  { id: 'care', who: 'Oakleaf Care', kind: 'Care provider · 120 staff', metrics: [['0', 'data incidents in 3 years'], ['38 s', 'average helpdesk answer'], ['£54k', 'saved per year']], quote: 'Rotas, records and phones across nine homes, and a team that answers at 3 am. They’re part of ours.', by: 'Operations lead' },
];
const QUIZ = [
  'Do all staff use multi-factor authentication?',
  'Are your files backed up somewhere other than the office?',
  'Is there a written plan for if a laptop is lost or stolen?',
  'Are laptops and phones updated automatically?',
  'Can someone fix an urgent problem within an hour?',
  'Do you know exactly who has access to what?',
];
---
<Landing
  title="Stackwell · Managed IT support for growing businesses"
  description="Managed IT, helpdesk, cloud and security for UK businesses of 10 to 250 people. Build a plan, check our live status and get a free IT health check. (Day 028 of Thecore's 100 Days of Web, a demo concept.)"
  themeColor="#faf7f2"
  icon="💻"
  day={28}
>
  <div class="sw" data-addons={JSON.stringify(ADDONS)} data-systems={JSON.stringify(SYSTEMS)}>
    <!-- =========================== HEADER =========================== -->
    <header class="sw-header" data-header>
      <div class="sw-wrap flex h-18 items-center justify-between gap-6">
        <a href="#top" class="sw-logo" aria-label="Stackwell, home"><svg viewBox="0 0 28 28" class="size-7" aria-hidden="true"><rect width="28" height="28" rx="8" fill="var(--ink)" /><path d="M7 10h14M7 14h14M7 18h9" stroke="var(--orange)" stroke-width="2.4" stroke-linecap="round" /></svg>Stackwell</a>
        <nav aria-label="Main" class="hidden lg:block">
          <ul class="flex gap-8 text-[15px] font-medium">
            <li><a href="#services">Services</a></li><li><a href="#plan">Pricing</a></li><li><a href="#status">Live status</a></li><li><a href="#results">Results</a></li>
          </ul>
        </nav>
        <a href="#check" class="sw-btn sw-btn--ink whitespace-nowrap">Free health check</a>
      </div>
    </header>

    <main id="main">
      <!-- =========================== 1 · HERO =========================== -->
      <section id="top" class="sw-hero" aria-labelledby="hero-title">
        <div class="sw-wrap grid grid-cols-1 items-center gap-12 pt-14 pb-20 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:pt-20">
          <div>
            <p class="sw-pill"><span class="sw-dot"></span>All systems operational</p>
            <h1 id="hero-title" class="sw-display mt-7">IT support that <span class="sw-mark">actually answers.</span></h1>
            <p class="mt-7 max-w-xl text-lg leading-relaxed text-(--muted)">Stackwell looks after the laptops, cloud and security for growing UK businesses. One monthly fee, real engineers, and a 47-second average answer time.</p>
            <div class="mt-9 flex flex-wrap gap-3">
              <a href="#plan" class="sw-btn sw-btn--orange sw-btn--lg">Build your plan</a>
              <a href="#check" class="sw-btn sw-btn--ghost sw-btn--lg">Free IT health check</a>
            </div>
            <ul class="sw-logos mt-12" role="list" aria-label="Accreditations"><li>Microsoft Solutions Partner</li><li>Cyber Essentials Plus</li><li>ISO 27001</li></ul>
          </div>

          <div class="sw-console" aria-labelledby="console-title">
            <div class="sw-console__bar"><i></i><i></i><i></i><span id="console-title" class="sw-mono">ticket-console</span></div>
            <div class="sw-console__body">
              <p class="text-sm text-white/60">What’s going wrong? Pick one and watch us handle it.</p>
              <div class="sw-chips" role="group" aria-label="Pick a problem" data-issues>
                <button type="button" data-issue="slow">My laptop is crawling</button>
                <button type="button" data-issue="login">Locked out of my account</button>
                <button type="button" data-issue="mail">Email isn’t arriving</button>
                <button type="button" data-issue="start">New starter on Monday</button>
              </div>
              <ol class="sw-log sw-mono" aria-live="polite" data-log><li class="is-idle">Waiting for a ticket…<span class="sw-caret"></span></li></ol>
              <p class="sw-eta" data-eta hidden>Estimated fix <b data-eta-time></b></p>
            </div>
          </div>
        </div>
      </section>

      <!-- =========================== 2 · SERVICES =========================== -->
      <section id="services" class="sw-section" aria-labelledby="services-title">
        <div class="sw-wrap">
          <div class="sw-head"><p class="sw-eyebrow">What we do</p><h2 id="services-title" class="sw-h2">Everything with a plug <span class="sw-mark">or a login.</span></h2></div>
          <ul class="sw-bento" role="list">
            {SERVICES.map((s) => (
              <li class={`sw-card sw-card--${s.id}`}>
                <h3 class="sw-card__t">{s.name}</h3>
                <p class="sw-card__p">{s.text}</p>
                <p class="sw-card__stat sw-mono">{s.stat}</p>
                {s.id === 'managed' && (
                  <ul class="sw-devices sw-mono" role="list" aria-hidden="true">
                    <li><i></i>MBP-0412 · patched 02:14</li><li><i></i>LAT-0377 · encrypted</li><li><i class="warn"></i>LAT-0291 · update queued</li><li><i></i>IPH-0188 · compliant</li><li><i></i>MBP-0420 · patched 02:15</li>
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- =========================== 3 · PLAN =========================== -->
      <section id="plan" class="sw-section sw-section--dark" aria-labelledby="plan-title">
        <div class="sw-wrap">
          <div class="sw-head"><p class="sw-eyebrow sw-eyebrow--orange">Pricing</p><h2 id="plan-title" class="sw-h2">Price it yourself. <span class="sw-mark sw-mark--dark">No call needed.</span></h2></div>
          <form class="grid grid-cols-1 items-start gap-8 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)]" data-plan novalidate>
            <div class="sw-panel">
              <div>
                <div class="sw-row"><label for="p-users">People in your team</label><b class="sw-mono" data-users-out>25</b></div>
                <input id="p-users" class="sw-range" type="range" min="5" max="250" step="1" value="25" data-users />
                <p class="sw-note" data-tier></p>
              </div>
              <fieldset class="mt-8"><legend>Add to the core plan <span class="sw-note">(helpdesk 8–6, device management, patching)</span></legend>
                <div class="sw-addons">
                  {ADDONS.map((a) => (
                    <label class="sw-addon"><input type="checkbox" value={a.id} data-addon /><span><b>{a.name}</b><small>{a.text}</small><em class="sw-mono">+£{a.price}</em></span></label>
                  ))}
                </div>
              </fieldset>
              <label class="sw-switch mt-8"><input type="checkbox" data-annual /><span class="sw-switch__ui" aria-hidden="true"></span><span>Pay annually <em>(save 10%)</em></span></label>
            </div>

            <aside class="sw-quote" aria-live="polite">
              <p class="sw-note">Your monthly price</p>
              <p class="sw-quote__price"><b data-total>£0</b><span>/month</span></p>
              <p class="sw-note"><span data-per>£0</span> per person · billed <span data-bill>monthly</span></p>
              <ul class="sw-quote__list" data-lines></ul>
              <p class="sw-quote__save" data-save></p>
              <a href="#check" class="sw-btn sw-btn--orange sw-btn--lg mt-6 w-full" data-take>Get this plan</a>
            </aside>
          </form>
        </div>
      </section>

      <!-- =========================== 4 · STATUS =========================== -->
      <section id="status" class="sw-section" aria-labelledby="status-title">
        <div class="sw-wrap">
          <div class="sw-head"><p class="sw-eyebrow">Transparency</p><h2 id="status-title" class="sw-h2">Our own uptime, <span class="sw-mark">in public.</span></h2></div>
          <div class="sw-status" data-status></div>
          <p class="sw-statuscap sw-mono" aria-live="polite" data-status-cap>Hover or tap a bar to see the day.</p>
          <div class="sw-sla">
            <div><b>15 min</b><span>P1 response (system down)</span></div>
            <div><b>1 hr</b><span>P2 response (user blocked)</span></div>
            <div><b>4 hrs</b><span>P3 response (how do I…?)</span></div>
            <div><b>99.98%</b><span>helpdesk availability, 90 days</span></div>
          </div>
        </div>
      </section>

      <!-- =========================== 5 · RESULTS =========================== -->
      <section id="results" class="sw-section sw-section--tint" aria-labelledby="results-title">
        <div class="sw-wrap">
          <div class="sw-head"><p class="sw-eyebrow">Client results</p><h2 id="results-title" class="sw-h2">Quieter phones. <span class="sw-mark">Happier Mondays.</span></h2></div>
          <div class="sw-tabs" role="tablist" aria-label="Client stories" data-tabs>
            {CASES.map((c, i) => <button type="button" role="tab" id={`ct-${c.id}`} aria-controls={`cp-${c.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}><b>{c.who}</b><small>{c.kind}</small></button>)}
          </div>
          {CASES.map((c, i) => (
            <div role="tabpanel" id={`cp-${c.id}`} aria-labelledby={`ct-${c.id}`} class="sw-case" hidden={i !== 0}>
              <dl class="sw-metrics">
                {c.metrics.map(([n, l]) => <div><dt>{l}</dt><dd class="sw-mono" data-count={n}>{n}</dd></div>)}
              </dl>
              <figure><blockquote>“{c.quote}”</blockquote><figcaption>{c.who} · {c.by}</figcaption></figure>
            </div>
          ))}
        </div>
      </section>

      <!-- =========================== 6 · HEALTH CHECK =========================== -->
      <section id="check" class="sw-section" aria-labelledby="check-title">
        <div class="sw-wrap">
          <div class="sw-head"><p class="sw-eyebrow">Free IT health check</p><h2 id="check-title" class="sw-h2">Six questions. <span class="sw-mark">One honest score.</span></h2></div>
          <div class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
            <form class="sw-quiz" data-quiz novalidate>
              {QUIZ.map((q, i) => (
                <fieldset class="sw-q"><legend>{i + 1}. {q}</legend>
                  <div class="sw-yn"><label><input type="radio" name={`q${i}`} value="1" /><span>Yes</span></label><label><input type="radio" name={`q${i}`} value="0" /><span>No / not sure</span></label></div>
                </fieldset>
              ))}
            </form>
            <div class="sw-result" aria-live="polite">
              <svg viewBox="0 0 200 120" class="sw-gauge" role="img" aria-label="Health score gauge">
                <path d="M20 110A80 80 0 0 1 180 110" fill="none" stroke="var(--line)" stroke-width="16" stroke-linecap="round" />
                <path d="M20 110A80 80 0 0 1 180 110" fill="none" stroke="var(--orange)" stroke-width="16" stroke-linecap="round" pathLength="100" stroke-dasharray="0 100" data-gauge />
              </svg>
              <p class="sw-result__score"><b data-score>0</b><span>/ 100</span></p>
              <p class="sw-result__label" data-label>Answer the questions to see your score.</p>
              <p class="sw-note" data-tip></p>
              <form class="sw-contact" data-contact novalidate>
                <div><label for="c-name">Name</label><input id="c-name" class="sw-input" autocomplete="name" data-req aria-describedby="c-name-e" /><p class="sw-err" id="c-name-e" hidden>Please add your name.</p></div>
                <div><label for="c-email">Work email</label><input id="c-email" type="email" class="sw-input" autocomplete="email" data-req aria-describedby="c-email-e" /><p class="sw-err" id="c-email-e" hidden>Enter an email like name@company.com.</p></div>
                <button type="submit" class="sw-btn sw-btn--orange sw-btn--lg w-full">Send me the full report</button>
                <p class="sw-ok" role="status" data-ok></p>
              </form>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="sw-footer">
      <div class="sw-wrap flex flex-wrap items-center justify-between gap-4 py-10 text-sm">
        <p class="sw-logo !text-white">Stackwell</p>
        <p>A fictional IT company created for Thecore's 100 Days of Web (Day 028). Prices, clients and figures are demo content.</p>
      </div>
    </footer>
  </div>
</Landing>

<script>
  import '../../days/day-028/script';
</script>

<style is:global>
/* Contrast fixes from the audit (this page): text now meets WCAG AA (4.5:1, or 3:1 for large text). */
html section#top > div:nth-child(1) > div:nth-child(1) > div:nth-child(4) > a:nth-child(1) { color: #15110d !important; }
html section#services > div:nth-child(1) > ul:nth-child(2) > li:nth-child(2) > p:nth-child(3) { color: #d53800 !important; }
html section#services > div:nth-child(1) > ul:nth-child(2) > li:nth-child(3) > p:nth-child(3) { color: #d53800 !important; }
html section#services > div:nth-child(1) > ul:nth-child(2) > li:nth-child(4) > p:nth-child(3) { color: #bc3200 !important; }
html section#services > div:nth-child(1) > ul:nth-child(2) > li:nth-child(5) > p:nth-child(3) { color: #d53800 !important; }
html section#services > div:nth-child(1) > ul:nth-child(2) > li:nth-child(6) > p:nth-child(3) { color: #d53800 !important; }
html section#plan > div:nth-child(1) > form:nth-child(2) > aside:nth-child(2) > a:nth-child(6) { color: #15110d !important; }
html section#check > div:nth-child(1) > div:nth-child(2) > div:nth-child(2) > form:nth-child(5) > button:nth-child(3) { color: #15110d !important; }
html section#plan > div:nth-child(1) > form:nth-child(2) > div:nth-child(1) { background-color: #272930 !important; }
</style>
