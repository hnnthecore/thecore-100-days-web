---
/**
 * Day 032 · Cleaning company landing page · “Lemon & Linen”, home & office cleaning across Yorkshire & Greater Manchester (fictional).
 * Six signature sections: Hero + instant quote · Services & add-ons · Room by room · Book a clean · Team & guarantee · FAQ & callback.
 * Mood: fresh and bubbly. Foam white, mint, lemon and deep teal; rounded shapes, floating bubbles; Outfit.
 */
import '@fontsource-variable/outfit';
import Landing from '../../layouts/Landing.astro';
import { Image } from 'astro:assets';
import photoMop from '../../assets/day-032/mop.jpg';
import photoVac from '../../assets/day-032/vacuum.jpg';
import photoKitchen from '../../assets/day-032/kitchen.jpg';
import photoTeam from '../../assets/day-032/team.jpg';
import '../../days/day-032/styles.css';

const SERVICES = [
  { id: 'regular', name: 'Regular home clean', text: 'The same trusted cleaner every week or fortnight. Your home, always guest-ready.', tag: 'From £19/hour', icon: '🏠' },
  { id: 'deep', name: 'Deep clean', text: 'Inside the oven, behind the fridge, down to the grout. The reset button for your home.', tag: 'From £24/hour', icon: '✨' },
  { id: 'tenancy', name: 'End of tenancy', text: 'Landlord-ready, deposit-back clean with a re-clean guarantee if the agent finds anything.', tag: 'From £26/hour', icon: '🔑' },
  { id: 'office', name: 'Offices & studios', text: 'Early mornings or evenings, with alarm-trained, DBS-checked teams.', tag: 'Custom quote', icon: '💼' },
  { id: 'airbnb', name: 'Holiday lets', text: 'Same-day turnarounds with linen, restocking and photo-proof checklists.', tag: 'Per turnover', icon: '🛎️' },
  { id: 'after', name: 'After-builders', text: 'Plaster dust, paint specks and stickers, gone. Ready to move into.', tag: 'Custom quote', icon: '🧱' },
];
const ADDONS = [
  { id: 'oven', name: 'Oven', price: 25 },
  { id: 'fridge', name: 'Fridge', price: 15 },
  { id: 'windows', name: 'Interior windows', price: 30 },
  { id: 'iron', name: 'Ironing (1 h)', price: 20 },
  { id: 'laundry', name: 'Laundry wash & fold', price: 18 },
  { id: 'cabinets', name: 'Inside cabinets', price: 22 },
];
const ROOMS = [
  { id: 'kitchen', name: 'Kitchen', mins: 35, icon: '🍳', std: ['Worktops and splashbacks wiped', 'Hob and extractor degreased', 'Sink and taps polished', 'Cupboard fronts and handles', 'Floor vacuumed and mopped'], deep: ['Oven inside and out', 'Fridge and freezer emptied and cleaned', 'Inside cupboards', 'Grout and tile scrub'] },
  { id: 'bath', name: 'Bathroom', mins: 30, icon: '🛁', std: ['Toilet, sink and bath scrubbed', 'Shower screen descaled', 'Mirrors and taps polished', 'Bins emptied', 'Floor mopped'], deep: ['Grout scrubbed', 'Extractor fan cleaned', 'Limescale removal on all fittings', 'Tile walls washed'] },
  { id: 'bed', name: 'Bedrooms', mins: 25, icon: '🛏️', std: ['Beds made, fresh linen if left out', 'Surfaces dusted', 'Floors vacuumed', 'Mirrors and glass wiped', 'Bins emptied'], deep: ['Under the bed vacuumed', 'Skirting boards and doors wiped', 'Window sills and frames', 'Mattress vacuumed'] },
  { id: 'living', name: 'Living areas', mins: 30, icon: '🛋️', std: ['Surfaces and shelves dusted', 'Sofas vacuumed', 'Floors vacuumed and mopped', 'Mirrors and glass wiped', 'Cushions plumped'], deep: ['Behind and under furniture', 'Light switches and door frames', 'Cobwebs and ceilings', 'Radiators wiped'] },
];
const TEAM = [
  { name: 'Marta', role: 'Lead cleaner, Leeds', yrs: 7, quote: 'I leave every home better than I’d want to find mine.', c: '#1cc38b' },
  { name: 'James', role: 'Deep clean specialist', yrs: 5, quote: 'Give me limescale and 20 minutes.', c: '#ffd23f' },
  { name: 'Aisha', role: 'Tenancy team lead, Manchester', yrs: 6, quote: 'No agent has ever found a mark. Challenge accepted.', c: '#7fd6f0' },
  { name: 'Dan', role: 'Offices & studios', yrs: 4, quote: 'Invisible by 8 am, spotless by 8:01.', c: '#ff9b85' },
];
const FAQ = [
  ['Do I need to be home?', 'No. Most customers leave a key safe code or a key with us. Every cleaner is DBS-checked, ID-verified and insured for £5m.'],
  ['Do you bring your own supplies?', 'Yes: eco-certified products, microfibre cloths and a HEPA vacuum. If you prefer your own products, just tell us in the notes.'],
  ['What if I’m not happy?', 'Tell us within 24 hours and we’ll send the team back to put it right, free. If it’s still not right, you get a refund.'],
  ['How do I pay?', 'After the clean, by card. We never ask for payment upfront for regular cleans and there’s no contract.'],
  ['Can I get the same cleaner every time?', 'Yes. On weekly and fortnightly plans we assign a regular cleaner and a back-up, so you’re never left without a clean.'],
  ['Which areas do you cover?', 'Leeds, Bradford, York, Harrogate, Wakefield, Halifax, Sheffield and Greater Manchester. Enter your postcode in the quote tool to check.'],
];
---
<Landing
  title="Lemon & Linen · Home & office cleaning in Yorkshire and Manchester"
  description="Instant-quote home cleaning with vetted cleaners and a 24-hour happy-home guarantee. Get a price, pick a slot and book in two minutes. (Day 032 of Thecore's 100 Days of Web, a demo concept.)"
  themeColor="#1cc38b"
  icon="🧽"
  day={32}
>
  <div class="ll" data-addons={JSON.stringify(ADDONS)} data-rooms={JSON.stringify(ROOMS)}>
    <!-- =========================== HEADER =========================== -->
    <header class="ll-header" data-header>
      <div class="ll-wrap flex h-18 items-center justify-between gap-6">
        <a href="#top" class="ll-logo" aria-label="Lemon and Linen, home"><svg viewBox="0 0 32 32" class="size-8" aria-hidden="true"><ellipse cx="16" cy="17" rx="12" ry="10" fill="#ffe45c" /><path d="M16 7c1-3 4-4 6-3-1 3-3 4-6 3z" fill="#1cc38b" /><path d="M9 15q3-4 8-3" stroke="#fff" stroke-width="2" stroke-linecap="round" fill="none" opacity=".7" /></svg>Lemon <em>&</em> Linen</a>
        <nav aria-label="Main" class="hidden lg:block">
          <ul class="flex gap-8 text-[15px] font-medium">
            <li><a href="#rooms">What’s included</a></li><li><a href="#services">Services</a></li><li><a href="#team">Our team</a></li><li><a href="#book">Book</a></li><li><a href="#faq">FAQ</a></li>
          </ul>
        </nav>
        <a href="#top" class="ll-btn ll-btn--lemon whitespace-nowrap">Get a quote</a>
      </div>
    </header>

    <!-- reordered -->
    <main id="main">
      <!-- =========================== 1 · HERO =========================== -->
      <section id="top" class="ll-hero" aria-labelledby="hero-title">
        <div class="ll-bubbles" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
        <div class="ll-wrap relative grid grid-cols-1 items-center gap-12 pt-12 pb-20 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.95fr)] lg:pt-16">
          <div>
            <p class="ll-pill">⭐ 4.9 from 3,100 reviews · Same-week slots</p>
            <h1 id="hero-title" class="ll-display mt-6">A <span class="ll-hl">sparkling</span> home, without lifting a finger.</h1>
            <p class="mt-6 max-w-lg text-lg leading-relaxed text-(--muted)">Vetted local cleaners, eco products and a 24-hour happy-home guarantee. Get an instant price and book in under two minutes.</p>
            <ul class="ll-ticks mt-8" role="list"><li>DBS-checked & insured</li><li>No contracts</li><li>Pay after the clean</li></ul>
          </div>

          <form class="ll-quote" data-quote novalidate aria-labelledby="quote-title">
            <h2 id="quote-title" class="ll-quote__t">Instant quote</h2>
            <div class="ll-quote__grid">
              <div class="sm:col-span-2">
                <label for="q-pc">Postcode</label>
                <input id="q-pc" class="ll-input" placeholder="LS1 4AP" autocomplete="postal-code" maxlength="9" aria-describedby="q-pc-msg" data-pc />
                <p id="q-pc-msg" class="ll-msg" aria-live="polite" data-pc-msg></p>
              </div>
              <div><span id="b-l">Bedrooms</span><div class="ll-stepper" role="group" aria-labelledby="b-l"><button type="button" data-step="beds:-1" aria-label="Fewer bedrooms">−</button><output data-out="beds">2</output><button type="button" data-step="beds:1" aria-label="More bedrooms">+</button></div></div>
              <div><span id="t-l">Bathrooms</span><div class="ll-stepper" role="group" aria-labelledby="t-l"><button type="button" data-step="baths:-1" aria-label="Fewer bathrooms">−</button><output data-out="baths">1</output><button type="button" data-step="baths:1" aria-label="More bathrooms">+</button></div></div>
              <div class="sm:col-span-2"><label for="q-svc">Type of clean</label>
                <select id="q-svc" class="ll-input" data-svc><option value="regular">Regular clean</option><option value="deep">Deep clean</option><option value="tenancy">End of tenancy</option></select></div>
              <fieldset class="sm:col-span-2"><legend>How often?</legend>
                <div class="ll-freq">
                  <label><input type="radio" name="freq" value="once" checked /><span>One-off</span></label>
                  <label><input type="radio" name="freq" value="weekly" /><span>Weekly <em>−20%</em></span></label>
                  <label><input type="radio" name="freq" value="fort" /><span>Fortnightly <em>−15%</em></span></label>
                  <label><input type="radio" name="freq" value="four" /><span>4-weekly <em>−8%</em></span></label>
                </div>
              </fieldset>
            </div>
            <div class="ll-price" aria-live="polite">
              <p class="ll-price__big"><b data-price>£0</b><span data-per>per visit</span></p>
              <p class="ll-price__meta" data-meta></p>
              <p class="ll-price__save" data-save></p>
            </div>
            <a href="#book" class="ll-btn ll-btn--teal ll-btn--lg w-full" data-go>Book this clean</a>
          </form>
        </div>
      </section>

      <div class="ll-wrap ll-band">
        <figure class="ll-band__main"><Image src={photoMop} alt="A woman in yellow gloves mopping the wooden floor of a bright living room" width={1400} /><figcaption>Eco products, always</figcaption></figure>
        <figure><Image src={photoVac} alt="A cleaner in a green polo shirt vacuuming a grey sofa cushion" width={800} /><figcaption>Upholstery refresh</figcaption></figure>
        <figure><Image src={photoKitchen} alt="A bright white kitchen with a gas hob and marble worktops" width={800} /><figcaption>Kitchens that gleam</figcaption></figure>
      </div>

      <!-- =========================== 2 · ROOMS =========================== -->
      <section id="rooms" class="ll-section ll-section--mint" aria-labelledby="rooms-title">
        <div class="ll-wrap">
          <div class="ll-head"><p class="ll-eyebrow">What’s included</p><h2 id="rooms-title" class="ll-h2">Room by room. <span class="ll-hl">Nothing skipped.</span></h2></div>
          <div class="ll-roomtop">
            <div class="ll-tabs" role="tablist" aria-label="Rooms" data-rtabs>
              {ROOMS.map((r, i) => <button type="button" role="tab" id={`rt-${r.id}`} aria-controls="rpanel" aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}><span aria-hidden="true">{r.icon}</span> {r.name}</button>)}
            </div>
            <label class="ll-switch"><input type="checkbox" data-deep /><span class="ll-switch__ui" aria-hidden="true"></span><span>Show deep-clean extras</span></label>
          </div>
          <div id="rpanel" role="tabpanel" class="ll-checklist" aria-live="polite" data-checklist></div>
        </div>
      </section>

      <!-- =========================== 3 · SERVICES =========================== -->
      <section id="services" class="ll-section" aria-labelledby="services-title">
        <div class="ll-wrap">
          <div class="ll-head"><p class="ll-eyebrow">What we clean</p><h2 id="services-title" class="ll-h2">Six ways to get your <span class="ll-hl">weekend back.</span></h2></div>
          <ul class="ll-services" role="list">
            {SERVICES.map((s) => (
              <li class="ll-svc">
                <span class="ll-svc__ico" aria-hidden="true">{s.icon}</span>
                <h3>{s.name}</h3>
                <p>{s.text}</p>
                <p class="ll-svc__tag">{s.tag}</p>
              </li>
            ))}
          </ul>
          <div class="ll-addons">
            <h3 class="ll-addons__t">Add extras to your quote</h3>
            <div class="ll-chips" role="group" aria-label="Optional extras" data-addons-list>
              {ADDONS.map((a) => <button type="button" data-addon={a.id} aria-pressed="false">{a.name} <b>+£{a.price}</b></button>)}
            </div>
            <p class="ll-addons__sum" aria-live="polite" data-addons-sum></p>
          </div>
        </div>
      </section>

      <!-- =========================== 4 · TEAM =========================== -->
      <section id="team" class="ll-section ll-section--teal" aria-labelledby="team-title">
        <div class="ll-wrap">
          <div class="ll-head"><p class="ll-eyebrow ll-eyebrow--lemon">The people</p><h2 id="team-title" class="ll-h2">Cleaners you’d <span class="ll-hl ll-hl--dark">trust with a key.</span></h2></div>
          <dl class="ll-stats">
            <div><dt>Homes cleaned</dt><dd data-count="48000">0</dd></div>
            <div><dt>Average rating</dt><dd data-count="4.9" data-dec="1">0</dd></div>
            <div><dt>Re-clean requests</dt><dd data-count="0.8" data-dec="1" data-suffix="%">0</dd></div>
            <div><dt>Staff retention</dt><dd data-count="91" data-suffix="%">0</dd></div>
          </dl>
          <figure class="ll-teamphoto"><Image src={photoTeam} alt="Three Lemon & Linen cleaners in orange overalls standing in a freshly cleaned living room" width={1200} /></figure>
          <ul class="ll-team" role="list">
            {TEAM.map((t) => (
              <li class="ll-person">
                <svg viewBox="0 0 80 80" class="ll-person__av" role="img" aria-label={`Portrait placeholder for ${t.name}`}><circle cx="40" cy="40" r="40" fill={t.c} /><circle cx="40" cy="32" r="13" fill="#fff" opacity=".9" /><path d="M14 74q4-24 26-24t26 24" fill="#fff" opacity=".9" /></svg>
                <h3>{t.name}</h3>
                <p class="ll-person__role">{t.role} · {t.yrs} yrs with us</p>
                <p class="ll-person__q">“{t.quote}”</p>
              </li>
            ))}
          </ul>
          <ul class="ll-guar" role="list">
            <li><b>Vetted</b>DBS, right-to-work and 2 references</li>
            <li><b>Insured</b>£5m public liability</li>
            <li><b>Eco</b>Plant-based, EU Ecolabel products</li>
            <li><b>24h guarantee</b>Not happy? We re-clean free</li>
          </ul>
        </div>
      </section>

      <!-- =========================== 5 · BOOK =========================== -->
      <section id="book" class="ll-section" aria-labelledby="book-title">
        <div class="ll-wrap">
          <div class="ll-head"><p class="ll-eyebrow">Book a clean</p><h2 id="book-title" class="ll-h2">Pick a slot. <span class="ll-hl">We’ll do the rest.</span></h2></div>
          <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,0.7fr)]" data-booking>
            <form class="ll-card" data-book novalidate>
              <fieldset><legend>1 · Choose a day</legend><div class="ll-days" data-days></div></fieldset>
              <fieldset class="mt-6"><legend>2 · Choose a time</legend><div class="ll-slots" data-slots></div><p class="ll-msg" data-slot-msg aria-live="polite"></p></fieldset>
              <fieldset class="mt-6"><legend>3 · Your details</legend>
                <div class="ll-fields">
                  <div><label for="b-name">Full name</label><input id="b-name" class="ll-input" autocomplete="name" data-req aria-describedby="b-name-e" /><p class="ll-err" id="b-name-e" hidden>Please add your name.</p></div>
                  <div><label for="b-phone">Mobile</label><input id="b-phone" type="tel" class="ll-input" autocomplete="tel" data-req aria-describedby="b-phone-e" /><p class="ll-err" id="b-phone-e" hidden>Enter a phone number with at least 10 digits.</p></div>
                  <div class="sm:col-span-2"><label for="b-email">Email</label><input id="b-email" type="email" class="ll-input" autocomplete="email" data-req aria-describedby="b-email-e" /><p class="ll-err" id="b-email-e" hidden>Enter an email like name@example.com.</p></div>
                  <div class="sm:col-span-2"><label for="b-addr">Address</label><input id="b-addr" class="ll-input" autocomplete="street-address" data-req aria-describedby="b-addr-e" /><p class="ll-err" id="b-addr-e" hidden>Please add your address.</p></div>
                  <div class="sm:col-span-2"><label for="b-access">How do we get in?</label><select id="b-access" class="ll-input"><option>I’ll be home</option><option>Key safe (I’ll send the code)</option><option>Key held by a neighbour</option><option>Concierge / reception</option></select></div>
                </div>
              </fieldset>
              <p class="ll-err mt-4" role="alert" data-book-err hidden></p>
              <button type="submit" class="ll-btn ll-btn--teal ll-btn--lg mt-6">Confirm booking</button>
            </form>

            <aside class="ll-sum" aria-label="Booking summary" data-sum>
              <h3>Your clean</h3>
              <dl class="ll-sum__list">
                <div><dt>Service</dt><dd data-s-svc></dd></div>
                <div><dt>Home</dt><dd data-s-home></dd></div>
                <div><dt>Team</dt><dd data-s-team></dd></div>
                <div><dt>When</dt><dd data-s-when>Not chosen</dd></div>
                <div><dt>Repeats</dt><dd data-s-freq></dd></div>
                <div><dt>Extras</dt><dd data-s-extras>None</dd></div>
              </dl>
              <p class="ll-sum__total"><span>Per visit</span><b data-s-price>£0</b></p>
              <p class="ll-sum__note">Pay after the clean. Free rebooking up to 24 hours before.</p>
            </aside>

            <div class="ll-done lg:col-span-2" data-done hidden tabindex="-1">
              <div class="ll-done__ico" aria-hidden="true">✨</div>
              <h3 class="ll-h2" style="max-width:none">You’re booked, <span class="ll-hl" data-done-name></span>!</h3>
              <p class="mt-3 text-lg" data-done-text></p>
              <p class="ll-ref mt-6">Reference <b data-ref></b></p>
              <button type="button" class="ll-btn ll-btn--lemon mt-8" data-again>Book another</button>
              <p class="mt-4 text-sm opacity-60">Demo only: nothing was sent or charged.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- =========================== 6 · FAQ =========================== -->
      <section id="faq" class="ll-section" aria-labelledby="faq-title">
        <div class="ll-wrap grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
          <div>
            <div class="ll-head"><p class="ll-eyebrow">Questions</p><h2 id="faq-title" class="ll-h2">Good to <span class="ll-hl">know.</span></h2></div>
            <div class="ll-faq">
              {FAQ.map(([q, a], i) => (
                <details name="faq" open={i === 0}><summary>{q}</summary><p>{a}</p></details>
              ))}
            </div>
          </div>
          <form class="ll-call" data-call novalidate>
            <h3>Prefer a chat?</h3>
            <p class="text-(--muted)">Leave your number and we’ll call you back within 15 minutes, 8 am to 8 pm.</p>
            <div class="mt-5 grid gap-4">
              <div><label for="c-name">Name</label><input id="c-name" class="ll-input" autocomplete="name" data-creq aria-describedby="c-name-e" /><p class="ll-err" id="c-name-e" hidden>Please add your name.</p></div>
              <div><label for="c-phone">Phone</label><input id="c-phone" type="tel" class="ll-input" autocomplete="tel" data-creq aria-describedby="c-phone-e" /><p class="ll-err" id="c-phone-e" hidden>Enter a phone number with at least 10 digits.</p></div>
              <div><label for="c-when">Best time</label><select id="c-when" class="ll-input"><option>As soon as possible</option><option>Morning</option><option>Afternoon</option><option>Evening</option></select></div>
              <button type="submit" class="ll-btn ll-btn--teal ll-btn--lg">Call me back</button>
              <p class="ll-ok" role="status" data-call-ok></p>
            </div>
          </form>
        </div>
      </section>
    </main>

    <footer class="ll-footer">
      <div class="ll-wrap flex flex-wrap items-center justify-between gap-4 py-10 text-sm">
        <p class="ll-logo">Lemon <em>&</em> Linen</p>
        <p>A fictional cleaning company created for Thecore's 100 Days of Web (Day 032). Prices, people and reviews are demo content.</p>
      </div>
    </footer>
  </div>
</Landing>

<script>
  import '../../days/day-032/script';
</script>
