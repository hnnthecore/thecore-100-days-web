---
/**
 * Day 036 · Real estate agency landing page · “Latch & Lane”, estate & letting agents in Greater Manchester (fictional).
 * Six signature sections: Hero + search · Listings with live map · Mortgage affordability · Home valuation · Neighbourhood guide · Book a viewing.
 * Mood: warm editorial. Cream, ink navy, coral and sage; Playfair Display + Plus Jakarta Sans.
 */
import '@fontsource-variable/playfair-display';
import '@fontsource-variable/playfair-display/wght-italic.css';
import '@fontsource-variable/plus-jakarta-sans';
import Landing from '../../layouts/Landing.astro';
import { Image } from 'astro:assets';
import photoLiving from '../../assets/day-036/hero-living.jpg';
import listing_s1 from '../../assets/day-036/listing-s1.jpg';
import listing_s2 from '../../assets/day-036/listing-s2.jpg';
import listing_s3 from '../../assets/day-036/listing-s3.jpg';
import listing_s4 from '../../assets/day-036/listing-s4.jpg';
import listing_s5 from '../../assets/day-036/listing-s5.jpg';
import listing_r1 from '../../assets/day-036/listing-r1.jpg';
import listing_r2 from '../../assets/day-036/listing-r2.jpg';
import listing_r3 from '../../assets/day-036/listing-r3.jpg';
import listing_r4 from '../../assets/day-036/listing-r4.jpg';
const LISTING_PHOTOS: Record<string, any> = { s1: listing_s1, s2: listing_s2, s3: listing_s3, s4: listing_s4, s5: listing_s5, r1: listing_r1, r2: listing_r2, r3: listing_r3, r4: listing_r4 };
import { home } from '../../days/day-036/art';
import '../../days/day-036/styles.css';

const AREAS = ['Ancoats', 'Chorlton', 'Didsbury', 'Salford Quays', 'Prestwich'];
const PROPS = [
  { id: 's1', mode: 'buy', title: 'Victorian terrace', area: 'Chorlton', kind: 'terrace', price: 385000, beds: 3, baths: 2, sqft: 1240, tag: 'New', epc: 'C', x: 36, y: 72, wall: '#e8d3b9', roof: '#7a4a3a' },
  { id: 's2', mode: 'buy', title: 'Penthouse apartment', area: 'Ancoats', kind: 'flat', price: 525000, beds: 2, baths: 2, sqft: 980, tag: '', epc: 'B', x: 58, y: 30, wall: '#d8dce4', roof: '#14213d' },
  { id: 's3', mode: 'buy', title: 'Semi-detached family home', area: 'Didsbury', kind: 'house', price: 695000, beds: 4, baths: 3, sqft: 1870, tag: 'Reduced', epc: 'C', x: 48, y: 88, wall: '#efe3cf', roof: '#3d5a80' },
  { id: 's4', mode: 'buy', title: 'Waterside apartment', area: 'Salford Quays', kind: 'flat', price: 265000, beds: 2, baths: 1, sqft: 760, tag: '', epc: 'B', x: 20, y: 40, wall: '#cfd9e6', roof: '#2f4b73' },
  { id: 's5', mode: 'buy', title: 'Detached bungalow', area: 'Prestwich', kind: 'bungalow', price: 340000, beds: 2, baths: 1, sqft: 1010, tag: 'New', epc: 'D', x: 50, y: 9, wall: '#f0dcc4', roof: '#8a4b3a' },
  { id: 'r1', mode: 'rent', title: 'Loft apartment', area: 'Ancoats', kind: 'flat', price: 1650, beds: 1, baths: 1, sqft: 640, tag: '', epc: 'B', x: 63, y: 36, wall: '#e3d5c3', roof: '#14213d' },
  { id: 'r2', mode: 'rent', title: 'Garden flat', area: 'Chorlton', kind: 'terrace', price: 1350, beds: 2, baths: 1, sqft: 820, tag: 'New', epc: 'C', x: 30, y: 66, wall: '#d6e0cf', roof: '#6b4a3d' },
  { id: 'r3', mode: 'rent', title: 'Modern townhouse', area: 'Salford Quays', kind: 'townhouse', price: 2200, beds: 3, baths: 2, sqft: 1320, tag: '', epc: 'B', x: 26, y: 46, wall: '#e9d9c4', roof: '#2f4b73' },
  { id: 'r4', mode: 'rent', title: 'Family house', area: 'Prestwich', kind: 'house', price: 1900, beds: 3, baths: 2, sqft: 1450, tag: 'Let agreed', epc: 'C', x: 44, y: 15, wall: '#efe3cf', roof: '#8a4b3a' },
];
const HOODS = [
  { id: 'Ancoats', blurb: 'Converted mills, indie cafés and the city centre ten minutes’ walk away.', price: 345000, rent: 1650, commute: 10, schools: 3.5, green: 3, night: 5, tags: ['Foodie', 'Young professionals', 'Walkable'] },
  { id: 'Chorlton', blurb: 'Leafy Victorian streets, independent shops and a village feel with a tram into town.', price: 410000, rent: 1450, commute: 18, schools: 4.5, green: 4.5, night: 4, tags: ['Families', 'Independent shops', 'Parks'] },
  { id: 'Didsbury', blurb: 'Large homes, top-rated schools and one of the area’s best high streets.', price: 620000, rent: 1900, commute: 22, schools: 5, green: 4, night: 3.5, tags: ['Families', 'Schools', 'Restaurants'] },
  { id: 'Salford Quays', blurb: 'Waterfront apartments, MediaCityUK and the quickest commutes to the BBC and the theatre.', price: 280000, rent: 1500, commute: 14, schools: 3.5, green: 3.5, night: 3.5, tags: ['Waterside', 'Media', 'Modern'] },
  { id: 'Prestwich', blurb: 'Good-value family homes, big green spaces and fast links north and into the city.', price: 335000, rent: 1450, commute: 25, schools: 4, green: 4.5, night: 2.5, tags: ['Value', 'Green space', 'Quiet'] },
];
---
<Landing
  title="Latch & Lane · Estate & letting agents, Greater Manchester"
  description="Homes to buy and rent across Manchester and Salford. Search with a live map, check what you can afford, value your home and book a viewing. (Day 036 of Thecore's 100 Days of Web, a demo concept.)"
  themeColor="#14213d"
  icon="🏡"
  day={36}
>
  <div class="ll" data-props={JSON.stringify(PROPS)} data-hoods={JSON.stringify(HOODS)}>
    <!-- =========================== HEADER =========================== -->
    <header class="ll-header" data-header>
      <div class="ll-wrap flex h-18 items-center justify-between gap-6">
        <a href="#top" class="ll-logo" aria-label="Latch and Lane, home"><svg viewBox="0 0 32 32" class="size-8" aria-hidden="true"><path d="M4 15 16 4l12 11v13H4z" fill="var(--coral)" /><rect x="13" y="17" width="6" height="11" rx="1.5" fill="var(--ink)" /></svg><span>Latch <em>&</em> Lane</span></a>
        <nav aria-label="Main" class="hidden lg:block">
          <ul class="flex gap-8 text-[15px] font-semibold">
            <li><a href="#homes">Homes</a></li><li><a href="#afford">Affordability</a></li><li><a href="#value">Valuation</a></li><li><a href="#areas">Areas</a></li>
          </ul>
        </nav>
        <a href="#viewing" class="ll-btn ll-btn--coral whitespace-nowrap">Book a viewing</a>
      </div>
    </header>

    <main id="main">
      <!-- =========================== 1 · HERO =========================== -->
      <section id="top" class="ll-hero" aria-labelledby="hero-title">
        <div class="ll-wrap grid grid-cols-1 items-center gap-12 pt-12 pb-20 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:pt-16">
          <div>
            <p class="ll-eyebrow">Manchester & Salford · Est. 2009</p>
            <h1 id="hero-title" class="ll-display mt-6">Find the place <em>you’ll love</em> coming home to.</h1>
            <p class="mt-6 max-w-lg text-lg leading-relaxed text-(--muted)">Independent agents who know every street. Search live listings, see them on the map and book a viewing in a couple of taps.</p>
            <form class="ll-search" data-search novalidate aria-label="Property search">
              <div class="ll-modes" role="group" aria-label="Buy or rent">
                <button type="button" data-mode="buy" aria-pressed="true">Buy</button>
                <button type="button" data-mode="rent" aria-pressed="false">Rent</button>
              </div>
              <div><label for="h-area">Area</label><select id="h-area" class="ll-input"><option value="all">All areas</option>{AREAS.map((a) => <option>{a}</option>)}</select></div>
              <div><label for="h-beds">Bedrooms</label><select id="h-beds" class="ll-input"><option value="0">Any</option><option value="1">1+</option><option value="2">2+</option><option value="3">3+</option><option value="4">4+</option></select></div>
              <button type="submit" class="ll-btn ll-btn--ink" data-search-btn>Search</button>
            </form>
            <dl class="ll-stats"><div><dt>Average days to sell</dt><dd>24</dd></div><div><dt>Asking price achieved</dt><dd>98.6%</dd></div><div><dt>Five-star reviews</dt><dd>1,940</dd></div></dl>
          </div>
          <div class="ll-arch" aria-hidden="true">
            <div class="ll-arch__img"><Image src={photoLiving} alt="" width={800} class="ll-arch__photo" loading="eager" /></div>
            <p class="ll-arch__card"><b>Just listed</b><span>Didsbury · 4 bed · £695,000</span></p>
          </div>
        </div>
      </section>

      <!-- =========================== 2 · LISTINGS =========================== -->
      <section id="homes" class="ll-section" aria-labelledby="homes-title">
        <div class="ll-wrap">
          <div class="ll-head"><p class="ll-eyebrow">Properties</p><h2 id="homes-title" class="ll-h2">Homes on the <em>map.</em></h2></div>
          <form class="ll-filters" data-filters novalidate>
            <div class="ll-modes" role="group" aria-label="Buy or rent" data-modes2>
              <button type="button" data-mode="buy" aria-pressed="true">For sale</button>
              <button type="button" data-mode="rent" aria-pressed="false">To rent</button>
            </div>
            <div><label for="f-area">Area</label><select id="f-area" class="ll-input"><option value="all">All areas</option>{AREAS.map((a) => <option>{a}</option>)}</select></div>
            <div><label for="f-beds">Bedrooms</label><select id="f-beds" class="ll-input"><option value="0">Any</option><option value="1">1+</option><option value="2">2+</option><option value="3">3+</option><option value="4">4+</option></select></div>
            <div><label for="f-price">Max <span data-pl>price</span>: <b data-price-out>£800,000</b></label><input id="f-price" class="ll-range" type="range" /></div>
            <div><label for="f-sort">Sort</label><select id="f-sort" class="ll-input"><option value="new">Newest</option><option value="asc">Price: low to high</option><option value="desc">Price: high to low</option></select></div>
          </form>
          <p class="ll-count" aria-live="polite" data-count></p>
          <div class="ll-split">
            <ul class="ll-list" role="list" data-list>
              {PROPS.map((p) => (
                <li class="ll-prop" data-prop={p.id} data-mode={p.mode} tabindex="-1">
                  <div class="ll-prop__img"><Image src={LISTING_PHOTOS[p.id]} alt={`${p.title} in ${p.area}`} width={700} class="ll-prop__photo" /></div>
                  {p.tag && <span class={`ll-prop__tag${p.tag === 'Let agreed' ? ' is-let' : ''}`}>{p.tag}</span>}
                  <button type="button" class="ll-heart" data-heart={p.id} aria-pressed="false" aria-label={`Save ${p.title}, ${p.area}`}>♥</button>
                  <div class="ll-prop__body">
                    <p class="ll-prop__price">£{p.price.toLocaleString('en-GB')}{p.mode === 'rent' && <small> pcm</small>}</p>
                    <h3 class="ll-prop__title">{p.title}</h3>
                    <p class="ll-prop__area">{p.area}</p>
                    <ul class="ll-prop__spec" role="list"><li>{p.beds} bed</li><li>{p.baths} bath</li><li>{p.sqft.toLocaleString('en-GB')} sq ft</li><li>EPC {p.epc}</li></ul>
                    <a href="#viewing" class="ll-link" data-view={p.id}>{p.tag === 'Let agreed' ? 'Join the waiting list' : 'Book a viewing'} →</a>
                  </div>
                </li>
              ))}
            </ul>
            <div class="ll-mapwrap">
              <div class="ll-map" data-map>
                <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                  <rect width="100" height="100" fill="#e9efe3" />
                  <path d="M0 62C14 52 24 58 36 46S60 38 72 24 94 10 100 6V0H0z" fill="#e1e9db" />
                  <path d="M0 34C12 30 18 42 30 38S52 22 64 20 90 22 100 16" fill="none" stroke="#a9cfe3" stroke-width="3.2" stroke-linecap="round" />
                  <path d="M-2 44C10 44 14 52 22 50" fill="none" stroke="#a9cfe3" stroke-width="2" />
                  <ellipse cx="14" cy="42" rx="7" ry="3.2" fill="#bcdcec" />
                  <ellipse cx="44" cy="62" rx="9" ry="6" fill="#c3dcb4" /><ellipse cx="72" cy="78" rx="10" ry="7" fill="#c3dcb4" /><ellipse cx="22" cy="86" rx="8" ry="5" fill="#c3dcb4" /><ellipse cx="70" cy="12" rx="9" ry="5" fill="#c3dcb4" />
                  <path d="M0 80H100M0 55H100M30 0V100M60 0V100M80 0V100M45 20L85 100M10 100L40 30" stroke="#fff" stroke-width="1.1" opacity=".9" />
                  <path d="M0 22L100 40M58 0 52 100" stroke="#fff" stroke-width="1.8" />
                </svg>
                {AREAS.map((a, i) => <span class="ll-map__label" style={`left:${[58, 34, 46, 18, 50][i]}%;top:${[24, 58, 80, 30, 2][i] + (i === 4 ? 12 : 0)}%`}>{a}</span>)}
                <div class="ll-pins" data-pins></div>
              </div>
              <p class="ll-map__note">Stylised map, not to scale. Tap a price to jump to the home.</p>
            </div>
          </div>
          <p class="ll-empty" data-empty hidden>No homes match. Try a higher budget or fewer bedrooms.</p>
        </div>
      </section>

      <!-- =========================== 3 · AFFORD =========================== -->
      <section id="afford" class="ll-section ll-section--ink" aria-labelledby="afford-title">
        <div class="ll-wrap">
          <div class="ll-head"><p class="ll-eyebrow ll-eyebrow--light">Affordability</p><h2 id="afford-title" class="ll-h2">What can you <em>really</em> afford?</h2></div>
          <form class="grid grid-cols-1 items-start gap-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)]" data-afford novalidate>
            <div class="ll-panel">
              <fieldset><legend>Buying</legend>
                <div class="ll-opts">
                  <label><input type="radio" name="who" value="1" checked /><span>On my own</span></label>
                  <label><input type="radio" name="who" value="2" /><span>With a partner</span></label>
                </div>
              </fieldset>
              <div><div class="ll-row"><label for="a-inc">Household income (before tax)</label><b data-inc-out>£55,000</b></div><input id="a-inc" class="ll-range" type="range" min="20000" max="200000" step="1000" value="75000" /></div>
              <div><div class="ll-row"><label for="a-dep">Deposit saved</label><b data-dep-out>£40,000</b></div><input id="a-dep" class="ll-range" type="range" min="0" max="200000" step="2500" value="50000" /></div>
              <div><div class="ll-row"><label for="a-debt">Monthly debts (loans, cards, car)</label><b data-debt-out>£150</b></div><input id="a-debt" class="ll-range" type="range" min="0" max="1500" step="25" value="150" /></div>
              <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div><label for="a-rate">Mortgage rate</label><select id="a-rate" class="ll-input ll-input--dark"><option value="3.9">3.9% (2-year fix, 40% deposit)</option><option value="4.6" selected>4.6% (5-year fix)</option><option value="5.4">5.4% (stress test)</option></select></div>
                <div><label for="a-term">Term</label><select id="a-term" class="ll-input ll-input--dark"><option value="25">25 years</option><option value="30" selected>30 years</option><option value="35">35 years</option></select></div>
              </div>
            </div>
            <div class="ll-result" aria-live="polite">
              <p class="ll-result__k">You could buy up to</p>
              <p class="ll-result__big" data-budget>£0</p>
              <dl class="ll-result__rows">
                <div><dt>Mortgage you could get</dt><dd data-loan></dd></div>
                <div><dt>Monthly repayment</dt><dd data-monthly></dd></div>
                <div><dt>Deposit as % of price</dt><dd data-ltv></dd></div>
                <div><dt>Homes for sale you can afford</dt><dd data-afford-n></dd></div>
              </dl>
              <p class="ll-result__note" data-afford-note></p>
              <button type="button" class="ll-btn ll-btn--coral ll-btn--lg w-full" data-show-homes>Show me these homes</button>
              <p class="ll-fine">An illustrative guide using typical lender multiples (4.5× income, less debts). It is not a mortgage offer or advice.</p>
            </div>
          </form>
        </div>
      </section>

      <!-- =========================== 4 · VALUE =========================== -->
      <section id="value" class="ll-section" aria-labelledby="value-title">
        <div class="ll-wrap grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
          <div>
            <p class="ll-eyebrow">Free valuation</p>
            <h2 id="value-title" class="ll-h2 mt-4">What’s your home <em>worth?</em></h2>
            <p class="mt-6 max-w-sm text-lg leading-relaxed text-(--muted)">A quick estimate in seconds, then a free visit from a local agent to give you the real figure.</p>
            <form class="ll-vform" data-value novalidate>
              <div><label for="v-pc">Postcode</label><input id="v-pc" class="ll-input" placeholder="M20 2WN" autocomplete="postal-code" maxlength="9" aria-describedby="v-pc-e" /><p class="ll-err" id="v-pc-e" hidden></p></div>
              <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
                <div><label for="v-kind">Type</label><select id="v-kind" class="ll-input"><option value="house">House</option><option value="terrace">Terrace</option><option value="flat">Flat</option><option value="bungalow">Bungalow</option></select></div>
                <div><label for="v-beds">Bedrooms</label><select id="v-beds" class="ll-input"><option>1</option><option>2</option><option selected>3</option><option>4</option><option>5</option></select></div>
                <div><label for="v-cond">Condition</label><select id="v-cond" class="ll-input"><option value="1.08">Refurbished</option><option value="1" selected>Good</option><option value="0.88">Needs updating</option></select></div>
              </div>
              <button type="submit" class="ll-btn ll-btn--ink ll-btn--lg">Get my estimate</button>
            </form>
          </div>
          <div class="ll-est" data-est hidden aria-live="polite">
            <p class="ll-est__k" data-est-area></p>
            <p class="ll-est__big" data-est-range></p>
            <p class="ll-est__sub" data-est-sub></p>
            <svg viewBox="0 0 300 100" class="ll-spark" role="img" aria-label="Local price trend over 12 months" preserveAspectRatio="none"><defs><linearGradient id="sg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ff6b5b" stop-opacity=".35" /><stop offset="1" stop-color="#ff6b5b" stop-opacity="0" /></linearGradient></defs><path data-spark-area fill="url(#sg)" /><path data-spark-line fill="none" stroke="#ff6b5b" stroke-width="3" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke" /></svg>
            <div class="ll-est__meta"><span>12 months ago</span><b data-trend></b><span>Today</span></div>
            <a href="#viewing" class="ll-btn ll-btn--coral" data-est-go>Book a free valuation visit</a>
          </div>
          <div class="ll-est ll-est--empty" data-est-empty><p>Enter your postcode and we’ll show an estimate with the local price trend.</p></div>
        </div>
      </section>

      <!-- =========================== 5 · AREAS =========================== -->
      <section id="areas" class="ll-section ll-section--sage" aria-labelledby="areas-title">
        <div class="ll-wrap">
          <div class="ll-head"><p class="ll-eyebrow">Neighbourhood guide</p><h2 id="areas-title" class="ll-h2">Where <em>should</em> you live?</h2></div>
          <div class="ll-tabs" role="tablist" aria-label="Areas" data-tabs>
            {HOODS.map((h, i) => <button type="button" role="tab" id={`at-${i}`} aria-controls="area-panel" aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{h.id}</button>)}
          </div>
          <div id="area-panel" role="tabpanel" class="ll-hood" aria-live="polite" data-hood></div>
        </div>
      </section>

      <!-- =========================== 6 · VIEWING =========================== -->
      <section id="viewing" class="ll-section" aria-labelledby="viewing-title">
        <div class="ll-wrap">
          <div class="ll-head"><p class="ll-eyebrow">Book a viewing</p><h2 id="viewing-title" class="ll-h2">See it <em>in person.</em></h2></div>
          <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)]">
            <form class="ll-card" data-book novalidate>
              <div class="ll-fields">
                <div class="sm:col-span-2"><label for="b-prop">What would you like to see?</label>
                  <select id="b-prop" class="ll-input" data-prop-sel>
                    {PROPS.filter((p) => p.tag !== 'Let agreed').map((p) => <option value={p.id}>{p.title}, {p.area} · £{p.price.toLocaleString('en-GB')}{p.mode === 'rent' ? ' pcm' : ''}</option>)}
                    <option value="valuation">A free valuation of my own home</option>
                  </select></div>
                <fieldset class="sm:col-span-2"><legend>Day</legend><div class="ll-days" data-days></div></fieldset>
                <fieldset class="sm:col-span-2"><legend>Time</legend><div class="ll-slots" data-slots></div></fieldset>
                <div><label for="b-status">Your position</label><select id="b-status" class="ll-input"><option>First-time buyer</option><option>Selling first</option><option>Chain-free / cash</option><option>Investor</option><option>Renting</option></select></div>
                <div><label for="b-name">Full name</label><input id="b-name" class="ll-input" autocomplete="name" data-req aria-describedby="b-name-e" /><p class="ll-err" id="b-name-e" hidden>Please add your name.</p></div>
                <div><label for="b-phone">Mobile</label><input id="b-phone" type="tel" class="ll-input" autocomplete="tel" data-req aria-describedby="b-phone-e" /><p class="ll-err" id="b-phone-e" hidden>Enter a phone number with at least 10 digits.</p></div>
                <div><label for="b-email">Email</label><input id="b-email" type="email" class="ll-input" autocomplete="email" data-req aria-describedby="b-email-e" /><p class="ll-err" id="b-email-e" hidden>Enter an email like name@example.com.</p></div>
                <div class="sm:col-span-2"><label for="b-note">Anything we should know? <span class="opacity-60">(optional)</span></label><textarea id="b-note" class="ll-input min-h-20" data-note></textarea></div>
              </div>
              <p class="ll-err mt-4" role="alert" data-book-err hidden></p>
              <button type="submit" class="ll-btn ll-btn--coral ll-btn--lg mt-6">Request viewing</button>
            </form>
            <aside class="ll-sum" data-sum>
              <div class="ll-sum__img" data-sum-img></div>
              <div class="ll-sum__body"><h3 data-sum-title></h3><p data-sum-area class="ll-sum__area"></p>
                <dl><div><dt>Price</dt><dd data-sum-price></dd></div><div><dt>When</dt><dd data-sum-when>Not chosen</dd></div></dl>
                <p class="ll-sum__note">A Latch & Lane negotiator will meet you there. Allow 30 minutes.</p></div>
            </aside>
            <div class="ll-done lg:col-span-2" data-done hidden tabindex="-1">
              <div class="ll-done__ico" aria-hidden="true">🏡</div>
              <h3 class="ll-h2" style="max-width:none">Viewing requested, <em data-done-name></em>.</h3>
              <p class="mt-3 text-lg" data-done-text></p>
              <p class="ll-ref mt-6">Reference <b data-ref></b></p>
