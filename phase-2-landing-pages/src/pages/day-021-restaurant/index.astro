---
/**
 * Day 021 · Restaurant landing page · “Sol y Sal”, a modern Mexican kitchen & mezcal bar.
 * Six signature sections: Hero · Menu · Story · Experiences · Reviews · Booking.
 * Content is rendered at build time (fast, SEO-friendly); script.ts adds the interactions.
 */
import Landing from '../../layouts/Landing.astro';
import Illo from '../../components/day-021/Illo.astro';
import dish01 from '../../assets/day-021/dish-01.jpg';
import dish02 from '../../assets/day-021/dish-02.jpg';
import dish03 from '../../assets/day-021/dish-03.jpg';
import dish04 from '../../assets/day-021/dish-04.jpg';
import dish05 from '../../assets/day-021/dish-05.jpg';
import dish06 from '../../assets/day-021/dish-06.jpg';
import dish07 from '../../assets/day-021/dish-07.jpg';
import dish08 from '../../assets/day-021/dish-08.jpg';
import dish09 from '../../assets/day-021/dish-09.jpg';
import dish10 from '../../assets/day-021/dish-10.jpg';
import dish11 from '../../assets/day-021/dish-11.jpg';
import dish12 from '../../assets/day-021/dish-12.jpg';
import dish13 from '../../assets/day-021/dish-13.jpg';
import dish14 from '../../assets/day-021/dish-14.jpg';
import dish15 from '../../assets/day-021/dish-15.jpg';
import dish16 from '../../assets/day-021/dish-16.jpg';
const DISH_PHOTOS = [dish01, dish02, dish03, dish04, dish05, dish06, dish07, dish08, dish09, dish10, dish11, dish12, dish13, dish14, dish15, dish16];
import { Image } from 'astro:assets';
import photoTacos from '../../assets/day-021/tacos-plate.jpg';
import photoSpread from '../../assets/day-021/table-guacamole.jpg';
import photoAgave from '../../assets/day-021/agave-field.jpg';
import photoBeef from '../../assets/day-021/tacos-beef.jpg';
import '../../days/day-021/styles.css';

const NAV = [['#menu', 'Menu'], ['#story', 'Our story'], ['#experiences', 'Experiences'], ['#reviews', 'Reviews'], ['#visit', 'Visit']];

type Dish = { cat: string; name: string; desc: string; price: number; tags: string[]; heat: number; illo: string; tint: string; signature?: boolean };
const DISHES: Dish[] = [
  { cat: 'tacos', name: 'Al pastor', desc: 'Achiote pork from the trompo, charred pineapple, salsa verde', price: 9, tags: ['gf'], heat: 1, illo: 'taco', tint: 'var(--marigold)', signature: true },
  { cat: 'tacos', name: 'Baja fish', desc: 'Beer-battered hake, chipotle crema, pink pickled onion', price: 10, tags: [], heat: 1, illo: 'taco', tint: 'var(--sky)' },
  { cat: 'tacos', name: 'Hongos', desc: 'Wood-roasted oyster mushrooms, black bean, salsa macha', price: 8, tags: ['veg', 'vegan', 'gf'], heat: 2, illo: 'taco', tint: 'var(--agave-2)' },
  { cat: 'tacos', name: 'Birria', desc: 'Slow-braised beef, melted Oaxaca cheese, dipping consommé', price: 11, tags: ['gf'], heat: 2, illo: 'taco', tint: 'var(--chili)', signature: true },
  { cat: 'tacos', name: 'Coliflor', desc: 'Charred cauliflower, pipián verde, toasted pepitas', price: 8, tags: ['veg', 'vegan', 'gf'], heat: 0, illo: 'taco', tint: 'var(--cream)' },
  { cat: 'platos', name: 'Guacamole & totopos', desc: 'Smashed to order with lime, serrano and pomegranate', price: 9, tags: ['veg', 'vegan', 'gf'], heat: 1, illo: 'guac', tint: 'var(--agave-2)' },
  { cat: 'platos', name: 'Elote callejero', desc: 'Flame-grilled corn, chipotle mayo, cotija, tajín', price: 7, tags: ['veg', 'gf'], heat: 1, illo: 'elote', tint: 'var(--marigold)' },
  { cat: 'platos', name: 'Tostada de atún', desc: 'Yellowfin tuna, avocado, habanero ponzu, crispy leek', price: 13, tags: ['gf'], heat: 3, illo: 'tostada', tint: 'var(--pink)', signature: true },
  { cat: 'platos', name: 'Mole bowl', desc: 'Thirty-ingredient mole negro, chicken thigh, red rice', price: 16, tags: [], heat: 1, illo: 'bowl', tint: 'var(--cobalt)' },
  { cat: 'dulces', name: 'Churros', desc: 'Cinnamon sugar, Oaxacan chocolate & cajeta for dipping', price: 7, tags: ['veg'], heat: 0, illo: 'churros', tint: 'var(--pink)', signature: true },
  { cat: 'dulces', name: 'Paleta de mango', desc: 'Mango, lime & chamoy ice lolly', price: 5, tags: ['veg', 'vegan', 'gf'], heat: 1, illo: 'sun', tint: 'var(--orange)' },
  { cat: 'dulces', name: 'Tres leches', desc: 'Three-milk sponge, toasted meringue, passion fruit', price: 8, tags: ['veg'], heat: 0, illo: 'tostada', tint: 'var(--cream)' },
  { cat: 'bebidas', name: 'Spicy margarita', desc: 'Blanco tequila, lime, agave, jalapeño, tajín rim', price: 12, tags: ['vegan', 'gf'], heat: 2, illo: 'marg', tint: 'var(--lime)', signature: true },
  { cat: 'bebidas', name: 'Mezcal flight', desc: 'Three small-batch mezcals with orange & sal de gusano', price: 18, tags: ['vegan', 'gf'], heat: 0, illo: 'mezcal', tint: 'var(--orange)' },
  { cat: 'bebidas', name: 'Paloma rosa', desc: 'Tequila, pink grapefruit, hibiscus, soda', price: 11, tags: ['vegan', 'gf'], heat: 0, illo: 'marg', tint: 'var(--pink)' },
  { cat: 'bebidas', name: 'Agua de jamaica', desc: 'Hibiscus, cinnamon & lime, alcohol-free', price: 5, tags: ['veg', 'vegan', 'gf'], heat: 0, illo: 'marg', tint: 'var(--chili)' },
];
const CATS = [['tacos', 'Tacos'], ['platos', 'Platos'], ['dulces', 'Dulces'], ['bebidas', 'Bebidas']];
const TAGS: Record<string, string> = { veg: 'Vegetarian', vegan: 'Vegan', gf: 'Gluten-free' };

const EXPERIENCES = [
  { day: 'Tuesday', title: 'Taco Tuesday', text: 'Any three tacos and a draft cerveza for £20, all night.', illo: 'taco', bg: 'var(--marigold)', fg: 'var(--ink)' },
  { day: 'Wednesday', title: 'Mezcal masterclass', text: 'Six mezcals, one maestro, the stories behind every bottle. 7 pm.', illo: 'agave', bg: 'var(--agave)', fg: 'var(--cream)' },
  { day: 'Friday', title: 'Mariachi nights', text: 'Live mariachi from 8 pm. Requests encouraged, singing along mandatory.', illo: 'sun', bg: 'var(--pink)', fg: 'var(--cream)' },
  { day: 'Any day', title: 'Private fiesta', text: 'The upstairs cantina for up to 40 guests, with a set menu and your own bar.', illo: 'cactus', bg: 'var(--cobalt)', fg: 'var(--cream)' },
];

const REVIEWS = [
  { quote: 'The birria tacos are the best thing I have eaten this year. Dipped in that consommé, it is pure joy.', name: 'Amara Osei', where: 'Google review', stars: 5 },
  { quote: 'A room that feels like a party even on a Tuesday. The mezcal flight changed my mind about mezcal.', name: 'Tom Hadley', where: 'The Gastro Gazette (demo)', stars: 5 },
  { quote: 'Warm staff, brilliant vegan options, and churros worth crossing London for.', name: 'Priya Nair', where: 'Google review', stars: 5 },
  { quote: 'Booked for a birthday: they brought out a candle in the tres leches and the whole room sang.', name: 'Lucía Fernández', where: 'Tripadvisor review', stars: 5 },
];

const HOURS = [
  ['Monday', 'Closed', null, null],
  ['Tuesday', '17:00 – 23:00', '17:00', '23:00'],
  ['Wednesday', '17:00 – 23:00', '17:00', '23:00'],
  ['Thursday', '17:00 – 23:00', '17:00', '23:00'],
  ['Friday', '12:00 – 00:00', '12:00', '24:00'],
  ['Saturday', '12:00 – 00:00', '12:00', '24:00'],
  ['Sunday', '12:00 – 22:00', '12:00', '22:00'],
];
---
<Landing
  title="Sol y Sal · Mexican kitchen & mezcal bar, London"
  description="Tacos from the trompo, thirty-ingredient mole and London's best mezcal list. Book a table at Sol y Sal, Shoreditch. (Day 021 of Thecore's 100 Days of Web, a demo concept.)"
  themeColor="#ff3d8b"
  icon="🌮"
  day={21}
>
  <div class="sys">
    <!-- =========================== HEADER =========================== -->
    <header class="sys-header" data-header>
      <div class="mx-auto flex h-18 max-w-7xl items-center justify-between gap-6 px-5 sm:px-8">
        <a href="#top" class="flex items-center gap-2.5 font-display text-2xl font-semibold tracking-tight" aria-label="Sol y Sal, home">
          <Illo name="sun" class="size-10 sys-spin" />
          <span>Sol <i class="font-normal text-(--pink)">y</i> Sal</span>
        </a>
        <nav aria-label="Main" class="hidden lg:block">
          <ul class="flex items-center gap-8 text-[15px] font-semibold">
            {NAV.map(([href, label]) => <li><a class="sys-navlink" href={href}>{label}</a></li>)}
          </ul>
        </nav>
        <div class="flex items-center gap-3">
          <p class="sys-open hidden sm:flex" data-open-pill aria-live="polite"><i></i><span data-open-text>Checking hours…</span></p>
          <a href="#visit" class="sys-btn sys-btn--pink hidden sm:inline-flex">Book a table</a>
          <button class="sys-burger lg:hidden" type="button" aria-expanded="false" aria-controls="sys-menu" data-burger><span class="sr-only">Menu</span><i></i><i></i><i></i></button>
        </div>
      </div>
      <div id="sys-menu" class="sys-drawer" hidden data-drawer>
        <nav aria-label="Mobile">
          <ul>
            {NAV.map(([href, label], i) => <li style={`--i:${i}`}><a href={href}>{label}</a></li>)}
          </ul>
          <a href="#visit" class="sys-btn sys-btn--pink w-full justify-center">Book a table</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <!-- =========================== 1 · HERO =========================== -->
      <section id="top" class="sys-hero" aria-labelledby="hero-title">
        <div class="papel" aria-hidden="true">
          {['var(--pink)', 'var(--marigold)', 'var(--agave)', 'var(--cobalt)', 'var(--orange)', 'var(--pink)', 'var(--lime)', 'var(--chili)', 'var(--marigold)', 'var(--agave)', 'var(--cobalt)', 'var(--pink)'].map((c, i) => <span style={`--c:${c};--d:${(i % 4) * 0.35}s`}></span>)}
        </div>
        <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-12 px-5 pt-12 pb-20 sm:px-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] lg:pt-20">
          <div class="relative z-10">
            <p class="sys-kicker">Shoreditch · London · Since 2019</p>
            <h1 id="hero-title" class="mt-5 font-display text-[clamp(3.2rem,8.5vw,7.25rem)] leading-[0.92] font-semibold tracking-[-0.035em]">
              Fire, flavour <span class="block italic font-normal text-(--pink)">&amp; fiesta.</span>
            </h1>
            <p class="mt-7 max-w-xl text-lg leading-relaxed text-(--ink-soft) sm:text-xl">
              Tacos carved from the trompo, a thirty-ingredient mole and London's wildest mezcal list.
              Mexico City street food meets Oaxacan slow cooking, every night in E2.
            </p>
            <div class="mt-9 flex flex-wrap items-center gap-3">
              <a href="#visit" class="sys-btn sys-btn--pink sys-btn--lg">Book a table <span aria-hidden="true">→</span></a>
              <a href="#menu" class="sys-btn sys-btn--ghost sys-btn--lg">See the menu</a>
            </div>
            <dl class="mt-12 flex flex-wrap gap-x-10 gap-y-4">
              <div><dt class="sys-stat-label">Google rating</dt><dd class="sys-stat">4.9<span class="text-(--marigold)">★</span></dd></div>
              <div><dt class="sys-stat-label">Mezcals behind the bar</dt><dd class="sys-stat" data-count="64">64</dd></div>
              <div><dt class="sys-stat-label">Tacos served last year</dt><dd class="sys-stat" data-count="182" data-suffix="k">182k</dd></div>
            </dl>
          </div>

          <div class="relative mx-auto w-full max-w-[560px]" aria-hidden="true">
            <div class="sys-plate">
              <Image src={photoTacos} alt="Tacos with fresh lime being squeezed over them" width={900} class="sys-plate__photo" loading="eager" />
            </div>
            <div class="sys-badge">
              <svg viewBox="0 0 120 120" class="sys-badge__ring"><defs><path id="ring" d="M60 60m-46 0a46 46 0 1 1 92 0a46 46 0 1 1-92 0" /></defs><text><textPath href="#ring">· HECHO A MANO · TORTILLAS DAILY · HECHO A MANO · TORTILLAS DAILY </textPath></text></svg>
              <span>🌽</span>
            </div>
          </div>
        </div>

        <div class="sys-marquee" data-marquee>
          <div class="sys-marquee__track">
            {[0, 1].map((dup) => (
              <ul aria-hidden={dup === 1 ? 'true' : undefined}>
                {['Tacos al pastor', 'Mezcal flights', 'Birria Sundays', 'Hand-pressed tortillas', 'Mole negro', 'Spicy margaritas', 'Churros & chocolate', 'Mariachi Fridays'].map((t) => <li>{t}<Illo name="sun" class="size-7" /></li>)}
              </ul>
            ))}
          </div>
          <button class="sys-marquee__pause" type="button" aria-pressed="false" data-marquee-pause><span class="sr-only">Pause scrolling text</span><span aria-hidden="true">❚❚</span></button>
        </div>
      </section>

      <!-- =========================== 2 · MENU =========================== -->
      <section id="menu" class="sys-menu" aria-labelledby="menu-title">
        <div class="mx-auto max-w-7xl px-5 py-24 sm:px-8">
          <div class="flex flex-wrap items-end justify-between gap-6">
            <div>
              <p class="sys-kicker text-(--marigold)">La carta</p>
              <h2 id="menu-title" class="sys-h2 mt-3 text-(--cream)">A menu made for <i class="text-(--marigold)">sharing</i></h2>
            </div>
            <p class="max-w-sm text-(--cream)/75">Order three or four plates each and pass them round. Allergies? Tell us, as everything is made here, from scratch.</p>
          </div>
          <figure class="sys-menu__photo"><Image src={photoSpread} alt="A tray of tacos with three salsas beside guacamole and rice, on a colourful tiled table" width={1400} /></figure>

          <div class="mt-12 flex flex-wrap items-center justify-between gap-5">
            <div class="sys-tabs" role="tablist" aria-label="Menu sections" data-menu-tabs>
              {CATS.map(([id, label], i) => (
                <button type="button" role="tab" id={`tab-${id}`} aria-controls="menu-panel" aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-cat={id}>{label}</button>
              ))}
            </div>
            <div class="flex flex-wrap gap-2" role="group" aria-label="Dietary filters" data-diet>
              {Object.entries(TAGS).map(([id, label]) => <button type="button" class="sys-chip" aria-pressed="false" data-tag={id}>{label}</button>)}
              <button type="button" class="sys-chip" aria-pressed="false" data-mild>No spice</button>
            </div>
          </div>

          <div id="menu-panel" role="tabpanel" aria-labelledby="tab-tacos" class="mt-10" data-menu-panel>
            <p class="sr-only" aria-live="polite" data-menu-count></p>
            <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" role="list">
              {DISHES.map((d, di) => (
                <li class="sys-dish" data-dish data-cat={d.cat} data-tags={d.tags.join(' ')} data-heat={d.heat} hidden={d.cat !== 'tacos'} style={`--tint:${d.tint}`}>
                  <div class="sys-dish__art"><Image src={DISH_PHOTOS[di]} alt={d.name} width={200} class="sys-dish__photo" /></div>
                  <div class="min-w-0 flex-1">
                    <div class="flex items-baseline justify-between gap-3">
                      <h3 class="font-display text-2xl font-semibold">{d.name}</h3>
                      <p class="sys-price">£{d.price}</p>
                    </div>
                    <p class="mt-1.5 text-[15px] leading-relaxed text-(--cream)/75">{d.desc}</p>
                    <ul class="mt-3 flex flex-wrap items-center gap-1.5" role="list">
                      {d.signature && <li class="sys-tag sys-tag--sig">★ Signature</li>}
                      {d.tags.map((t) => <li class="sys-tag" title={TAGS[t]}>{t === 'veg' ? 'V' : t === 'vegan' ? 'VG' : 'GF'}<span class="sr-only"> ({TAGS[t]})</span></li>)}
                      {d.heat > 0 && <li class="sys-tag sys-tag--heat"><span aria-hidden="true">{'🌶'.repeat(d.heat)}</span><span class="sr-only">Spice level {d.heat} of 3</span></li>}
                    </ul>
                  </div>
                </li>
              ))}
            </ul>
            <div class="sys-empty" hidden data-menu-empty>
              <p class="font-display text-2xl">Nothing here matches those filters.</p>
              <button type="button" class="sys-btn sys-btn--marigold mt-4" data-clear-diet>Clear filters</button>
            </div>
          </div>
          <p class="mt-10 text-sm text-(--cream)/60">V vegetarian · VG vegan · GF gluten-free · 🌶 spice level. A discretionary 12.5% service charge goes entirely to the team.</p>
        </div>
      </section>

      <!-- =========================== 3 · STORY =========================== -->
      <section id="story" class="sys-story" aria-labelledby="story-title">
        <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-14 px-5 py-28 sm:px-8 lg:grid-cols-2">
          <div class="sys-collage">
            <div class="sys-collage__sun"><Illo name="sun" /></div>
            <div class="sys-collage__arch"><Image src={photoAgave} alt="Rows of blue agave growing on a hillside in Mexico" width={800} class="sys-collage__img" /></div>
            <div class="sys-collage__card sys-collage__card--1"><Image src={photoBeef} alt="Close-up of beef tacos with onion and coriander" width={400} class="sys-collage__img" /></div>
          </div>
          <div>
            <p class="sys-kicker text-(--agave)">Our story</p>
            <h2 id="story-title" class="sys-h2 mt-3">From my abuela's kitchen in <i class="text-(--pink)">Oaxaca</i> to a corner of East London.</h2>
            <div class="mt-7 space-y-5 text-lg leading-relaxed text-(--ink-soft)">
              <p>I grew up grinding corn for tortillas before school. When I moved to London, I couldn't find food that tasted like home, so in 2019 I built a tiny counter with one comal and a trompo.</p>
              <p>Today we nixtamalise heirloom corn every morning, work with twelve family-run mezcal palenques, and still make the mole the way my grandmother taught me: slowly, with thirty ingredients and a lot of love.</p>
            </div>
            <figure class="mt-9 flex items-center gap-4">
              <span class="sys-avatar" aria-hidden="true">IR</span>
              <figcaption><strong class="block font-display text-xl">Itzel Ramírez</strong><span class="text-(--ink-soft)">Chef & founder</span></figcaption>
            </figure>
            <dl class="mt-10 grid grid-cols-3 gap-4">
              <div class="sys-fact" style="--c:var(--marigold)"><dt>Heirloom corn varieties</dt><dd data-count="4">4</dd></div>
              <div class="sys-fact" style="--c:var(--pink)"><dt>Family palenques</dt><dd data-count="12">12</dd></div>
              <div class="sys-fact" style="--c:var(--agave-2)"><dt>Hours for our mole</dt><dd data-count="48">48</dd></div>
            </dl>
          </div>
        </div>
      </section>

      <!-- =========================== 4 · EXPERIENCES =========================== -->
      <section id="experiences" class="sys-exp" aria-labelledby="exp-title">
        <div class="mx-auto max-w-7xl px-5 py-24 sm:px-8">
          <p class="sys-kicker text-(--cobalt)">Every week</p>
          <h2 id="exp-title" class="sys-h2 mt-3 max-w-3xl">More than dinner: <i class="text-(--orange)">a little fiesta</i> most nights.</h2>
          <ul class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-4" role="list">
            {EXPERIENCES.map((e, i) => (
              <li class="sys-exp__card" style={`--bg:${e.bg};--fg:${e.fg};--r:${i % 2 ? 1.5 : -1.5}deg`} data-tilt>
                <p class="sys-exp__day">{e.day}</p>
                <h3 class="mt-2 font-display text-3xl font-semibold leading-tight">{e.title}</h3>
                <p class="mt-3 leading-relaxed opacity-90">{e.text}</p>
                <Illo name={e.illo} class="sys-exp__illo" />
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- =========================== 5 · REVIEWS =========================== -->
      <section id="reviews" class="sys-reviews" aria-labelledby="reviews-title">
        <div class="mx-auto max-w-5xl px-5 py-24 text-center sm:px-8">
          <p class="sys-kicker justify-center text-(--ink)">4.9 from 2,140 reviews</p>
          <h2 id="reviews-title" class="sr-only">What guests say</h2>
          <div class="sys-carousel" role="region" aria-roledescription="carousel" aria-label="Guest reviews" data-carousel>
            {REVIEWS.map((r, i) => (
              <figure class="sys-slide" role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${REVIEWS.length}`} hidden={i !== 0} data-slide>
                <p class="text-3xl tracking-[0.2em] text-(--ink)" aria-label={`${r.stars} out of 5 stars`}>{'★'.repeat(r.stars)}</p>
                <blockquote class="mt-6 font-display text-[clamp(1.6rem,3.6vw,2.7rem)] leading-[1.18] font-medium">“{r.quote}”</blockquote>
                <figcaption class="mt-7 text-lg"><strong>{r.name}</strong> · <span class="opacity-75">{r.where}</span></figcaption>
              </figure>
            ))}
            <div class="mt-10 flex items-center justify-center gap-4">
              <button type="button" class="sys-round" aria-label="Previous review" data-prev>←</button>
              <div class="flex gap-2" role="group" aria-label="Choose a review">
                {REVIEWS.map((_, i) => <button type="button" class="sys-dot" aria-label={`Review ${i + 1}`} aria-current={i === 0 ? 'true' : 'false'} data-go={i}></button>)}
              </div>
              <button type="button" class="sys-round" aria-label="Next review" data-next>→</button>
            </div>
          </div>
          <ul class="mt-16 flex flex-wrap items-center justify-center gap-x-10 gap-y-3 font-display text-xl italic opacity-80" role="list" aria-label="As featured in (demo publications)">
            <li>The Gastro Gazette</li><li>City Eats Weekly</li><li>Taco Atlas</li><li>East End Table</li>
          </ul>
        </div>
      </section>

      <!-- =========================== 6 · VISIT & BOOK =========================== -->
      <section id="visit" class="sys-visit" aria-labelledby="visit-title">
        <div class="mx-auto grid max-w-7xl grid-cols-1 gap-10 px-5 py-24 sm:px-8 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)]">
          <div class="sys-book">
            <p class="sys-kicker text-(--pink)">Reservations</p>
            <h2 id="visit-title" class="sys-h2 mt-3">Book your table</h2>
            <p class="mt-3 text-(--ink-soft)">Tables are held for 15 minutes. For 9 or more, try our private cantina.</p>

            <form class="mt-8 space-y-7" novalidate data-book>
              <fieldset>
                <legend class="sys-label">Day</legend>
                <div class="sys-days" data-days></div>
              </fieldset>
              <fieldset>
                <legend class="sys-label">Time <span class="font-normal opacity-70" data-slot-hint></span></legend>
                <div class="sys-slots" data-slots></div>
              </fieldset>
              <div class="grid gap-5 sm:grid-cols-2">
                <div>
                  <span class="sys-label" id="guests-label">Guests</span>
                  <div class="sys-stepper" role="group" aria-labelledby="guests-label">
                    <button type="button" aria-label="Fewer guests" data-guests="-1">−</button>
                    <output aria-live="polite" data-guests-out>2</output>
                    <button type="button" aria-label="More guests" data-guests="1">+</button>
                  </div>
                  <p class="mt-2 text-sm text-(--pink)" aria-live="polite" data-guests-note></p>
                </div>
                <div>
                  <label class="sys-label" for="occasion">Occasion <span class="font-normal opacity-60">(optional)</span></label>
                  <select id="occasion" class="sys-input" data-occasion>
                    <option value="">Just dinner</option><option>Birthday 🎂</option><option>Anniversary</option><option>Date night</option><option>Business</option>
                  </select>
                </div>
              </div>
              <div class="grid gap-5 sm:grid-cols-2">
                <div>
                  <label class="sys-label" for="bk-name">Name</label>
                  <input id="bk-name" class="sys-input" autocomplete="name" required aria-describedby="bk-name-err" data-field />
                  <p class="sys-err" id="bk-name-err" hidden>Please tell us your name.</p>
                </div>
                <div>
                  <label class="sys-label" for="bk-email">Email</label>
                  <input id="bk-email" class="sys-input" type="email" autocomplete="email" required aria-describedby="bk-email-err" data-field />
                  <p class="sys-err" id="bk-email-err" hidden>Enter an email like you@example.com.</p>
                </div>
              </div>
              <div>
                <label class="sys-label" for="bk-notes">Anything we should know? <span class="font-normal opacity-60">(optional)</span></label>
                <textarea id="bk-notes" class="sys-input min-h-24" maxlength="280" placeholder="Allergies, high chair, a surprise…"></textarea>
              </div>
              <div class="flex flex-wrap items-center gap-4">
                <button class="sys-btn sys-btn--pink sys-btn--lg" type="submit" data-book-btn>Confirm booking</button>
                <p class="text-sm text-(--ink-soft)" aria-live="polite" data-book-summary></p>
              </div>
              <p class="sys-formerr" role="alert" data-book-error></p>
            </form>

            <div class="sys-done" hidden tabindex="-1" data-book-done>
              <Illo name="sun" class="size-20 sys-spin" />
              <h3 class="mt-4 font-display text-4xl font-semibold">¡Nos vemos pronto!</h3>
              <p class="mt-3 text-lg" data-done-text></p>
              <p class="mt-2 text-sm text-(--ink-soft)">This is a demo: no real booking was made and no email was sent.</p>
              <button type="button" class="sys-btn sys-btn--ghost mt-6" data-book-again>Make another booking</button>
            </div>
          </div>

          <aside class="sys-info" aria-label="Location and opening hours">
            <div class="sys-map" aria-hidden="true">
              <span class="sys-map__road sys-map__road--a"></span><span class="sys-map__road sys-map__road--b"></span><span class="sys-map__road sys-map__road--c"></span>
              <span class="sys-map__park"></span>
              <span class="sys-map__pin">🌮</span>
            </div>
            <div class="p-7">
              <h3 class="font-display text-2xl font-semibold">Find us</h3>
              <address class="mt-2 not-italic leading-relaxed">27 Redchurch Street<br />Shoreditch, London E2 7DJ</address>
              <p class="mt-2 text-(--ink-soft)">5 min from Shoreditch High Street ⊖</p>
              <h3 class="mt-7 font-display text-2xl font-semibold">Opening hours</h3>
              <p class="mt-1 text-sm font-semibold" data-open-line aria-live="polite"></p>
              <table class="sys-hours mt-3 w-full">
                <caption class="sr-only">Opening hours</caption>
                <tbody>
                  {HOURS.map(([day, text, open, close]) => <tr data-day={day} data-open={open ?? ''} data-close={close ?? ''}><th scope="row">{day}</th><td>{text}</td></tr>)}
                </tbody>
              </table>
              <div class="mt-7 flex flex-wrap gap-3">
                <a class="sys-btn sys-btn--ghost" href="tel:+442070000000">Call 020 7000 0000</a>
                <a class="sys-btn sys-btn--ghost" href="mailto:hola@solysal.example">Email us</a>
              </div>
            </div>
          </aside>
        </div>
      </section>
    </main>

    <!-- =========================== FOOTER =========================== -->
    <footer class="sys-footer">
      <div class="mx-auto grid max-w-7xl gap-10 px-5 pt-16 pb-24 sm:px-8 md:grid-cols-[1.4fr_1fr_1fr]">
        <div>
          <p class="flex items-center gap-2.5 font-display text-3xl font-semibold"><Illo name="sun" class="size-10" /> Sol <i class="font-normal text-(--pink)">y</i> Sal</p>
          <p class="mt-3 max-w-sm text-(--cream)/70">Mexican kitchen & mezcal bar. Get first dibs on new dishes and mezcal nights.</p>
          <form class="mt-5 flex max-w-sm gap-2" novalidate data-news>
            <label for="news-email" class="sr-only">Email address</label>
            <input id="news-email" type="email" class="sys-input sys-input--dark" placeholder="you@example.com" autocomplete="email" />
            <button class="sys-btn sys-btn--marigold" type="submit">Join</button>
          </form>
          <p class="mt-2 text-sm text-(--marigold)" aria-live="polite" data-news-msg></p>
        </div>
        <nav aria-label="Footer">
          <h2 class="sys-foot-h">Explore</h2>
          <ul class="mt-3 space-y-2">{NAV.map(([href, label]) => <li><a class="sys-foot-link" href={href}>{label}</a></li>)}</ul>
        </nav>
        <div>
          <h2 class="sys-foot-h">Say hola</h2>
          <ul class="mt-3 space-y-2">
            <li><a class="sys-foot-link" href="#" aria-label="Instagram (demo link)">Instagram</a></li>
            <li><a class="sys-foot-link" href="#" aria-label="TikTok (demo link)">TikTok</a></li>
            <li><a class="sys-foot-link" href="mailto:hola@solysal.example">hola@solysal.example</a></li>
          </ul>
