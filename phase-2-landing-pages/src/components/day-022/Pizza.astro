---
/**
 * Forno Rosso · layered SVG pizza.
 * Every topping is its own <g data-topping>, so the builder can switch them on/off.
 * Topping positions come from a seeded spiral, so they look scattered but never change.
 */
interface Props { toppings?: string[]; sauce?: 'rossa' | 'bianca'; all?: boolean; class?: string; label?: string; seed?: number }
const { toppings = [], sauce = 'rossa', all = false, class: className = '', label, seed = 1 } = Astro.props;

function points(count: number, offset: number, radius = 138) {
  let s = (seed * 9301 + offset * 49297) % 233280;
  const rnd = () => { s = (s * 9301 + 49297) % 233280; return s / 233280; };
  const golden = Math.PI * (3 - Math.sqrt(5));
  return Array.from({ length: count }, (_, i) => {
    const r = Math.sqrt((i + 0.5) / count) * radius + (rnd() - 0.5) * 18;
    const a = i * golden + offset + rnd() * 0.6;
    return { x: 200 + Math.cos(a) * r, y: 200 + Math.sin(a) * r, rot: Math.round(rnd() * 360), k: 0.85 + rnd() * 0.3 };
  });
}

const TOPPINGS = ['mozzarella', 'basil', 'pepperoni', 'mushroom', 'olive', 'pepper', 'nduja', 'rocket', 'pineapple'];
const show = (t: string) => all || toppings.includes(t);
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
---
<svg viewBox="0 0 400 400" class={className} {...a11y} data-pizza>
  <defs>
    <radialGradient id={`crust-${seed}`} cx="50%" cy="45%" r="55%">
      <stop offset="78%" stop-color="#f0b46a" /><stop offset="92%" stop-color="#d98a3d" /><stop offset="100%" stop-color="#a85a24" />
    </radialGradient>
  </defs>
  <circle cx="200" cy="200" r="192" fill={`url(#crust-${seed})`} />
  {points(14, 7, 178).map((p) => <circle cx={p.x} cy={p.y} r={6 * p.k} fill="#5a2a12" opacity="0.55" />)}
  <g data-sauce="rossa" opacity={sauce === 'rossa' ? 1 : 0}>
    <circle cx="200" cy="200" r="165" fill="#d8381e" />
    {points(18, 3, 150).map((p) => <circle cx={p.x} cy={p.y} r={14 * p.k} fill="#ee5a33" opacity="0.6" />)}
  </g>
  <g data-sauce="bianca" opacity={sauce === 'bianca' ? 1 : 0}>
    <circle cx="200" cy="200" r="165" fill="#f6e6c4" />
    {points(18, 4, 150).map((p) => <circle cx={p.x} cy={p.y} r={14 * p.k} fill="#fff6e0" opacity="0.8" />)}
  </g>

  <g data-topping="mozzarella" class="tp" hidden={!show('mozzarella')}>
    {points(9, 1).map((p) => <ellipse cx={p.x} cy={p.y} rx={26 * p.k} ry={19 * p.k} transform={`rotate(${p.rot} ${p.x} ${p.y})`} fill="#fffaf0" stroke="#f1dfb8" stroke-width="2" />)}
  </g>
  <g data-topping="pepperoni" class="tp" hidden={!show('pepperoni')}>
    {points(10, 2).map((p) => <g><circle cx={p.x} cy={p.y} r={19 * p.k} fill="#b72a18" stroke="#8a1c0f" stroke-width="2.5" /><circle cx={p.x - 5} cy={p.y - 4} r="3" fill="#e9a08a" /><circle cx={p.x + 6} cy={p.y + 5} r="2.5" fill="#e9a08a" /></g>)}
  </g>
  <g data-topping="mushroom" class="tp" hidden={!show('mushroom')}>
    {points(8, 5).map((p) => <path d={`M${p.x - 16} ${p.y + 2}a16 13 0 0 1 32 0h-9v12h-14v-12Z`} transform={`rotate(${p.rot} ${p.x} ${p.y})`} fill="#ecd9b8" stroke="#9c7647" stroke-width="2.5" stroke-linejoin="round" />)}
  </g>
  <g data-topping="pepper" class="tp" hidden={!show('pepper')}>
    {points(9, 6).map((p, i) => <path d={`M${p.x - 16} ${p.y}q16 -18 32 0`} transform={`rotate(${p.rot} ${p.x} ${p.y})`} fill="none" stroke={i % 2 ? '#f2b705' : '#3fa34d'} stroke-width="8" stroke-linecap="round" />)}
  </g>
  <g data-topping="nduja" class="tp" hidden={!show('nduja')}>
    {points(10, 8).map((p) => <path d={`M${p.x} ${p.y - 11}c9 0 13 6 12 12s-8 10-14 9-11-6-10-12 5-9 12-9Z`} fill="#86190f" />)}
  </g>
  <g data-topping="pineapple" class="tp" hidden={!show('pineapple')}>
    {points(8, 9).map((p) => <path d={`M${p.x} ${p.y - 13}l13 22h-26Z`} transform={`rotate(${p.rot} ${p.x} ${p.y})`} fill="#f6d04d" stroke="#d4a72c" stroke-width="2.5" stroke-linejoin="round" />)}
  </g>
  <g data-topping="olive" class="tp" hidden={!show('olive')}>
    {points(12, 10).map((p) => <circle cx={p.x} cy={p.y} r={8 * p.k} fill="none" stroke="#1f1a16" stroke-width="6" />)}
  </g>
  <g data-topping="basil" class="tp" hidden={!show('basil')}>
    {points(7, 11).map((p) => <g transform={`rotate(${p.rot} ${p.x} ${p.y})`}><ellipse cx={p.x} cy={p.y} rx="20" ry="10" fill="#2f8f46" /><path d={`M${p.x - 17} ${p.y}h32`} stroke="#9ed39b" stroke-width="2" /></g>)}
  </g>
  <g data-topping="rocket" class="tp" hidden={!show('rocket')}>
    {points(10, 12).map((p) => <path d={`M${p.x - 14} ${p.y}l5 -6 4 5 5 -7 4 6 5 -5 5 7-28 0Z`} transform={`rotate(${p.rot} ${p.x} ${p.y})`} fill="#4c8c2b" />)}
  </g>
</svg>
