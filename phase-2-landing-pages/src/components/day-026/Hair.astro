---
/** Stylised head-and-shoulders portrait: one component draws every look on the page (no image files). */
interface Props { look: 'bob' | 'long' | 'pixie' | 'curls' | 'wave'; hair: string; skin?: string; bg?: string; tip?: string; label?: string }
const { look, hair, skin = '#E8BFA3', bg = '#EBD3C6', tip, label } = Astro.props;
const id = `g${Math.random().toString(36).slice(2, 8)}`;
const tipColor = tip ?? hair;
---
<svg viewBox="0 0 200 260" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} preserveAspectRatio="xMidYMid slice">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="0" y2="1"><stop offset="0.45" stop-color={hair} /><stop offset="1" stop-color={tipColor} /></linearGradient>
  </defs>
  <rect width="200" height="260" fill={bg} />
  <circle cx="150" cy="60" r="70" fill="#fff" opacity="0.18" />
  {look === 'long' && <path d="M48 118Q42 40 100 38Q158 40 152 118L160 240Q140 226 128 244Q100 226 72 244Q58 226 40 240Z" fill={`url(#${id})`} />}
  {look === 'wave' && <path d="M50 116Q44 42 100 40Q156 42 150 116Q166 160 150 196Q166 224 144 246L56 246Q34 224 50 196Q34 160 50 116Z" fill={`url(#${id})`} />}
  {look === 'bob' && <path d="M50 120Q46 46 100 44Q154 46 150 120L156 176Q100 192 44 176Z" fill={`url(#${id})`} />}
  {look === 'pixie' && <path d="M60 112Q56 56 100 52Q144 56 140 112Q138 92 120 80Q100 72 80 80Q62 92 60 112Z" fill={hair} />}
  {look === 'curls' && <g fill={`url(#${id})`}>{[[60,92,24],[84,64,26],[116,62,26],[142,90,24],[48,128,22],[154,126,22],[56,160,22],[148,160,22],[100,52,26],[66,196,20],[138,196,20]].map(([x,y,r]) => <circle cx={x} cy={y} r={r} />)}</g>}
  <path d="M82 190v34h36v-34z" fill={skin} /><path d="M82 200q18 14 36 0v-10h-36z" fill="#000" opacity="0.08" />
  <path d="M20 260q4-44 52-50q28 14 56 0q48 6 52 50z" fill="#2B1625" />
  <ellipse cx="100" cy="122" rx="40" ry="52" fill={skin} />
  <path d="M86 136q14 10 28 0" fill="none" stroke="#9c5d4a" stroke-width="2.4" stroke-linecap="round" /><circle cx="86" cy="116" r="2.4" fill="#2B1625" /><circle cx="114" cy="116" r="2.4" fill="#2B1625" />
  {look === 'long' && <path d="M58 112Q64 66 100 68Q96 90 74 118Z M142 112Q136 66 100 68Q112 94 130 116Z" fill={hair} />}
  {look === 'wave' && <path d="M58 116Q60 62 100 62Q146 62 142 116Q128 84 108 78Q88 92 58 116Z" fill={hair} />}
  {look === 'bob' && <path d="M58 112Q72 64 100 68Q132 64 142 112Q122 86 100 86Q78 86 58 112Z" fill={hair} />}
  {look === 'pixie' && <path d="M62 104Q76 62 112 68Q136 72 140 104Q122 80 96 84Q76 88 62 104Z" fill={hair} />}
  {look === 'curls' && <g fill={hair}><circle cx="76" cy="86" r="16" /><circle cx="100" cy="78" r="18" /><circle cx="126" cy="86" r="16" /></g>}
</svg>
